<UserControl x:Class="TimeLeaf.Views.AddContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthSmall}"
             d:DataContext="{d:DesignInstance vm:AddContainerViewModel}"
             mc:Ignorable="d">
    <StackPanel Style="{StaticResource DialogRootStackPanelStyle}">
        <TextBlock Style="{StaticResource FormTitleTextStyle}" Text="グループ作成" />

        <Label Content="グループ名" Style="{StaticResource FirstSectionHeaderLabelStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="例：UIデザイン関連"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="説明" Style="{StaticResource SectionHeaderLabelStyle}" />
        <TextBox Height="{StaticResource MultilineInputHeight}"
                 Margin="{StaticResource FormItemMargin}"
                 AcceptsReturn="True"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="このグループの目的を記入してください..."
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" />

        <!-- フッターボタン -->
        <StackPanel Style="{StaticResource DialogFooterStackPanelStyle}">
            <Button Command="{Binding ConfirmCommand}"
                    Content="作成"
                    Style="{StaticResource DialogActionButtonStyle}" />
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource DialogCancelButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
