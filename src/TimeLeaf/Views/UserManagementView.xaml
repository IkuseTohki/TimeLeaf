<UserControl x:Class="TimeLeaf.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="330"
             Height="300"
             d:DataContext="{d:DesignInstance vm:UserManagementViewModel}"
             mc:Ignorable="d">
    <Grid Style="{StaticResource GridDialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource TextBlockFormTitleStyle}"
                   Text="ユーザー管理" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                BorderBrush="{DynamicResource OutlineBaseBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- アバター -->
                                <Border Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{Binding ThemeColor}" />
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="{Binding UserInitial}" />
                                </Border>

                                <!-- ユーザー名 -->
                                <StackPanel Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="(あなた)"
                                                   Visibility="{Binding IsMe, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Id}" />
                                </StackPanel>

                                <!-- 削除ボタン -->
                                <Button Grid.Column="2"
                                        Padding="8"
                                        Command="{Binding DeleteCommand}"
                                        Content="🗑️"
                                        Style="{StaticResource MenuButtonStyle}"
                                        ToolTip="ユーザーを削除"
                                        Visibility="{Binding IsMe, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- フッターボタン -->
        <StackPanel Grid.Row="2" Style="{StaticResource StackPanelDialogFooterStyle}">
            <Button Command="{Binding CloseCommand}"
                    Content="閉じる"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
