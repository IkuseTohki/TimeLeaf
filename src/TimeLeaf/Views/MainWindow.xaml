<Window x:Class="TimeLeaf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TimeLeaf.Views"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        Title="TimeLeaf"
        Width="1000"
        Height="600"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- ViewModel と View のマッピング -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectWorkspaceViewModel}">
            <views:ProjectWorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 現在表示されている ViewModel に基づいて自動的に DataTemplate が適用される -->
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
