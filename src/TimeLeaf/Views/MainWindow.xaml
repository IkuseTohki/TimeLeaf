<Window x:Class="TimeLeaf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:lb="clr-namespace:LeafKit.UI.Behaviors;assembly=LeafKit.UI"
        xmlns:lk="clr-namespace:LeafKit.UI.Controls;assembly=LeafKit.UI"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TimeLeaf.Views"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        xmlns:vmw="clr-namespace:TimeLeaf.ViewModels.Workspace"
        xmlns:vw="clr-namespace:TimeLeaf.Views.Workspace"
        Title="TimeLeaf"
        Width="1000"
        Height="680"
        MinWidth="800"
        MinHeight="540"
        mc:Ignorable="d">

    <i:Interaction.Behaviors>
        <lb:WindowResidencyBehavior CanExit="{Binding CanExit}" IsWindowVisible="{Binding IsWindowVisible, Mode=TwoWay}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AllTasksViewModel}">
            <views:AllTasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectWorkspaceViewModel}">
            <views:ProjectWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- グローバル・サイドバー -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Style="{StaticResource GlobalSidebarBorderStyle}">
            <Grid>
                <DockPanel LastChildFill="True">
                    <!-- ブランドロゴエリア -->
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource SidebarLogoContainerStyle}">
                        <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Style="{StaticResource SidebarLogoPathStyle}" />
                        <TextBlock Style="{StaticResource SidebarLogoTextStyle}"
                                   Text="TimeLeaf"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- ナビゲーションメニュー -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- メインメニュー -->
                            <Button Command="{Binding NavigateToHomeCommand}" Style="{DynamicResource SidebarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SidebarIconTextStyle}" Text="🏠" />
                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Home"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToAllTasksCommand}" Style="{DynamicResource SidebarButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SidebarIconTextStyle}" Text="📋" />
                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="All Tasks"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToNotificationsCommand}" Style="{DynamicResource SidebarButtonStyle}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SidebarIconTextStyle}" Text="🔔" />
                                        <TextBlock Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="Notifications"
                                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <!-- バッジ -->
                                    <Border Margin="12,-8,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Style="{DynamicResource BadgeStyle}"
                                            Visibility="{Binding UnreadNotificationCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Style="{StaticResource MetaBaseStyle}"
                                                   Text="{Binding UnreadNotificationCount}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- プロジェクトセクション見出し -->
                            <Grid Margin="16,16,12,8" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SidebarMenuHeaderStyle}"
                                           Text="PROJECTS"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Command="{Binding AddProjectCommand}"
                                        Style="{StaticResource SidebarAddButtonStyle}"
                                        ToolTip="新規プロジェクト作成">
                                    <Path Width="10"
                                          Height="10"
                                          Data="M0,5 L10,5 M5,0 L5,10"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource BrandForegroundBrush}"
                                          StrokeThickness="2" />
                                </Button>
                            </Grid>

                            <!-- プロジェクト一覧 -->
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateToProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource SidebarButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SidebarIconTextStyle}" Text="🌲" />
                                                <TextBlock Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- プロジェクトがない場合の表示 -->
                            <TextBlock Style="{StaticResource SidebarEmptyStateTextStyle}"
                                       Text="No projects yet."
                                       Visibility="{Binding Projects.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='Inverse'}" />


                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 折りたたみボタン (SidebarBorderの外に配置することでクリッピングを回避し、全域でクリックを有効化) -->
        <Button Grid.Column="0"
                Panel.ZIndex="10"
                Command="{Binding ToggleSidebarCommand}"
                Content="{Binding IsSidebarExpanded, Converter={StaticResource SidebarToggleIconConverter}}"
                Style="{StaticResource SidebarCollapseButtonStyle}" />

        <!-- メインコンテンツ領域 -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}" />

            <!-- スナックバー表示領域 -->
            <lk:SnackbarPresenter x:Name="Snackbar"
                                  Margin="0,0,0,20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Window>
