<Window x:Class="TimeLeaf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:lb="clr-namespace:LeafKit.UI.Behaviors;assembly=LeafKit.UI"
        xmlns:lk="clr-namespace:LeafKit.UI.Controls;assembly=LeafKit.UI"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TimeLeaf.Views"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        Title="TimeLeaf"
        Width="1000"
        Height="600"
        mc:Ignorable="d">

    <i:Interaction.Behaviors>
        <lb:WindowResidencyBehavior CanExit="{Binding CanExit}" IsWindowVisible="{Binding IsWindowVisible, Mode=TwoWay}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <!-- ViewModel と View のマッピング -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectWorkspaceViewModel}">
            <views:ProjectWorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 現在表示されている ViewModel に基づいて自動的に DataTemplate が適用される -->
        <ContentControl Content="{Binding CurrentViewModel}" />

        <!-- スナックバー表示領域 -->
        <lk:SnackbarPresenter x:Name="Snackbar"
                              Margin="0,0,0,20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom" />
    </Grid>
</Window>
