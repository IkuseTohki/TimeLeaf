<Window x:Class="TimeLeaf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:lb="clr-namespace:LeafKit.UI.Behaviors;assembly=LeafKit.UI"
        xmlns:lk="clr-namespace:LeafKit.UI.Controls;assembly=LeafKit.UI"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TimeLeaf.Views"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        xmlns:vmw="clr-namespace:TimeLeaf.ViewModels.Workspace"
        xmlns:vw="clr-namespace:TimeLeaf.Views.Workspace"
        Title="TimeLeaf"
        Width="1100"
        Height="700"
        mc:Ignorable="d">

    <i:Interaction.Behaviors>
        <lb:WindowResidencyBehavior CanExit="{Binding CanExit}" IsWindowVisible="{Binding IsWindowVisible, Mode=TwoWay}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectWorkspaceViewModel}">
            <views:ProjectWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmw:ProjectNotificationsViewModel}">
            <vw:ProjectNotificationsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- グローバル・サイドバー -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Width="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter='220,80'}"
                Background="{DynamicResource BrandPrimaryBrush}"
                CornerRadius="0,32,32,0">
            <Grid>
                <DockPanel LastChildFill="True">
                    <!-- ブランドロゴエリア -->
                    <StackPanel Margin="20,32,20,40"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                        <Path Width="24"
                              Height="24"
                              Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"
                              Fill="White" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="TimeLeaf"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- ナビゲーションメニュー -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- メインメニュー -->
                            <Button Command="{Binding NavigateToHomeCommand}" Style="{StaticResource SidebarItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" Text="🏠" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Home"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToAllTasksCommand}" Style="{StaticResource SidebarItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" Text="📋" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="All Tasks"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToNotificationsCommand}" Style="{StaticResource SidebarItemStyle}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="18" Text="🔔" />
                                        <TextBlock Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="Notifications"
                                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Border Margin="12,-8,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource NotificationBadgeStyle}"
                                            Visibility="{Binding UnreadNotificationCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Text="{Binding UnreadNotificationCount}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- プロジェクトセクション見出し -->
                            <Grid Margin="24,24,12,8">
                                <TextBlock FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Opacity="0.6"
                                           Text="PROJECTS"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddProjectCommand}"
                                        Style="{StaticResource SidebarItemStyle}"
                                        Padding="4"
                                        Width="24"
                                        Height="24"
                                        ToolTip="新規プロジェクト作成">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" />
                                </Button>
                            </Grid>

                            <!-- プロジェクト一覧 -->
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateToProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SidebarItemStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12" Text="🌲" />
                                                <TextBlock Margin="16,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- プロジェクトがない場合の表示 -->
                            <TextBlock Margin="24,12,24,0"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="White"
                                       Opacity="0.4"
                                       Text="No projects yet."
                                       TextAlignment="Center"
                                       Visibility="{Binding Projects.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='Inverse'}" />


                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 折りたたみボタン -->
                <Button Width="24"
                        Height="24"
                        Margin="0,0,-12,32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Command="{Binding ToggleSidebarCommand}"
                        Content="{Binding IsSidebarExpanded, Converter={StaticResource SidebarToggleIconConverter}}" />
            </Grid>
        </Border>

        <!-- メインコンテンツ領域 -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}" />

            <!-- スナックバー表示領域 -->
            <lk:SnackbarPresenter x:Name="Snackbar"
                                  Margin="0,0,0,20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Window>
