<UserControl x:Class="TimeLeaf.Views.ProfileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance vm:ProfileEditViewModel}"
             mc:Ignorable="d">
    <Border Padding="24"
            Background="White"
            CornerRadius="16">
        <StackPanel Width="320">
            <TextBlock Margin="0,0,0,24"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#4A7c44"
                       Text="プロフィール編集" />

            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="表示名" />
            <TextBox Margin="0,0,0,20"
                     Style="{StaticResource OrganicTextBoxStyle}"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="テーマカラー" />
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40"
                        Height="40"
                        Background="{Binding ThemeColor}"
                        CornerRadius="20" />
                <TextBox Grid.Column="1"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Style="{StaticResource OrganicTextBoxStyle}"
                         Text="{Binding ThemeColor, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="アイコンパス (相対)" />
            <TextBox Margin="0,0,0,32"
                     Style="{StaticResource OrganicTextBoxStyle}"
                     Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,12,0"
                        Command="{Binding CancelCommand}"
                        Content="キャンセル"
                        Style="{StaticResource OrganicButtonStyle}" />
                <Button Command="{Binding SaveCommand}"
                        Content="保存"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
