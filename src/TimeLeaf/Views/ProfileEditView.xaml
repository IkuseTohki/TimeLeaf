<UserControl x:Class="TimeLeaf.Views.ProfileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="320"
             d:DataContext="{d:DesignInstance vm:ProfileEditViewModel}"
             mc:Ignorable="d">
    <StackPanel Style="{StaticResource StackPanelDialogRootStyle}">
        <TextBlock Style="{StaticResource TextBlockFormTitleStyle}" Text="プロフィール編集" />

        <Label Content="表示名" Style="{StaticResource LabelFormFirstSectionHeaderStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource TextBoxOrganicStyle}"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="テーマカラー" Style="{StaticResource LabelFormSectionHeaderStyle}" />
        <Grid Margin="{StaticResource FormItemMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{Binding ThemeColor, FallbackValue=Transparent, TargetNullValue=Transparent}" Style="{StaticResource BorderColorPreviewStyle}" />
            <TextBox Grid.Column="1"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource TextBoxOrganicStyle}"
                     Text="{Binding ThemeColor, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Label Content="アイコンパス (相対)" Style="{StaticResource LabelFormSectionHeaderStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource TextBoxOrganicStyle}"
                 Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel Style="{StaticResource StackPanelDialogFooterStyle}">
            <Button Command="{Binding SaveCommand}"
                    Content="保存"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
