<UserControl x:Class="TimeLeaf.Views.ProfileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="320"
             d:DataContext="{d:DesignInstance vm:ProfileEditViewModel}"
             mc:Ignorable="d">
    <StackPanel Margin="0">
        <TextBlock Style="{StaticResource FormTitleTextStyle}" Text="プロフィール編集" />

        <Label Content="表示名" Style="{StaticResource FirstSectionHeaderLabelStyle}" />
        <TextBox Margin="0,0,0,20"
                 Style="{StaticResource OrganicTextBoxStyle}"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="テーマカラー" Style="{StaticResource SectionHeaderLabelStyle}" />
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{Binding ThemeColor, FallbackValue=Transparent, TargetNullValue=Transparent}" Style="{StaticResource ColorPreviewBorderStyle}" />
            <TextBox Grid.Column="1"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource OrganicTextBoxStyle}"
                     Text="{Binding ThemeColor, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Label Content="アイコンパス (相対)" Style="{StaticResource SectionHeaderLabelStyle}" />
        <TextBox Margin="0,0,0,32"
                 Style="{StaticResource OrganicTextBoxStyle}"
                 Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90"
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Width="90"
                    Margin="12,0,0,0"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
