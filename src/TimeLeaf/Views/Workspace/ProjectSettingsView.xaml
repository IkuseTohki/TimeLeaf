<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance vm:ProjectSettingsViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Inverse Boolean To Visibility Converter -->
        <Style x:Key="InverseVisibility" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArchived}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NormalVisibility" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Content -->
        <StackPanel Grid.Row="0" Style="{StaticResource SettingsContainerStyle}">

            <!-- Lifecycle Management -->
            <GroupBox Header="ライフサイクル管理" Style="{StaticResource SettingsGroupBoxStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="プロジェクトの状態を変更します。" />

                    <!-- Archive Action -->
                    <StackPanel Style="{StaticResource InverseVisibility}">
                        <Button Command="{Binding ArchiveCommand}"
                                Content="プロジェクトをアーカイブする"
                                Style="{StaticResource OutlinedButtonStyle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SettingsAnnotationStyle}"
                                   Text="※ アーカイブするとプロジェクトは読み取り専用になり、通常のリストから非表示になります。" />
                    </StackPanel>

                    <!-- Unarchive Action -->
                    <StackPanel Style="{StaticResource NormalVisibility}">
                        <TextBlock Margin="0,0,0,8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                   Text="このプロジェクトはアーカイブされています。" />
                        <Button Command="{Binding UnarchiveCommand}"
                                Content="アーカイブを解除する"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Danger Zone -->
            <GroupBox Header="Danger Zone" Style="{StaticResource DangerGroupBoxStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               FontWeight="Bold"
                               Foreground="Red"
                               Text="この操作は元に戻せません。" />

                    <Button Command="{Binding DeleteCommand}"
                            Content="プロジェクトを削除する"
                            Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </Grid>
</UserControl>
