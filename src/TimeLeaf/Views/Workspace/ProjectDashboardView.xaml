<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance Type=vm:ProjectDashboardViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,16,48,48">
            <!-- プロジェクト説明 -->
            <Border Margin="0,0,0,32"
                    Padding="24"
                    Style="{StaticResource OrganicCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="プロジェクトについて" />
                    <TextBlock Margin="0,12,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="22"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 統計情報 (Stats) -->
            <UniformGrid Margin="0,0,0,32" Columns="4">
                <Border Margin="0,0,16,0"
                        Padding="24"
                        Style="{StaticResource OrganicCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="全タスク" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding TotalTaskCount}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,16,0"
                        Padding="24"
                        Style="{StaticResource OrganicCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="完了済み" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding CompletedTaskCount}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,16,0"
                        Padding="24"
                        Style="{StaticResource OrganicCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="進捗率" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding CompletionPercentage, Mode=OneWay, StringFormat={}{0:F0}}" />
                            <Run FontSize="14" Text="%" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Padding="24" Style="{StaticResource OrganicCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="実績工数" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding TotalActualCost, Mode=OneWay, StringFormat={}{0:F1}}" />
                            <Run FontSize="12" Text="h" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左カラム: マイルストーン -->
                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Margin="0,0,0,16"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="🏳️ マイルストーン" />
                    <Border Padding="24" Style="{StaticResource OrganicCardStyle}">
                        <ItemsControl ItemsSource="{Binding Milestones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" />
                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- 右カラム: マイルストーン追加（簡易） -->
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,16"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="＋ マイルストーン追加" />
                    <Border Padding="24" Style="{StaticResource OrganicCardStyle}">
                        <StackPanel>
                            <DatePicker Margin="0,0,0,12" SelectedDate="{Binding NewMilestoneDate, Mode=TwoWay}" />
                            <TextBox Margin="0,0,0,12"
                                     Style="{StaticResource OrganicTextBoxStyle}"
                                     Tag="名称を入力..."
                                     Text="{Binding NewMilestoneLabel, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding AddMilestoneCommand}"
                                    Content="追加"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
