<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance Type=vm:ProjectDashboardViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Tokens/Layout.xaml" />
                <ResourceDictionary Source="/Resources/Tokens/Typography.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Text.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Containers.xaml" />
                <ResourceDictionary Source="/Resources/Components/HomeView.xaml" />
                <ResourceDictionary Source="/Resources/Components/WorkspaceView.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource StackPanelViewMainStyle}">
            <!-- プロジェクト概要 -->
            <StackPanel Margin="{StaticResource ContentBottomMargin}">
                <TextBlock Style="{StaticResource TextBlockWorkspaceDashboardDescriptionStyle}" Text="{Binding Description}" />
            </StackPanel>

            <!-- 統計情報 (Stats) -->
            <UniformGrid Margin="{StaticResource ContentBottomMargin}" Columns="4">
                <Border Margin="{StaticResource ContentRightMargin}" Style="{StaticResource BorderWorkspaceDashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Margin="{StaticResource ContentRightMargin}"
                              VerticalAlignment="Center"
                              Data="{StaticResource TaskIconGeometry}"
                              Style="{StaticResource LargeIconPathBrandStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}" Text="全タスク" />
                            <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}" Text="{Binding TotalTaskCount}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="{StaticResource ContentRightMargin}" Style="{StaticResource BorderWorkspaceDashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Margin="{StaticResource ContentRightMargin}"
                              VerticalAlignment="Center"
                              Data="{StaticResource CompletedIconGeometry}"
                              Style="{StaticResource LargeIconPathBrandStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}" Text="完了済み" />
                            <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}" Text="{Binding CompletedTaskCount}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="{StaticResource ContentRightMargin}" Style="{StaticResource BorderWorkspaceDashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:DonutChart Grid.Column="0"
                                      Width="20"
                                      Height="20"
                                      Margin="{StaticResource ContentRightMargin}"
                                      VerticalAlignment="Center"
                                      StrokeThickness="3"
                                      Value="{Binding CompletionPercentage}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}" Text="進捗率" />
                            <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource StringFormatMultiConverter}" StringFormat="{}{0:F0}%">
                                        <Binding Mode="OneWay" Path="CompletionPercentage" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource BorderWorkspaceDashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Margin="{StaticResource ContentRightMargin}"
                              VerticalAlignment="Center"
                              Data="{StaticResource EffortIconGeometry}"
                              Style="{StaticResource LargeIconPathBrandStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}" Text="実績工数" />
                            <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource StringFormatMultiConverter}" StringFormat="{}{0:F1}h">
                                        <Binding Mode="OneWay" Path="TotalActualCost" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- マイルストーンと期限タスク -->
            <UniformGrid Columns="2">
                <StackPanel Margin="{StaticResource ContentRightMargin}">
                    <Grid Margin="{StaticResource ContentLabelMargin}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Path Margin="{StaticResource IconRightMargin}"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource MilestoneIconGeometry}"
                                  Style="{DynamicResource IconPathBrandStyle}" />
                            <TextBlock Margin="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceDashboardSectionHeaderStyle}"
                                       Text="マイルストーン" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding AddMilestoneCommand}"
                                Style="{StaticResource ButtonWorkspaceDashboardAddMilestoneStyle}"
                                ToolTip="マイルストーン追加"
                                Visibility="{Binding IsAssignedToMe, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource AddIconGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Style="{DynamicResource SmallIconPathBrandStyle}" />
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource BorderWorkspaceDashboardCardStyle}">
                        <ItemsControl ItemsSource="{Binding Milestones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="16" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.RowSpan="3"
                                                   Grid.Column="0"
                                                   Style="{StaticResource RectangleHomeMilestoneTimelineLineStyle}" />
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="8,0,0,2"
                                                    Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TextBlockHomeMilestoneDateStyle}" Text="{Binding Date, StringFormat={}{0:MM/dd (ddd)}}" />
                                        </StackPanel>
                                        <Ellipse Grid.Row="1"
                                                 Grid.Column="0"
                                                 Style="{StaticResource EllipseHomeMilestoneTimelineDotStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Style="{StaticResource TextBlockHomeMilestoneLabelStyle}"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <Grid Margin="{StaticResource ContentLabelMargin}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Margin="{StaticResource IconRightMargin}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource IconTextStyle}"
                                       Text="🚨" />
                            <TextBlock Margin="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceDashboardSectionHeaderStyle}"
                                       Text="期限が近いタスク" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource BorderWorkspaceDashboardCardStyle}">
                        <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource GridHomeDeadlineItemStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Text="{Binding Deadline, StringFormat={}{0:MM/dd}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
