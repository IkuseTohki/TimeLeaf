<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance Type=vm:ProjectDashboardViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource ViewMainContainerStyle}">
            <!-- プロジェクト説明 -->
            <Border Margin="0,0,0,20" Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardSectionHeaderStyle}" Text="プロジェクトについて" />
                    <TextBlock Style="{StaticResource DashboardDescriptionTextStyle}" Text="{Binding Description}" />
                </StackPanel>
            </Border>

            <!-- 統計情報 (Stats) -->
            <UniformGrid Margin="0,0,0,20" Columns="4">
                <Border Style="{StaticResource DashboardStatsCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatsLabelStyle}" Text="全タスク" />
                        <TextBlock Style="{StaticResource StatsValueStyle}" Text="{Binding TotalTaskCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardStatsCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatsLabelStyle}" Text="完了済み" />
                        <TextBlock Style="{StaticResource StatsValueStyle}" Text="{Binding CompletedTaskCount}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardStatsCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatsLabelStyle}" Text="進捗率" />
                        <TextBlock Style="{StaticResource StatsValueStyle}">
                            <Run Text="{Binding CompletionPercentage, Mode=OneWay, StringFormat={}{0:F0}}" />
                            <Run FontSize="12" Text="%" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatsLabelStyle}" Text="実績工数" />
                        <TextBlock Style="{StaticResource StatsValueStyle}">
                            <Run Text="{Binding TotalActualCost, Mode=OneWay, StringFormat={}{0:F1}}" />
                            <Run FontSize="10" Text="h" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左カラム: マイルストーン -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource DashboardSectionHeaderStyle}" Text="🏳️ マイルストーン" />
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <ItemsControl ItemsSource="{Binding Milestones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource StatsLabelStyle}" Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" />
                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- 右カラム: マイルストーン追加（簡易） -->
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource DashboardSectionHeaderStyle}" Text="＋ マイルストーン追加" />
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <c:LeafDatePicker Margin="0,0,0,8"
                                              Placeholder="Pick milestone date"
                                              SelectedDate="{Binding NewMilestoneDate, Mode=TwoWay}" />
                            <TextBox Margin="0,0,0,8"
                                     Style="{StaticResource OrganicTextBoxStyle}"
                                     Tag="名称を入力..."
                                     Text="{Binding NewMilestoneLabel, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding AddMilestoneCommand}"
                                    Content="追加"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
