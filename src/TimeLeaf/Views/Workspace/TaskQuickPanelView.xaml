<UserControl x:Class="TimeLeaf.Views.Workspace.TaskQuickPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TimeLeaf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:TaskSummaryViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="400"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#4A7c44" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#3E3A39" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー (タスク名と閉じるボタン) -->
        <Border Padding="24,24,24,16"
                BorderBrush="#EEE"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           Foreground="#3E3A39"
                           Text="{Binding Task.Name}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CloseCommand}"
                        CommandParameter="True"
                        Content="×"
                        FontSize="20"
                        Foreground="#999" />
            </Grid>
        </Border>

        <!-- メインコンテンツ (実績入力) -->
        <ScrollViewer Grid.Row="1"
                      Padding="24,16"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ステータス (共通コントロール) -->
                <TextBlock Style="{StaticResource LabelStyle}" Text="現在の状態" />
                <controls:TaskStatusPicker Margin="0,0,0,20" SelectedStatus="{Binding Task.Status, Mode=TwoWay}" />

                <!-- 優先度 (表示のみ) -->
                <TextBlock Style="{StaticResource LabelStyle}" Text="優先度" />
                <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding Task.Priority}" />

                <Separator Margin="0,0,0,20" Background="#EEE" />

                <!-- スケジュール (予定: 表示のみ) -->
                <TextBlock Style="{StaticResource LabelStyle}" Text="期限" />
                <TextBlock Style="{StaticResource ValueStyle}" Text="{Binding Task.Deadline, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue='(未設定)'}" />

                <!-- スケジュール (実績: 編集可) -->
                <TextBlock Style="{StaticResource LabelStyle}" Text="実績開始日" />
                <DatePicker Margin="0,0,0,16" SelectedDate="{Binding Task.ActualStartDate, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="実績終了日" />
                <DatePicker Margin="0,0,0,16" SelectedDate="{Binding Task.ActualEndDate, Mode=TwoWay}" />

                <Separator Margin="0,0,0,20" Background="#EEE" />

                <!-- 工数 (共通コントロール) -->
                <controls:TaskCostEditor ActualCost="{Binding Task.ActualCost, Mode=TwoWay}"
                                         EstimatedCost="{Binding Task.EstimatedCost, Mode=TwoWay}"
                                         IsReadOnly="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- フッター (ヒント) -->
        <Border Grid.Row="2"
                Padding="24,16"
                Background="#F9F9F9">
            <TextBlock FontSize="11"
                       Foreground="#999"
                       Text="詳細な編集や対話はダブルクリックで開きます"
                       TextAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
