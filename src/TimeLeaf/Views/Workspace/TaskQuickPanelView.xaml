<UserControl x:Class="TimeLeaf.Views.Workspace.TaskQuickPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:controls="clr-namespace:TimeLeaf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:TaskSummaryViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="400"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー (タスク名と閉じるボタン) -->
        <Border Style="{StaticResource TaskPanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TaskPanelTitleStyle}" Text="{Binding Task.Name}" />
                <Button Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        CommandParameter="True"
                        Content="×"
                        Style="{StaticResource TaskPanelCloseButtonStyle}" />
            </Grid>
        </Border>

        <!-- メインコンテンツ (実績入力) -->
        <ScrollViewer Grid.Row="1"
                      Padding="16,12"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding IsAssignedToMe}">
                <!-- ステータス (共通コントロール) -->
                <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="現在の状態" />
                <controls:TaskStatusPicker Margin="0,0,0,16" SelectedStatus="{Binding Task.Status, Mode=TwoWay}" />

                <!-- 優先度 (表示のみ) -->
                <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="優先度" />
                <TextBlock Style="{StaticResource TaskPanelValueStyle}" Text="{Binding Task.Priority}" />

                <Separator Margin="0,0,0,16" Background="{DynamicResource OutlineBaseBrush}" />

                <!-- スケジュール (予定: 表示のみ) -->
                <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="期限" />
                <TextBlock Style="{StaticResource TaskPanelValueStyle}" Text="{Binding Task.Deadline, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue='(未設定)'}" />

                <!-- スケジュール (実績: 編集可) -->
                <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="実績開始日" />
                <c:LeafDatePicker Margin="0,0,0,12"
                                  Placeholder="Actual start"
                                  SelectedDate="{Binding Task.ActualStartDate, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="実績終了日" />
                <c:LeafDatePicker Margin="0,0,0,12"
                                  Placeholder="Actual end"
                                  SelectedDate="{Binding Task.ActualEndDate, Mode=TwoWay}" />

                <Separator Margin="0,0,0,16" Background="{DynamicResource OutlineBaseBrush}" />

                <!-- 工数 (共通コントロール) -->
                <controls:TaskCostEditor ActualCost="{Binding Task.ActualCost, Mode=TwoWay}"
                                         EstimatedCost="{Binding Task.EstimatedCost, Mode=TwoWay}"
                                         IsReadOnly="True" />
            </StackPanel>
        </ScrollViewer>

        <!-- フッター (ヒント) -->
        <Border Grid.Row="2" Style="{StaticResource TaskPanelFooterStyle}">
            <TextBlock Style="{StaticResource TaskPanelFooterHintStyle}" Text="詳細な編集や対話はダブルクリックで開きます" />
        </Border>
    </Grid>
</UserControl>
