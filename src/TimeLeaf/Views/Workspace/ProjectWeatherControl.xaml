<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectWeatherControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             mc:Ignorable="d">
    <Border Padding="12,6"
            Background="White"
            BorderBrush="{DynamicResource OutlineBaseBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6"
                              Direction="-90"
                              Opacity="0.05"
                              ShadowDepth="2" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0"
                       Style="{StaticResource LabelBaseStyle}"
                       Text="{Binding WeatherIcon}" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource MetaBaseStyle}"
                       Text="{Binding WeatherMessage}" />
        </StackPanel>
    </Border>
</UserControl>
