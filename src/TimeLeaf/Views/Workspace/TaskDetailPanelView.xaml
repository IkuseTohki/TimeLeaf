<UserControl x:Class="TimeLeaf.Views.Workspace.TaskDetailPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:TaskDetailViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="450"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#4A7c44" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Padding="32,32,32,16">
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="#3E3A39"
                               Text="{Binding Task.Name}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Border Padding="10,2"
                                Background="#FFEBEE"
                                CornerRadius="10"
                                Visibility="{Binding Task.Priority, Converter={StaticResource PriorityToVisibilityConverter}}">
                            <TextBlock FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#C62828"
                                       Text="緊急" />
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="10,2"
                                Background="#EEE"
                                CornerRadius="10">
                            <TextBlock FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#666"
                                       Text="{Binding Task.Status}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=wv:ProjectTasksView}}"
                        Content="×"
                        FontSize="24" />
            </Grid>
        </Border>

        <!-- スクロール可能なコンテンツ -->
        <ScrollViewer Grid.Row="1"
                      Padding="32,0,32,32"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 詳細説明 -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ROOTS (詳細説明)" />
                    <Border Padding="16"
                            Background="#F9F7F2"
                            CornerRadius="16">
                        <TextBlock FontSize="14"
                                   LineHeight="24"
                                   Text="{Binding Task.Description}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- 対話（コメント） -->
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DISCUSSION (対話)" />
                    <ItemsControl ItemsSource="{Binding Task.Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28"
                                            Height="28"
                                            VerticalAlignment="Top"
                                            Background="#DDD"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Text="KT" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="12,16"
                                            Background="#E8F0E6"
                                            CornerRadius="0,16,16,16">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,4"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#4A7c44"
                                                       Text="{Binding AuthorId}" />
                                            <TextBlock FontSize="13"
                                                       Text="{Binding Content}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- コメント入力 -->
        <Border Grid.Row="2"
                Padding="32,24"
                Background="White"
                BorderBrush="#E0DDD5"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBox Height="60"
                         AcceptsReturn="True"
                         BorderBrush="#E0DDD5"
                         BorderThickness="1"
                         Tag="メッセージを入力..."
                         Text="{Binding NewCommentContent, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="0,12,0,0"
                        Padding="20,8"
                        HorizontalAlignment="Right"
                        Background="#4A7c44"
                        Command="{Binding AddCommentCommand}"
                        Content="送信"
                        Foreground="White"
                        Style="{StaticResource RoundButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
