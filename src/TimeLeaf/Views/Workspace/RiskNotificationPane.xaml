<UserControl x:Class="TimeLeaf.Views.Workspace.RiskNotificationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             mc:Ignorable="d">
    <Grid Width="320">
        <!-- 背景グラデーション（右端から溶け込む） -->
        <Border Background="{DynamicResource NotificationPaneBackgroundBrush}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="20" ItemsSource="{Binding Risks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,12"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="IconText"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource LabelBaseStyle}" />
                                    <TextBlock x:Name="HeaderText"
                                               FontWeight="Bold"
                                               Style="{StaticResource LabelBaseStyle}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Style="{StaticResource LabelBaseStyle}"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="IconText" Property="Text" Value="🚨" />
                                <Setter TargetName="HeaderText" Property="Text" Value="異常" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="False">
                                <Setter TargetName="IconText" Property="Text" Value="⚠️" />
                                <Setter TargetName="HeaderText" Property="Text" Value="警告" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
