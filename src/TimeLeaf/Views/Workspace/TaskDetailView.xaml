<UserControl x:Class="TimeLeaf.Views.Workspace.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:controls="clr-namespace:TimeLeaf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lk="clr-namespace:LeafKit.UI.Controls;assembly=LeafKit.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             MinWidth="600"
             MinHeight="400"
             d:DataContext="{d:DesignInstance wvm:TaskDetailViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Tokens/Layout.xaml" />
                <ResourceDictionary Source="/Resources/Tokens/Typography.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Text.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Buttons.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Containers.xaml" />
                <ResourceDictionary Source="/Resources/Components/UserMenu.xaml" />
                <ResourceDictionary Source="/Resources/Components/Sidebar.xaml" />
                <ResourceDictionary Source="/Resources/Components/WorkspaceView.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid IsEnabled="{Binding ProjectViewModel.IsAssignedToMe}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- 左側: メインエリア（可変幅） -->
                <ColumnDefinition Width="200" />
                <!-- 右側: プロパティ欄 -->
            </Grid.ColumnDefinitions>

            <!-- 外部変更通知バナー -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="12,12,12,0"
                    Padding="12,8"
                    Background="{DynamicResource BrandPrimaryBrush}"
                    CornerRadius="4"
                    Visibility="{Binding HasExternalChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Path Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Data="M11,15H13V17H11V15M11,7H13V13H11V7M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z"
                              Fill="White"
                              Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="他ユーザーによる変更が検知されました。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Padding="8,2"
                            Command="{Binding ReloadLatestCommand}"
                            Content="最新を読み込む"
                            Style="{StaticResource ButtonSecondaryStyle}" />
                </Grid>
            </Border>

            <!-- 左側: メインコンテンツ (縦に 1.タイトル, 2.説明, 3.対話) -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 1. タイトル -->
                    <RowDefinition Height="Auto" />
                    <!-- 2. 詳細説明 -->
                    <RowDefinition Height="Auto" />
                    <!-- セパレーター -->
                    <RowDefinition Height="*" />
                    <!-- 3. ディスカッション (ここだけ残りのスペースを埋める) -->
                    <RowDefinition Height="Auto" />
                    <!-- 4. 変更履歴 -->
                </Grid.RowDefinitions>

                <!-- 1. タスクタイトル -->
                <c:EditableLabel Grid.Row="0"
                                 Margin="0,0,0,10"
                                 Style="{StaticResource TaskDetailTitleStyle}"
                                 Text="{Binding Task.Name, UpdateSourceTrigger=PropertyChanged}" />
                <!-- 2. ROOTS (詳細説明) -->
                <c:EditableTextBlock Grid.Row="1"
                                     Margin="0,0,0,10"
                                     Header="Overview"
                                     Text="{Binding Task.Description, UpdateSourceTrigger=PropertyChanged}" />

                <Separator Grid.Row="2"
                           Margin="0,0,0,10"
                           Background="{DynamicResource OutlineBaseBrush}" />

                <!-- 3. DISCUSSION -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource TextBlockWorkspaceTaskPanelSectionHeaderStyle}"
                               Text="DISCUSSION" />

                    <!-- コメント履歴 -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,0,8"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Task.Comments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border VerticalAlignment="Top"
                                                Background="{Binding AuthorColor}"
                                                Style="{StaticResource BorderUserAvatarIconSmallStyle}">
                                            <TextBlock Foreground="White"
                                                       Style="{StaticResource TextBlockUserAvatarInitialStyle}"
                                                       Text="{Binding AuthorInitial}" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,0,0">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Style="{StaticResource TaskCommentAuthorStyle}"
                                                           Text="{Binding AuthorName}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                                           Text="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" />
                                            </Grid>
                                            <Border Style="{StaticResource TaskCommentContentStyle}">
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                           LineHeight="15"
                                                           Style="{StaticResource TextBlockMetaBaseStyle}"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                    <!-- コメント入力 -->
                    <Border Grid.Row="2"
                            Style="{StaticResource TaskCommentInputAreaStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AcceptsReturn="True"
                                     Style="{StaticResource TextBoxWorkspaceTaskCommentStyle}"
                                     Tag="メッセージを送信..."
                                     Text="{Binding NewCommentContent, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddCommentCommand}"
                                    Style="{StaticResource TaskCommentButtonStyle}">
                                <Path Width="16"
                                      Height="16"
                                      Data="{StaticResource SendIconGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. CHANGE HISTORY (控えめな表示) -->
                <StackPanel Grid.Row="4"
                            Margin="0,20,0,10">
                    <ToggleButton x:Name="HistoryToggle"
                                  HorizontalAlignment="Left"
                                  IsChecked="{Binding IsHistoryExpanded}"
                                  Style="{StaticResource IconToggleButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12"
                                  Height="12"
                                  Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,19.98 10.51,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform" />
                            <TextBlock Margin="6,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="変更履歴を表示" />
                            <Path x:Name="ChevronIcon"
                                  Width="8"
                                  Height="8"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource ChevronRightIconGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HistoryToggle}"
                                                         Value="True">
                                                <Setter Property="Data" Value="{StaticResource ArrowDownIconGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                    </ToggleButton>

                    <Border Margin="24,4,0,0"
                            Padding="0,4"
                            Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer MaxHeight="90"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Top"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:MM/dd HH:mm}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock VerticalAlignment="Top"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap">
                                                    <Run FontWeight="SemiBold"
                                                         Text="{Binding UserName, Mode=OneWay}" />
                                                    <Run Text=" が " />
                                                    <Run Text="{Binding ActionDisplayName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,2,0,0"
                                                           VerticalAlignment="Top"
                                                           FontSize="9"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding DetailSummary, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasDetailSummary, Converter={StaticResource NormalVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 右側: プロパティ サイドバー -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource BorderWorkspaceTaskDetailSidebarStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Style="{StaticResource TextBlockWorkspaceTaskPanelSectionHeaderStyle}"
                                   Text="プロパティ" />

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="ステータス" />
                            <lk:InteractiveChipsPicker Grid.Column="2"
                                                       HorizontalAlignment="Left"
                                                       ItemsSource="{Binding Task.StatusValues}"
                                                       Orientation="Horizontal"
                                                       SelectedItem="{Binding Task.Status, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="優先度" />
                            <lk:InteractiveChipsPicker Grid.Column="2"
                                                       HorizontalAlignment="Left"
                                                       ItemsSource="{Binding Task.PriorityValues}"
                                                       Orientation="Horizontal"
                                                       SelectedItem="{Binding Task.Priority, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="担当者" />
                            <c:LeafSearchableSelector Grid.Column="2"
                                                      DisplayMemberPath="DisplayName"
                                                      ItemContainerStyle="{StaticResource TeammateItemContainerCompactStyle}"
                                                      ItemTemplate="{StaticResource TeammateItemCompactTemplate}"
                                                      ItemsSource="{Binding AvailableTeammates}"
                                                      Placeholder="担当者を選択..."
                                                      SelectedItem="{Binding SelectedAssignee}"
                                                      SelectedTemplate="{StaticResource TeammateSelectedCompactTemplate}" />
                        </Grid>

                        <Separator Margin="0,0,0,16"
                                   Background="{DynamicResource OutlineBaseBrush}" />

                        <TextBlock Style="{StaticResource TextBlockWorkspaceTaskPanelSectionHeaderStyle}"
                                   Text="スケジュール" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="予定開始日" />
                            <c:LeafDatePicker Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Placeholder="Set start date"
                                              SelectedDate="{Binding Task.ScheduledStartDate}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="期限" />
                            <c:LeafDatePicker Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Placeholder="Set deadline"
                                              SelectedDate="{Binding Task.Deadline}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="実績開始" />
                            <c:LeafDatePicker Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Placeholder="Actual start"
                                              SelectedDate="{Binding Task.ActualStartDate}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="MetaLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource TextBlockWorkspaceTaskPanelMetaLabelStyle}"
                                       Text="実績終了" />
                            <c:LeafDatePicker Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Placeholder="Actual end"
                                              SelectedDate="{Binding Task.ActualEndDate}" />
                        </Grid>

                        <Separator Margin="0,0,0,16"
                                   Background="{DynamicResource OutlineBaseBrush}" />

                        <TextBlock Style="{StaticResource TextBlockWorkspaceTaskPanelSectionHeaderStyle}"
                                   Text="工数 (h)" />
                        <controls:TaskCostEditor ActualCost="{Binding Task.ActualCost, Mode=TwoWay}"
                                                 EstimatedCost="{Binding Task.EstimatedCost, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- アクション フッター -->
        <Border Grid.Row="1"
                Padding="24,12"
                Background="{DynamicResource SurfaceBaseBrush}"
                BorderBrush="{DynamicResource OutlineBaseBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource ButtonIconStyle}">
                        <Path Data="{StaticResource DeleteIconGeometry}"
                              Style="{StaticResource PathBrandIconStyle}" />
                    </Button>
                    <Button MinWidth="80"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            Style="{StaticResource ButtonPrimaryStyle}" />
                    <Button MinWidth="80"
                            Padding="16,6"
                            Command="{Binding CloseCommand}"
                            Content="閉じる"
                            Style="{StaticResource ButtonSecondaryStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
