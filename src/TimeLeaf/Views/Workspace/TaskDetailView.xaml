<UserControl x:Class="TimeLeaf.Views.Workspace.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:controls="clr-namespace:TimeLeaf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             MinWidth="600"
             MinHeight="400"
             d:DataContext="{d:DesignInstance wvm:TaskDetailViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid IsEnabled="{Binding ProjectViewModel.IsAssignedToMe}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- 左側: メインエリア（可変幅） -->
                <ColumnDefinition Width="180" />
                <!-- 右側: プロパティ欄 (幅180) -->
            </Grid.ColumnDefinitions>

            <!-- 外部変更通知バナー -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="12,12,12,0"
                    Padding="12,8"
                    Background="{DynamicResource BrandPrimaryBrush}"
                    CornerRadius="4"
                    Visibility="{Binding HasExternalChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Path Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Data="M11,15H13V17H11V15M11,7H13V13H11V7M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z"
                              Fill="White"
                              Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="他ユーザーによる変更が検知されました。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Padding="8,2"
                            Command="{Binding ReloadLatestCommand}"
                            Content="最新を読み込む"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <!-- 左側: メインコンテンツ (縦に 1.タイトル, 2.説明, 3.対話) -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 1. タイトル -->
                    <RowDefinition Height="Auto" />
                    <!-- 2. 詳細説明 -->
                    <RowDefinition Height="Auto" />
                    <!-- セパレーター -->
                    <RowDefinition Height="*" />
                    <!-- 3. ディスカッション (ここだけ残りのスペースを埋める) -->
                </Grid.RowDefinitions>

                <!-- 1. タスクタイトル -->
                <c:EditableLabel Grid.Row="0"
                                 Margin="4,0,0,16"
                                 Text="{Binding Task.Name, UpdateSourceTrigger=PropertyChanged}" />
                <!-- 2. ROOTS (詳細説明) -->
                <c:EditableTextBlock Grid.Row="1"
                                     Margin="0,0,0,24"
                                     Header="Overview"
                                     Text="{Binding Task.Description, UpdateSourceTrigger=PropertyChanged}" />

                <Separator Grid.Row="2"
                           Margin="0,0,0,20"
                           Background="{DynamicResource OutlineBaseBrush}" />

                <!-- 3. DISCUSSION (対話) -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="DISCUSSION (対話)" />

                    <!-- コメント履歴 -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,0,8"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Task.Comments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding AuthorColor}" Style="{StaticResource TaskCommentAvatarStyle}">
                                            <TextBlock Foreground="White"
                                                       Style="{StaticResource MetaBaseStyle}"
                                                       Text="KT" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Style="{StaticResource TaskCommentAuthorStyle}" Text="{Binding AuthorName}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           Style="{StaticResource TaskPanelMetaLabelStyle}"
                                                           Text="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" />
                                            </Grid>
                                            <Border Style="{StaticResource TaskCommentContentStyle}">
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                                           LineHeight="15"
                                                           Style="{StaticResource MetaBaseStyle}"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                    <!-- コメント入力 -->
                    <Border Grid.Row="2"
                            Padding="0,8,0,0"
                            BorderBrush="{DynamicResource OutlineBaseBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Height="40"
                                     AcceptsReturn="True"
                                     Style="{StaticResource OrganicTextBoxStyle}"
                                     Tag="メッセージを送信..."
                                     Text="{Binding NewCommentContent, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    MinHeight="{StaticResource ButtonHeightSmall}"
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    Command="{Binding AddCommentCommand}"
                                    Content="送信"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 右側: プロパティ サイドバー -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource TaskDetailSidebarStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="プロパティ" />

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="ステータス" />
                            <controls:TaskStatusPicker SelectedStatus="{Binding Task.Status, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="優先度" />
                            <ComboBox ItemsSource="{Binding Task.PriorityValues}"
                                      SelectedItem="{Binding Task.Priority, Mode=TwoWay}"
                                      Style="{DynamicResource CompactFormComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="担当者" />
                            <TextBlock FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Task.Assignee}" />
                        </StackPanel>

                        <Separator Margin="0,0,0,16" Background="{DynamicResource OutlineBaseBrush}" />

                        <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="スケジュール" />
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="期限" />
                            <c:LeafDatePicker Placeholder="Set deadline" SelectedDate="{Binding Task.Deadline}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="実績開始" />
                            <c:LeafDatePicker Placeholder="Actual start" SelectedDate="{Binding Task.ActualStartDate}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="実績終了" />
                            <c:LeafDatePicker Placeholder="Actual end" SelectedDate="{Binding Task.ActualEndDate}" />
                        </StackPanel>

                        <Separator Margin="0,0,0,16" Background="{DynamicResource OutlineBaseBrush}" />

                        <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="工数 (h)" />
                        <controls:TaskCostEditor ActualCost="{Binding Task.ActualCost, Mode=TwoWay}" EstimatedCost="{Binding Task.EstimatedCost, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- アクション フッター -->
        <Border Grid.Row="1"
                Padding="24,12"
                Background="{DynamicResource SurfaceBaseBrush}"
                BorderBrush="{DynamicResource OutlineBaseBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource IconButton}">
                    <Path Data="{StaticResource BackIconGeometry}" Style="{StaticResource IconPathStyle}" />
                </Button>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource IconButton}">
                        <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource IconPathStyle}" />
                    </Button>
                    <Button MinWidth="80"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button MinWidth="80"
                            Padding="16,6"
                            Command="{Binding CloseCommand}"
                            Content="閉じる"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
