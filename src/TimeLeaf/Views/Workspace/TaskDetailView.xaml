<UserControl x:Class="TimeLeaf.Views.Workspace.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:controls="clr-namespace:TimeLeaf.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             MinWidth="600"
             MinHeight="400"
             d:DataContext="{d:DesignInstance wvm:TaskDetailViewModel}"
             mc:Ignorable="d">
    <Grid Background="{DynamicResource SurfaceBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid IsEnabled="{Binding ProjectViewModel.IsAssignedToMe}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- 左側: メインエリア（可変幅） -->
                <ColumnDefinition Width="180" />
                <!-- 右側: プロパティ欄 (幅180) -->
            </Grid.ColumnDefinitions>

            <!-- 左側: メインコンテンツ (縦に 1.タイトル, 2.説明, 3.対話) -->
            <Grid Grid.Column="0" Margin="32,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 1. タイトル -->
                    <RowDefinition Height="Auto" />
                    <!-- 2. 詳細説明 -->
                    <RowDefinition Height="Auto" />
                    <!-- セパレーター -->
                    <RowDefinition Height="*" />
                    <!-- 3. ディスカッション (ここだけ残りのスペースを埋める) -->
                </Grid.RowDefinitions>

                <!-- 1. タスクタイトル -->
                <c:EditableLabel Grid.Row="0"
                                 Margin="4,0,0,24"
                                 FontSize="24"
                                 FontWeight="ExtraBold"
                                 Text="{Binding Task.Name, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 2. ROOTS (詳細説明) -->
                <c:EditableTextBlock Grid.Row="1"
                                     Margin="0,0,0,32"
                                     Header="Overview"
                                     Text="{Binding Task.Description, UpdateSourceTrigger=PropertyChanged}" />

                <Separator Grid.Row="2"
                           Margin="0,0,0,24"
                           Background="{DynamicResource OutlineBaseBrush}" />

                <!-- 3. DISCUSSION (対話) -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="DISCUSSION (対話)" />

                    <!-- コメント履歴 -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,0,0,12"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Task.Comments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding AuthorColor}" Style="{StaticResource TaskCommentAvatarStyle}">
                                            <TextBlock FontSize="9"
                                                       Style="{StaticResource UserAvatarInitialStyle}"
                                                       Text="KT" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Style="{StaticResource TaskCommentAuthorStyle}" Text="{Binding AuthorName}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="9"
                                                           Style="{StaticResource TaskPanelMetaLabelStyle}"
                                                           Text="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" />
                                            </Grid>
                                            <Border Style="{StaticResource TaskCommentContentStyle}">
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           LineHeight="16"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                    <!-- コメント入力 -->
                    <Border Grid.Row="2"
                            Padding="0,12,0,0"
                            BorderBrush="{DynamicResource OutlineBaseBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Height="44"
                                     AcceptsReturn="True"
                                     Style="{StaticResource OrganicTextBoxStyle}"
                                     Tag="メッセージを送信..."
                                     Text="{Binding NewCommentContent, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Command="{Binding AddCommentCommand}"
                                    Content="送信"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 右側: プロパティ サイドバー -->
            <Border Grid.Column="1" Style="{StaticResource TaskDetailSidebarStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="プロパティ" />

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="ステータス" />
                            <controls:TaskStatusPicker SelectedStatus="{Binding Task.Status, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="優先度" />
                            <ComboBox ItemsSource="{Binding Task.PriorityValues}"
                                      SelectedItem="{Binding Task.Priority, Mode=TwoWay}"
                                      Style="{DynamicResource CompactFormComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="担当者" />
                            <TextBlock FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Task.Assignee}" />
                        </StackPanel>

                        <Separator Margin="0,0,0,16" Background="{DynamicResource OutlineBaseBrush}" />

                        <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="スケジュール" />
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="期限" />
                            <c:LeafDatePicker Placeholder="Set deadline" SelectedDate="{Binding Task.Deadline}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="実績開始" />
                            <c:LeafDatePicker Placeholder="Actual start" SelectedDate="{Binding Task.ActualStartDate}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource TaskPanelMetaLabelStyle}" Text="実績終了" />
                            <c:LeafDatePicker Placeholder="Actual end" SelectedDate="{Binding Task.ActualEndDate}" />
                        </StackPanel>

                        <Separator Margin="0,0,0,16" Background="{DynamicResource OutlineBaseBrush}" />

                        <TextBlock Style="{StaticResource TaskPanelSectionHeaderStyle}" Text="工数 (h)" />
                        <controls:TaskCostEditor ActualCost="{Binding Task.ActualCost, Mode=TwoWay}" EstimatedCost="{Binding Task.EstimatedCost, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- アクション フッター -->
        <Border Grid.Row="1"
                Padding="24,12"
                Background="{DynamicResource SurfaceBaseBrush}"
                BorderBrush="{DynamicResource OutlineBaseBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Padding="20,6"
                        Command="{Binding CloseCommand}"
                        CommandParameter="True"
                        Content="保存して閉じる"
                        Style="{StaticResource RoundButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
