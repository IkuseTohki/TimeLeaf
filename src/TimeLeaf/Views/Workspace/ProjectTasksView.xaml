<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- メインのタスクボード領域 -->
        <DockPanel Style="{StaticResource TaskBoardContainerStyle}">
            <!-- ヘッダー -->
            <Grid Margin="0,0,0,24" DockPanel.Dock="Top">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TaskBoardHeaderTextStyle}" Text="作業の森" />
                </StackPanel>
            </Grid>

            <!-- タスク追加入力 -->
            <Button Command="{Binding AddTaskCommand}"
                    DockPanel.Dock="Top"
                    IsEnabled="{Binding ProjectViewModel.IsAssignedToMe}"
                    Style="{StaticResource AddTaskButtonStyle}">
                <Border Style="{StaticResource AddTaskCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Text="🌱" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="新しいタスクの種をまく..." />
                        <Button Grid.Column="2"
                                Command="{Binding AddTaskCommand}"
                                Content="追加"
                                Foreground="White"
                                Style="{StaticResource RoundButtonStyle}" />
                    </Grid>
                </Border>
            </Button>

            <!-- タスクリスト -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}" Tag="False" />
            </ScrollViewer>
        </DockPanel>

        <!-- タスク詳細パネル (Drawer) -->
        <Border Grid.Column="1"
                Style="{StaticResource TaskDetailDrawerStyle}"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl Content="{Binding TaskSummaryViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type wvm:TaskSummaryViewModel}">
                        <wv:TaskQuickPanelView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
