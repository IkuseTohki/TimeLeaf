<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:li="clr-namespace:LeafKit.UI.Behaviors.Interactions;assembly=LeafKit.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="250" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側：ミニマル・タスクリスト（引き算のデザイン） -->
        <DockPanel Grid.Column="0" Background="{DynamicResource BackgroundBrush}">
            <!-- タスク追加入力（下部配置） -->
            <Button Command="{Binding AddTaskCommand}"
                    DockPanel.Dock="Bottom"
                    IsEnabled="{Binding ProjectViewModel.IsAssignedToMe}"
                    Style="{StaticResource AddTaskButtonStyle}">
                <Border Padding="12" Style="{StaticResource AddTaskCardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Text="🌱" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="タスクをクイック追加" />
                    </StackPanel>
                </Border>
            </Button>

            <!-- リスト本体 -->
            <ListBox Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Tasks}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedTask}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- ここに「引き算のデザイン」のスタイルを適用する -->
                        <Setter Property="Template" Value="{StaticResource SubtractiveTaskItemTemplate}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- スプリッター -->
        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderLightBrush}" />

        <!-- 右側：グラフィカル・フロー図 -->
        <Grid Grid.Column="2" Background="{DynamicResource FlowBackgroundBrush}">
            <!-- フロー描画キャンバス -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 依存関係の線 (Edges) -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="{Binding X1}"
                                      X2="{Binding X2}"
                                      Y1="{Binding Y1}"
                                      Y2="{Binding Y2}">
                                    <Line.Style>
                                        <Style TargetType="Line">
                                            <Setter Property="Stroke" Value="{DynamicResource BorderLightBrush}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
                                                    <Setter Property="StrokeThickness" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Line.Style>
                                </Line>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- タスクノード -->
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- ノードの表現 -->
                                <wv:TaskFlowNodeControl>
                                    <i:Interaction.Behaviors>
                                        <li:DragPositionBehavior X="{Binding X, Mode=TwoWay}" Y="{Binding Y, Mode=TwoWay}" />
                                    </i:Interaction.Behaviors>
                                </wv:TaskFlowNodeControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- 右上：リスク通知ペイン（透過レイヤー） -->
            <wv:RiskNotificationPane Margin="20"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top" />

            <!-- 右下：プロジェクト・ウェザー（お天気アイコン） -->
            <wv:ProjectWeatherControl Margin="20"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</UserControl>
