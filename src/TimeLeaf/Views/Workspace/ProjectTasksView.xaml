<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:li="clr-namespace:LeafKit.UI.Behaviors.Interactions;assembly=LeafKit.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="250" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側：コンテナ・タスクリスト -->
        <ScrollViewer Grid.Column="0" Style="{DynamicResource WorkspaceScrollContainerStyle}">
            <StackPanel Margin="20">
                <ItemsControl ItemsSource="{Binding TaskContainers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type wvm:TaskContainerViewModel}">
                            <Border x:Name="ContainerBorder" Style="{StaticResource TaskContainerCardStyle}">
                                <Grid>
                                    <StackPanel>
                                        <!-- Container Header -->
                                        <Border x:Name="HeaderBorder" Style="{StaticResource TaskContainerHeaderStyle}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource MetaBaseStyle}"
                                                               Text="📂 " />
                                                    <TextBlock Style="{DynamicResource TaskGroupTitleStyle}" Text="{Binding DisplayName}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <TextBlock Style="{DynamicResource MetaBaseStyle}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource StringFormatMultiConverter}" StringFormat="{}{0}/{1} Done">
                                                                <Binding Path="DoneTasksCount" />
                                                                <Binding Path="TotalTasksCount" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <Button x:Name="DeleteContainerBtn"
                                                            Margin="8,0,0,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DeleteContainerCommand}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Opacity="0"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="コンテナを削除"
                                                            Visibility="Collapsed">
                                                        <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource SmallIconPathBrandStyle}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Sub Task List -->
                                        <ListBox ItemContainerStyle="{StaticResource TaskSubTaskItemContainerStyle}"
                                                 ItemsSource="{Binding SubTasks}"
                                                 Style="{StaticResource TaskSubTaskListStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="RootGrid"
                                                          Background="Transparent"
                                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=wv:ProjectTasksView}}">
                                                        <Grid.InputBindings>
                                                            <MouseBinding Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}"
                                                                          MouseAction="LeftDoubleClick" />
                                                        </Grid.InputBindings>
                                                        <Grid.ContextMenu>
                                                            <ContextMenu x:Name="TaskContextMenu">
                                                                <MenuItem Header="コンテナへ移動" ItemsSource="{Binding PlacementTarget.Tag.AvailableContainers, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="📂" />
                                                                    </MenuItem.Icon>
                                                                    <MenuItem.ItemContainerStyle>
                                                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                                                            <Setter Property="Header" Value="{Binding Name}" />
                                                                            <Setter Property="Command" Value="{Binding PlacementTarget.Tag.MoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                            <Setter Property="CommandParameter">
                                                                                <Setter.Value>
                                                                                    <MultiBinding Converter="{StaticResource MoveTaskArgsConverter}">
                                                                                        <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                                                        <Binding Path="Id" />
                                                                                    </MultiBinding>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </MenuItem.ItemContainerStyle>
                                                                </MenuItem>
                                                                <Separator />
                                                                <MenuItem Command="{Binding PlacementTarget.Tag.MoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="未分類へ移動">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="🍃" />
                                                                    </MenuItem.Icon>
                                                                    <MenuItem.CommandParameter>
                                                                        <MultiBinding Converter="{StaticResource MoveTaskArgsConverter}">
                                                                            <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                                            <Binding Source="{x:Null}" />
                                                                        </MultiBinding>
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                                <Separator />
                                                                <MenuItem Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="削除">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="🗑️" />
                                                                    </MenuItem.Icon>
                                                                    <MenuItem.CommandParameter>
                                                                        <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                                    </MenuItem.CommandParameter>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Grid.ContextMenu>

                                                        <Border x:Name="TaskBorder"
                                                                Padding="{StaticResource TaskCardPadding}"
                                                                BorderBrush="{DynamicResource OutlineBaseBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <StackPanel>
                                                                <TextBlock x:Name="TaskNameText"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           Text="{Binding Name}" />
                                                                <StackPanel x:Name="InfoPanel"
                                                                            Margin="{StaticResource TaskCardInfoMargin}"
                                                                            Orientation="Horizontal"
                                                                            Visibility="Collapsed">
                                                                    <TextBlock Style="{DynamicResource MetaBaseStyle}">
                                                                        <Run Text="担当: " />
                                                                        <Run Text="{Binding AssigneeName}" />
                                                                        <Run Text=" | 期限: " />
                                                                        <Run Text="{Binding Deadline, StringFormat=MM/dd}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RootGrid" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="TaskBorder" Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
                                                            <Setter TargetName="TaskBorder" Property="Margin" Value="12,8" />
                                                            <Setter TargetName="TaskBorder" Property="Padding" Value="16" />
                                                            <Setter TargetName="TaskBorder" Property="CornerRadius" Value="8" />
                                                            <Setter TargetName="TaskBorder" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                            <Setter TargetName="TaskBorder" Property="BorderThickness" Value="1" />
                                                            <Setter TargetName="TaskNameText" Property="FontWeight" Value="Bold" />
                                                            <Setter TargetName="TaskNameText" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                                            <Setter TargetName="InfoPanel" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="RootGrid" Property="Background" Value="Transparent" />
                                                            <Setter TargetName="TaskBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="6"
                                                                                      Opacity="0.1"
                                                                                      ShadowDepth="2"
                                                                                      Color="{Binding Source={StaticResource BrandPrimaryColor}}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Add Task Area (Hover-only via DataTemplate Triggers) -->
                                        <Button x:Name="AddTaskBtn"
                                                Command="{Binding AddTaskCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AddTaskButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ContainerBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AddTaskBtn" Property="Height" Value="24" />
                                    <Setter TargetName="AddTaskBtn" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                                    <Setter TargetName="AddTaskBtn" Property="Opacity" Value="0.6" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=HeaderBorder}" Value="True" />
                                        <Condition Binding="{Binding IsUnclassified}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DeleteContainerBtn" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DeleteContainerBtn" Property="Opacity" Value="1" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=DeleteContainerBtn}" Value="True" />
                                        <Condition Binding="{Binding IsUnclassified}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DeleteContainerBtn" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DeleteContainerBtn" Property="Opacity" Value="1" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ghost Container (Add Group) -->
                <Button Command="{Binding AddContainerCommand}" Style="{StaticResource AddGroupButtonStyle}" />

                <!-- 順序調整ボタン -->
                <Button Command="{Binding ReorderItemsCommand}"
                        Content="表示順序を調整"
                        Style="{StaticResource ReorderGhostButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderLightBrush}" />

        <!-- 右側：グラフィカル・フロー図 -->
        <Grid Grid.Column="2" Background="{DynamicResource FlowBackgroundBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="{DynamicResource BorderLightBrush}"
                                      StrokeThickness="2"
                                      X1="{Binding X1}"
                                      X2="{Binding X2}"
                                      Y1="{Binding Y1}"
                                      Y2="{Binding Y2}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="Transparent" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <wv:TaskFlowNodeControl>
                                    <i:Interaction.Behaviors>
                                        <li:DragPositionBehavior X="{Binding X, Mode=TwoWay}" Y="{Binding Y, Mode=TwoWay}" />
                                    </i:Interaction.Behaviors>
                                </wv:TaskFlowNodeControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
