<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- メインのタスクボード領域 -->
        <DockPanel Margin="40,0,24,40">
            <!-- ビュー切り替えとヘッダー -->
            <Grid Margin="0,0,0,24" DockPanel.Dock="Top">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2D5A27"
                               Text="作業の森" />
                    <Border Margin="24,0,0,0"
                            Padding="4"
                            Background="#E8F0E6"
                            CornerRadius="20">
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="16,6"
                                    Background="White"
                                    BorderThickness="0"
                                    Content="リスト"
                                    Style="{StaticResource RoundButtonStyle}" />
                            <Button Padding="16,6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="カンバン"
                                    Foreground="#4A7c44"
                                    Style="{StaticResource RoundButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBox Width="200"
                         Padding="12,6"
                         HorizontalAlignment="Right"
                         Style="{StaticResource OrganicTextBoxStyle}"
                         Tag="タスクを検索..." />
            </Grid>

            <!-- タスク追加入力 -->
            <Border Margin="0,0,0,16"
                    Padding="16,8"
                    DockPanel.Dock="Top"
                    Style="{StaticResource OrganicCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Text="🌱" />
                    <TextBox Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="15"
                             Tag="新しいタスクの種をまく..."
                             Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2"
                            Padding="20,8"
                            Background="#4A7c44"
                            Command="{Binding AddTaskCommand}"
                            Content="追加"
                            Foreground="White"
                            Style="{StaticResource RoundButtonStyle}" />
                </Grid>
            </Border>

            <!-- タスクリスト -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,8"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Border Padding="24,16"
                                        Background="White"
                                        BorderBrush="#E0DDD5"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="12,32,12,32" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#E8F0E6" />
                                                    <Setter Property="BorderBrush" Value="#4A7c44" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Margin="0,0,20,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Status, Converter={StaticResource TaskStatusToBoolConverter}}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <Border Grid.Column="2"
                                                Margin="0,0,20,0"
                                                Padding="10,2"
                                                Background="#FFEBEE"
                                                CornerRadius="10"
                                                Visibility="{Binding Priority, Converter={StaticResource PriorityToVisibilityConverter}}">
                                            <TextBlock FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#C62828"
                                                       Text="緊急" />
                                        </Border>
                                        <Border Grid.Column="3"
                                                Width="28"
                                                Height="28"
                                                Background="#DDD"
                                                CornerRadius="14">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Text="KT" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- タスク詳細パネル (Drawer) -->
        <Border Grid.Column="1"
                Width="450"
                Background="White"
                BorderBrush="#E0DDD5"
                BorderThickness="1,0,0,0"
                CornerRadius="32,0,0,32"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl Content="{Binding TaskDetailViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type wvm:TaskDetailViewModel}">
                        <wv:TaskDetailPanelView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
