<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- メインのタスクボード領域 -->
        <DockPanel Style="{StaticResource TaskBoardContainerStyle}">
            <!-- ビュー切り替えとヘッダー -->
            <Grid Margin="0,0,0,24" DockPanel.Dock="Top">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TaskBoardHeaderTextStyle}" Text="作業の森" />
                    <Border Style="{StaticResource TaskViewSwitcherStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="リスト" Style="{StaticResource TaskViewSwitcherButtonStyle}" />
                            <Button Background="Transparent"
                                    Content="カンバン"
                                    Foreground="{DynamicResource BrandPrimaryHoverBrush}"
                                    Style="{StaticResource TaskViewSwitcherButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBox HorizontalAlignment="Right"
                         Style="{StaticResource OrganicTextBoxStyle}"
                         Tag="タスクを検索..." />
            </Grid>

            <!-- タスク追加入力 -->
            <Button Command="{Binding AddTaskCommand}"
                    DockPanel.Dock="Top"
                    IsEnabled="{Binding ProjectViewModel.IsAssignedToMe}"
                    Style="{StaticResource AddTaskButtonStyle}">
                <Border Style="{StaticResource AddTaskCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   Text="🌱" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="新しいタスクの種をまく..." />
                        <Button Grid.Column="2"
                                Command="{Binding AddTaskCommand}"
                                Content="追加"
                                Foreground="White"
                                Style="{StaticResource RoundButtonStyle}" />
                    </Grid>
                </Border>
            </Button>

            <!-- タスクリスト -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TaskItemBorderStyle}">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  MouseAction="LeftClick" />
                                    <MouseBinding Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  MouseAction="LeftDoubleClick" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Margin="0,0,20,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Status, Converter={StaticResource TaskStatusToBoolConverter}}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}" />
                                    <Border Grid.Column="2"
                                            Style="{StaticResource PriorityBadgeStyle}"
                                            Visibility="{Binding Priority, Converter={StaticResource PriorityToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource PriorityBadgeTextStyle}" Text="緊急" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource SmallUserAvatarIconStyle}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Text="KT" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- タスク詳細パネル (Drawer) -->
        <Border Grid.Column="1"
                Style="{StaticResource TaskDetailDrawerStyle}"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl Content="{Binding TaskSummaryViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type wvm:TaskSummaryViewModel}">
                        <wv:TaskQuickPanelView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
