<UserControl x:Class="TimeLeaf.Views.Workspace.ProjectNotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:entities="clr-namespace:TimeLeaf.Models.Entities"
             xmlns:local="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance wvm:ProjectNotificationsViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="NotificationCardStyle"
               BasedOn="{StaticResource OrganicCardStyle}"
               TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="48,0,48,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <DockPanel Margin="0,0,0,24" LastChildFill="True">
            <Button Command="{Binding MarkAllAsReadCommand}"
                    Content="すべて既読にする"
                    DockPanel.Dock="Right"
                    Style="{StaticResource OrganicButtonStyle}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="通知センター" />
        </DockPanel>

        <!-- 通知リスト -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 通知がない場合の表示 -->
                <Border Margin="0,0,0,12"
                        Padding="32"
                        Style="{StaticResource OrganicCardStyle}"
                        Visibility="{Binding UnreadNotifications.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='Inverse'}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Margin="0,0,0,16"
                                   HorizontalAlignment="Center"
                                   FontSize="48"
                                   Text="🍂" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="未読の通知はありません" />
                    </StackPanel>
                </Border>

                <!-- 通知一覧 -->
                <ItemsControl ItemsSource="{Binding UnreadNotifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type entities:Notification}">
                            <Border Style="{StaticResource NotificationCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding CreatedAt, StringFormat='{}yyyy/MM/dd HH:mm (UTC)'}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="既読"
                                            Style="{StaticResource RoundButtonStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
