<UserControl x:Class="TimeLeaf.Views.AllTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AllTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <Grid Style="{StaticResource ViewHeaderGridStyle}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource ViewHeaderTitleStyle}" Text="全タスク一覧 (All Tasks)" />
                <TextBlock Style="{StaticResource ViewHeaderSubTitleStyle}" Text="プロジェクトを横断して、すべてのタスクを確認・検索できます。" />
            </StackPanel>

            <!-- 検索・フィルター -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <c:ClearableTextBox Width="240"
                                    Margin="0,0,16,0"
                                    Style="{StaticResource SearchTextBoxStyle}"
                                    Tag="🔍 キーワードで検索..."
                                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox VerticalAlignment="Center"
                          Content="未完了のみ表示"
                          IsChecked="{Binding ShowOnlyIncomplete}"
                          Style="{StaticResource FormCheckBoxStyle}" />
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ: タスク一覧 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AllTasks}"
                          Style="{StaticResource ViewMainItemsContainerStyle}"
                          Tag="True" />
        </ScrollViewer>

        <!-- タスクがない場合の表示（オーバーレイ的に中央配置） -->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource ViewPlaceholderTextStyle}"
                   Text="該当するタスクが見つかりませんでした"
                   Visibility="{Binding AllTasks.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='Inverse'}" />
    </Grid>
</UserControl>
