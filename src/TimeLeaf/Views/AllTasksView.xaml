<UserControl x:Class="TimeLeaf.Views.AllTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lk="clr-namespace:LeafKit.UI.Controls;assembly=LeafKit.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AllTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーとフィルターエリア -->
        <Grid Margin="48,32,48,16">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="全タスク一覧 (All Tasks)" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="プロジェクトを横断して、すべてのタスクを確認・検索できます" />
            </StackPanel>

            <!-- 検索・フィルター -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <lk:ClearableTextBox Width="240"
                                     Margin="0,0,16,0"
                                     Background="{DynamicResource SurfaceBaseBrush}"
                                     BorderBrush="{DynamicResource OutlineBaseBrush}"
                                     BorderThickness="1"
                                     Placeholder="🔍 キーワードで検索..."
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox VerticalAlignment="Center"
                          Content="未完了のみ表示"
                          FontSize="13"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          IsChecked="{Binding ShowOnlyIncomplete}" />
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ: タスク一覧 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="48,16,48,48" ItemsSource="{Binding AllTasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 1タスク1カードのデザイン -->
                        <Border Margin="0,0,0,16"
                                Padding="20,16"
                                Style="{DynamicResource OrganicCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- 状態アイコン -->
                                <Border Width="36"
                                        Height="36"
                                        Background="{DynamicResource SurfaceLayer1Brush}"
                                        CornerRadius="18">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Text="{Binding Status, Converter={StaticResource TaskStatusToIconConverter}}" />
                                </Border>

                                <!-- タスク名とプロジェクト名 -->
                                <StackPanel Grid.Column="1"
                                            Margin="20,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Name}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Opacity="0.8"
                                                   Text="🌲 " />
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Opacity="0.8"
                                                   Text="{Binding ProjectName}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 期限 -->
                                <StackPanel Grid.Column="2"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="📅 期限" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}"
                                               Text="{Binding Deadline, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue='未設定'}" />
                                </StackPanel>

                                <!-- 優先度 -->
                                <StackPanel Grid.Column="3"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="⚡ 優先度" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Priority}" />
                                </StackPanel>

                                <!-- 担当者 -->
                                <StackPanel Grid.Column="4"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="👤 担当" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding AssigneeName, TargetNullValue='未設定'}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- タスクがない場合の表示（オーバーレイ的に中央配置） -->
        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontStyle="Italic"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="該当するタスクが見つかりませんでした"
                   Visibility="{Binding AllTasks.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='Inverse'}" />
    </Grid>
</UserControl>
