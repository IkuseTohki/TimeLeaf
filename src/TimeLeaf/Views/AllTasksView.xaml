<UserControl x:Class="TimeLeaf.Views.AllTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:me="clr-namespace:TimeLeaf.Models.Enums"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AllTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <Grid Style="{StaticResource ViewHeaderGridStyle}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource ViewHeaderTitleStyle}" Text="全タスク一覧 (All Tasks)" />
                <TextBlock Style="{StaticResource ViewHeaderSubTitleStyle}" Text="{Binding AllTasks.Count, StringFormat=\{0\} active tasks}" />
            </StackPanel>

                <!-- 表示モード切替（ProjectWorkspaceView と同じく Style 指定を外してデフォルトを適用） -->
                <c:LeafTabSelector HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                         Margin="0,0,24,0"
                                   DisplayMemberPath="Label"
                                   ItemsSource="{Binding ViewModeItems}"
                                   SelectedValue="{Binding CurrentViewMode}"
                                   SelectedValuePath="Value" />

            <!-- 検索・フィルター・表示モード切替 -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">

                <c:ClearableTextBox Style="{StaticResource AllTasksSearchBoxStyle}"
                                    Tag="🔍 Search tasks..."
                                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Incomplete Only"
                          IsChecked="{Binding ShowOnlyIncomplete}"
                          Style="{StaticResource AllTasksFilterCheckBoxStyle}" />
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentSubViewContext}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource AllTasksListTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static me:AllTasksViewMode.List}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AllTasksListTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static me:AllTasksViewMode.Timeline}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AllTasksTimelineTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static me:AllTasksViewMode.Grid}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AllTasksGridTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- タスクがない場合の表示 -->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource ViewPlaceholderTextStyle}"
                   Text="No tasks found matching your criteria."
                   Visibility="{Binding AllTasks.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}" />
    </Grid>
</UserControl>
