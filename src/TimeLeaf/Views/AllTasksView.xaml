<UserControl x:Class="TimeLeaf.Views.AllTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:me="clr-namespace:TimeLeaf.Models.Enums"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AllTasksViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Tokens/Layout.xaml" />
                <ResourceDictionary Source="/Resources/Tokens/Typography.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Text.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Buttons.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Containers.xaml" />
                <ResourceDictionary Source="/Resources/Components/AllTasksView.xaml" />
                <ResourceDictionary Source="/Resources/DataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <Grid Style="{StaticResource GridViewHeaderStyle}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource TextBlockTitleBaseStyle}"
                           Text="タスク一覧" />
                <TextBlock Margin="{StaticResource ContentTopNarrowMargin}"
                           Style="{StaticResource TextBlockViewHeaderSubTitleStyle}"
                           Text="{Binding AllTasks.Count, StringFormat=\{0\} active tasks}" />
            </StackPanel>

            <!-- 検索・フィルター -->
            <StackPanel Style="{StaticResource StackPanelAllTasksHeaderActionContainerStyle}">

                <c:ClearableTextBox Style="{StaticResource ControlAllTasksSearchBoxStyle}"
                                    Tag="🔍 Search tasks..."
                                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel>
                    <CheckBox HorizontalAlignment="Left"
                              Content="未完了タスクのみ"
                              IsChecked="{Binding ShowOnlyIncomplete}"
                              Style="{StaticResource CheckBoxAllTasksFilterStyle}" />
                    <CheckBox Margin="0,2,0,0"
                              HorizontalAlignment="Left"
                              Content="自分のみ"
                              IsChecked="{Binding ShowOnlyMyself}"
                              Style="{StaticResource CheckBoxAllTasksFilterStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 表示モード切替 -->
        <c:LeafTabSelector Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           DisplayMemberPath="Label"
                           ItemsSource="{Binding ViewModeItems}"
                           SelectedValue="{Binding CurrentViewMode}"
                           SelectedValuePath="Value" />

        <!-- メインコンテンツ -->
        <ContentControl Grid.Row="2"
                        Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource AllTasksListTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentViewMode}"
                                     Value="{x:Static me:AllTasksViewMode.List}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AllTasksListTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentViewMode}"
                                     Value="{x:Static me:AllTasksViewMode.Timeline}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AllTasksTimelineTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentViewMode}"
                                     Value="{x:Static me:AllTasksViewMode.Grid}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AllTasksGridTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- タスクがない場合の表示 -->
        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource TextBlockViewPlaceholderStyle}"
                   Text="No tasks found matching your criteria."
                   Visibility="{Binding AllTasks.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}" />
    </Grid>
</UserControl>
