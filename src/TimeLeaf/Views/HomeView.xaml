<UserControl x:Class="TimeLeaf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.leafkit.com/wpf/ui/behaviors"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Margin="48,32,48,16">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Margin="0"
                           FontSize="28"
                           Style="{StaticResource FormTitleTextStyle}"
                           Text="森の広場 (Home)" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="全プロジェクトの状況を俯瞰しています" />
            </StackPanel>

            <!-- ユーザーメニュー -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button x:Name="UserMenuButton"
                        Command="{Binding ToggleUserMenuCommand}"
                        Style="{StaticResource IconButtonStyle}">
                    <Path Width="20"
                          Height="20"
                          Data="{StaticResource MenuIconGeometry}"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Stretch="Uniform" />
                </Button>
                <c:DropdownMenu IsOpen="{Binding IsUserMenuOpen}" PlacementTarget="{Binding ElementName=UserMenuButton}">
                    <StackPanel MinWidth="180" Margin="4">
                        <Button Command="{Binding UserMenu.EditProfileCommand}"
                                Content="プロフィール設定"
                                Style="{DynamicResource MenuButtonStyle}" />
                        <Button Command="{Binding UserMenu.OpenSettingsCommand}"
                                Content="アプリケーション設定"
                                Style="{DynamicResource MenuButtonStyle}" />
                    </StackPanel>
                </c:DropdownMenu>
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,16,48,48">
                <!-- 統計情報 (Stats) -->
                <UniformGrid Margin="0,0,0,32" Columns="4">
                    <Border Margin="0,0,16,0"
                            Padding="24"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="未着手のタスク" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding NotStartedCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,16,0"
                            Padding="24"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="進行中" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding InProgressCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,16,0"
                            Padding="24"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="今週の完了" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding CompletedThisWeekCount}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="24" Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="森の健全性" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}"
                                       Text="Healthy" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左カラム -->
                    <StackPanel Grid.Column="0" Margin="0,0,32,0">
                        <Label Content="🚨 期限が近いタスク" Style="{StaticResource SectionHeaderLabelStyle}" />
                        <Border Margin="0,0,0,32"
                                Padding="24"
                                Style="{StaticResource SurfaceCardStyle}">
                            <ItemsControl ItemsSource="{Binding UpcomingDeadlines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="16,0,0,0"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="{Binding Deadline, StringFormat={}{0:MM/dd}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Label Content="🌲 進行中のプロジェクト" Style="{StaticResource SectionHeaderLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12"
                                            Padding="20"
                                            Style="{StaticResource SurfaceCardStyle}">
                                        <StackPanel>
                                            <TextBlock FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Margin="0,8,0,4"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="進行中" />
                                            <ProgressBar Height="6"
                                                         Background="{DynamicResource SurfaceLayer1Brush}"
                                                         Foreground="{DynamicResource BrandPrimaryBrush}"
                                                         Value="50" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 右カラム -->
                    <StackPanel Grid.Column="1">
                        <Label Content="🏁 マイルストーン" Style="{StaticResource SectionHeaderLabelStyle}" />
                        <Border Margin="0,0,0,32"
                                Padding="24,24,24,8"
                                Style="{StaticResource SurfaceCardStyle}">
                            <ItemsControl ItemsSource="{Binding UpcomingMilestones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="20" />
                                                <!-- 次の項目への繋ぎ（空白行） -->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- タイムラインの縦線: 3行すべてを貫通させる -->
                                            <Rectangle Grid.RowSpan="3"
                                                       Grid.Column="0"
                                                       Width="2"
                                                       HorizontalAlignment="Center"
                                                       Fill="{DynamicResource BrandPrimaryBrush}"
                                                       Opacity="0.2" />

                                            <!-- 1行目: 日付(曜日) プロジェクト名 -->
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,2"
                                                        Orientation="Horizontal">
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding Date, StringFormat={}{0:MM/dd (ddd)}}" />
                                                <TextBlock Margin="12,0,0,0"
                                                           VerticalAlignment="Bottom"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrandPrimaryBrush}"
                                                           Opacity="0.8"
                                                           Text="{Binding ProjectName}" />
                                            </StackPanel>

                                            <!-- タイムラインの丸（ドット）: 2行目の中央に配置 -->
                                            <Ellipse Grid.Row="1"
                                                     Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource BrandPrimaryBrush}" />

                                            <!-- 2行目: マイルストーン名 -->
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Label}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>


                        <Label Content="🍃 ざわめき" Style="{StaticResource SectionHeaderLabelStyle}" />
                        <Border Padding="24" Style="{StaticResource SurfaceCardStyle}">
                            <TextBlock FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="同期履歴から最新のアクティビティを表示します（準備中）"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
