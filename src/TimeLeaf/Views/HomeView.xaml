<UserControl x:Class="TimeLeaf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.leafkit.com/wpf/ui/behaviors"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <Grid Style="{StaticResource ViewHeaderGridStyle}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource ViewHeaderTitleStyle}" Text="森の広場 (Home)" />
                <TextBlock Style="{StaticResource ViewHeaderSubTitleStyle}" Text="全プロジェクトの状況を俯瞰しています。" />
            </StackPanel>

            <!-- ユーザーメニュー -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button x:Name="UserMenuButton"
                        Command="{Binding ToggleUserMenuCommand}"
                        Style="{StaticResource NaturalUserMenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- アバター (イニシャル) -->
                        <Border Style="{StaticResource UserMenuAvatarBorderStyle}">
                            <TextBlock Style="{StaticResource UserMenuInitialTextStyle}" Text="{Binding UserMenu.UserInitial}" />
                        </Border>
                        <!-- ユーザー名 -->
                        <TextBlock Style="{StaticResource UserMenuNameTextStyle}" Text="{Binding UserMenu.UserName}" />
                        <!-- 矢印アイコン -->
                        <Path Style="{StaticResource UserMenuArrowPathStyle}" />
                    </StackPanel>
                </Button>
                <c:DropdownMenu IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=UserMenuButton}">
                    <StackPanel MinWidth="180" Margin="4">
                        <Button Command="{Binding UserMenu.EditProfileCommand}"
                                Content="プロフィール設定"
                                Style="{DynamicResource MenuButtonStyle}" />
                        <Button Command="{Binding UserMenu.OpenSettingsCommand}"
                                Content="アプリケーション設定"
                                Style="{DynamicResource MenuButtonStyle}" />
                    </StackPanel>
                </c:DropdownMenu>
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource ViewMainContainerStyle}">
                <!-- 統計情報 (Stats) -->
                <UniformGrid Columns="4" Style="{StaticResource HomeStatsGridStyle}">
                    <Border Margin="0,0,12,0"
                            Padding="{StaticResource CardPadding}"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HomeStatsLabelStyle}" Text="未着手のタスク" />
                            <TextBlock Style="{StaticResource HomeStatsValueStyle}" Text="{Binding NotStartedCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,12,0"
                            Padding="{StaticResource CardPadding}"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HomeStatsLabelStyle}" Text="進行中" />
                            <TextBlock Style="{StaticResource HomeStatsValueStyle}" Text="{Binding InProgressCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,12,0"
                            Padding="{StaticResource CardPadding}"
                            Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HomeStatsLabelStyle}" Text="今週の完了" />
                            <TextBlock Style="{StaticResource HomeStatsValueStyle}" Text="{Binding CompletedThisWeekCount}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左カラム -->
                    <StackPanel Grid.Column="0" Style="{StaticResource HomeColumnStyle}">
                        <Label Content="🚨 期限が近いタスク" Style="{DynamicResource SectionHeaderLabelStyle}" />
                        <Border Margin="0,0,0,20"
                                Padding="{StaticResource CardPadding}"
                                Style="{StaticResource SurfaceCardStyle}">
                            <ItemsControl ItemsSource="{Binding UpcomingDeadlines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Style="{StaticResource HomeDeadlineItemStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="{Binding Deadline, StringFormat={}{0:MM/dd}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Label Content="🌲 進行中のプロジェクト" Style="{DynamicResource SectionHeaderLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8"
                                            Padding="{StaticResource CardPadding}"
                                            Style="{StaticResource SurfaceCardStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource HomeProjectCardTitleStyle}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource HomeProjectCardSubTitleStyle}" Text="進行中" />
                                            <ProgressBar Style="{StaticResource HomeProjectProgressBarStyle}" Value="50" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 右カラム -->
                    <StackPanel Grid.Column="1">
                        <Label Content="🏳️ マイルストーン" Style="{DynamicResource SectionHeaderLabelStyle}" />
                        <Border Margin="0,0,0,20"
                                Padding="16,16,16,4"
                                Style="{StaticResource SurfaceCardStyle}">
                            <ItemsControl ItemsSource="{Binding UpcomingMilestones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="16" />
                                                <!-- 次の項目への繋ぎ（空白行） -->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- タイムラインの縦線: 3行すべてを貫通させる -->
                                            <Rectangle Grid.RowSpan="3"
                                                       Grid.Column="0"
                                                       Style="{StaticResource HomeMilestoneTimelineLineStyle}" />

                                            <!-- 1行目: 日付(曜日) プロジェクト名 -->
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,2"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource HomeMilestoneDateStyle}" Text="{Binding Date, StringFormat={}{0:MM/dd (ddd)}}" />
                                                <TextBlock Style="{StaticResource HomeMilestoneProjectNameStyle}" Text="{Binding ProjectName}" />
                                            </StackPanel>

                                            <!-- タイムラインの丸（ドット）: 2行目の中央に配置 -->
                                            <Ellipse Grid.Row="1"
                                                     Grid.Column="0"
                                                     Style="{StaticResource HomeMilestoneTimelineDotStyle}" />

                                            <!-- 2行目: マイルストーン名 -->
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Style="{StaticResource HomeMilestoneLabelStyle}"
                                                       Text="{Binding Label}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>


                        <Label Content="🍃 ざわめき" Style="{DynamicResource SectionHeaderLabelStyle}" />
                        <Border Padding="{StaticResource CardPadding}" Style="{StaticResource SurfaceCardStyle}">
                            <TextBlock FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="同期履歴から最新のアクティビティを表示します（準備中）"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
