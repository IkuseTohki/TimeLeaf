<UserControl x:Class="TimeLeaf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.leafkit.com/wpf/ui/behaviors"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Tokens/Layout.xaml" />
                <ResourceDictionary Source="/Resources/Tokens/Typography.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Text.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Buttons.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Containers.xaml" />
                <ResourceDictionary Source="/Resources/Components/Sidebar.xaml" />
                <ResourceDictionary Source="/Resources/Components/UserMenu.xaml" />
                <ResourceDictionary Source="/Resources/Components/Dialogs.xaml" />
                <ResourceDictionary Source="/Resources/Components/Notifications.xaml" />
                <ResourceDictionary Source="/Resources/Components/HomeView.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <Grid Style="{StaticResource GridViewHeaderStyle}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource TextBlockTitleBaseStyle}"
                           Text="広場" />
                <TextBlock Margin="{StaticResource ContentTopNarrowMargin}"
                           Style="{StaticResource TextBlockViewHeaderSubTitleStyle}"
                           Text="全プロジェクトの状況を俯瞰しています。" />
            </StackPanel>

            <!-- ユーザーメニュー -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button x:Name="UserMenuButton"
                        Command="{Binding ToggleUserMenuCommand}"
                        Style="{StaticResource ButtonUserMenuNaturalStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- アバター (イニシャル) -->
                        <Border Style="{StaticResource BorderUserMenuAvatarStyle}">
                            <TextBlock Style="{StaticResource TextBlockUserMenuInitialStyle}"
                                       Text="{Binding UserMenu.UserInitial}" />
                        </Border>
                        <!-- ユーザー名 -->
                        <TextBlock Style="{StaticResource TextBlockUserMenuNameStyle}"
                                   Text="{Binding UserMenu.UserName}" />
                        <!-- 矢印アイコン -->
                        <Path Style="{StaticResource PathUserMenuArrowStyle}" />
                    </StackPanel>
                </Button>
                <c:DropdownMenu IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                PlacementTarget="{Binding ElementName=UserMenuButton}">
                    <StackPanel MinWidth="180"
                                Margin="4">
                        <Button Command="{Binding UserMenu.EditProfileCommand}"
                                Content="プロフィール設定"
                                Style="{DynamicResource MenuButtonStyle}" />
                        <Button Command="{Binding UserMenu.ManageUsersCommand}"
                                Content="ユーザー管理"
                                Style="{DynamicResource MenuButtonStyle}" />
                        <Button Command="{Binding UserMenu.OpenSettingsCommand}"
                                Content="アプリケーション設定"
                                Style="{DynamicResource MenuButtonStyle}" />
                    </StackPanel>
                </c:DropdownMenu>
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource ViewOuterMargin}">
                <!-- ラベル -->
                <StackPanel Margin="{StaticResource ContentLabelMargin}"
                            Orientation="Horizontal">
                    <Path Margin="{StaticResource IconRightMargin}"
                          VerticalAlignment="Center"
                          Data="{StaticResource TaskIconGeometry}"
                          Style="{StaticResource PathBrandIconSmallStyle}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{DynamicResource TextBlockDashboardHeaderStyle}"
                               Text="タスクサマリー" />
                </StackPanel>
                <!-- 統計情報 (Stats) -->
                <StackPanel Margin="{StaticResource SectionBottomMargin}"
                            Orientation="Horizontal">
                    <!-- 未着手 -->
                    <Border Style="{StaticResource SurfaceCardTinyStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource TaskIconGeometry}"
                                  Style="{StaticResource PathBrandIconLargeStyle}" />
                            <StackPanel Grid.Column="1"
                                        Margin="{StaticResource ContentLeftMargin}"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}"
                                           Text="未着手" />
                                <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}"
                                           Text="{Binding NotStartedCount}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 進行中 -->
                    <Border Margin="{StaticResource ContentLeftMargin}"
                            Style="{StaticResource SurfaceCardTinyStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource PenIconGeometry}"
                                  Style="{StaticResource PathBrandIconLargeStyle}" />
                            <StackPanel Grid.Column="1"
                                        Margin="{StaticResource ContentLeftMargin}"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}"
                                           Text="進行中" />
                                <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}"
                                           Text="{Binding InProgressCount}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- レビュー待ち -->
                    <Border Margin="{StaticResource ContentLeftMargin}"
                            Style="{StaticResource SurfaceCardTinyStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource EyedropperIconGeometry}"
                                  Style="{StaticResource PathBrandIconLargeStyle}" />
                            <StackPanel Grid.Column="1"
                                        Margin="{StaticResource ContentLeftMargin}"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}"
                                           Text="レビュー待ち" />
                                <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}"
                                           Text="{Binding InReviewCount}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 今週の完了 -->
                    <Border Margin="{StaticResource ContentLeftMargin}"
                            Style="{StaticResource SurfaceCardTinyStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource CompletedIconGeometry}"
                                  Style="{StaticResource PathBrandIconLargeStyle}" />
                            <StackPanel Grid.Column="1"
                                        Margin="{StaticResource ContentLeftMargin}"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBlockHomeStatsLabelStyle}"
                                           Text="今週の完了" />
                                <TextBlock Style="{StaticResource TextBlockHomeStatsValueStyle}"
                                           Text="{Binding CompletedThisWeekCount}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左カラム -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Margin="{StaticResource ContentLabelMargin}"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Path Margin="{StaticResource IconRightMargin}"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource MilestoneIconGeometry}"
                                  Style="{DynamicResource PathBrandIconStyle}" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource TextBlockDashboardHeaderStyle}"
                                       Text="マイルストーン" />
                        </StackPanel>
                        <Border Margin="{StaticResource SectionBottomMargin}"
                                Padding="16,16,16,4"
                                Style="{StaticResource SurfaceCardMediumStyle}">
                            <ItemsControl ItemsSource="{Binding UpcomingMilestones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="16" />
                                                <!-- 次の項目への繋ぎ（空白行） -->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- タイムラインの縦線: 3行すべてを貫通させる -->
                                            <Rectangle Grid.RowSpan="3"
                                                       Grid.Column="0"
                                                       Style="{StaticResource RectangleHomeMilestoneTimelineLineStyle}" />

                                            <!-- 1行目: 日付(曜日) プロジェクト名 -->
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,2"
                                                        Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource TextBlockHomeMilestoneDateStyle}"
                                                           Text="{Binding Date, StringFormat={}{0:MM/dd (ddd)}}" />
                                                <TextBlock Style="{StaticResource TextBlockHomeMilestoneProjectNameStyle}"
                                                           Text="{Binding ProjectName}" />
                                            </StackPanel>

                                            <!-- タイムラインの丸（ドット）: 2行目の中央に配置 -->
                                            <Ellipse Grid.Row="1"
                                                     Grid.Column="0"
                                                     Style="{StaticResource EllipseHomeMilestoneTimelineDotStyle}" />

                                            <!-- 2行目: マイルストーン名 -->
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Style="{StaticResource TextBlockHomeMilestoneLabelStyle}"
                                                       Text="{Binding Label}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- 右カラム -->
                    <StackPanel Grid.Column="1"
                                Margin="{StaticResource ContentLeftMargin}">
                        <TextBlock Margin="{StaticResource ContentLabelMargin}"
                                   Style="{DynamicResource TextBlockDashboardHeaderStyle}"
                                   Text="🚨 期限が近いタスク" />
                        <Border Margin="{StaticResource SectionBottomMargin}"
                                Style="{StaticResource SurfaceCardStyle}">
                            <ItemsControl ItemsSource="{Binding UpcomingDeadlines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Style="{StaticResource GridHomeDeadlineItemStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource WarningBrush}"
                                                       Text="{Binding Deadline, StringFormat={}{0:MM/dd}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="{StaticResource ContentLeftMargin}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
