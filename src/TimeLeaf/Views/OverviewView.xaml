<UserControl x:Class="TimeLeaf.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance vm:OverviewViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <Grid Style="{StaticResource OverviewContainerStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <DockPanel Style="{StaticResource OverviewHeaderStyle}">
            <TextBlock Style="{StaticResource OverviewTitleStyle}" Text="TimeLeaf Forest" />

            <Button HorizontalAlignment="Right"
                    Command="{Binding AddProjectCommand}"
                    Content="+ 新規プロジェクト"
                    Style="{DynamicResource PrimaryButtonStyle2}" />
        </DockPanel>

        <!-- プロジェクトグリッド -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.NavigateToProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ProjectCardButtonStyle}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Style="{StaticResource ProjectCardBorderStyle}">
                                        <StackPanel>
                                            <!-- ヘッダー -->
                                            <Grid Style="{StaticResource ProjectCardHeaderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ProjectCardNameStyle}" Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource ProjectCardUpdatedStyle}" Text="{Binding DisplayLastUpdated, StringFormat={}最終更新: {0}}" />
                                                </StackPanel>
                                                <Border Style="{StaticResource ProjectCardHealthBorderStyle}">
                                                    <TextBlock Style="{StaticResource ProjectCardHealthTextStyle}" />
                                                </Border>
                                            </Grid>

                                            <!-- 樹木 (Sprout) -->
                                            <Viewbox Style="{StaticResource ProjectCardTreeContainerStyle}">
                                                <Canvas Width="100" Height="100">
                                                    <!-- Ground Line -->
                                                    <Rectangle Canvas.Left="10"
                                                               Canvas.Top="95"
                                                               Width="80"
                                                               Height="1"
                                                               Fill="{DynamicResource OutlineBaseBrush}" />
                                                    <!-- Trunk -->
                                                    <Path Data="{StaticResource TreeSproutTrunkGeometry}" Fill="#5d4037" />
                                                    <!-- Leaf -->
                                                    <Path Data="{StaticResource TreeSproutLeafGeometry}" Style="{StaticResource ProjectCardLeafPathStyle}" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- 進捗統計 -->
                                            <Grid Style="{StaticResource ProjectCardStatsGridStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                                    <TextBlock Style="{StaticResource ProjectCardStatsLabelStyle}" Text="進捗" />
                                                    <TextBlock Style="{StaticResource ProjectCardStatsValueStyle}" Text="65%" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               Style="{StaticResource ProjectCardStatsLabelStyle}"
                                                               Text="見積工数" />
                                                    <TextBlock HorizontalAlignment="Center"
                                                               Style="{StaticResource ProjectCardStatsValueStyle}"
                                                               Text="{Binding TotalEstimatedCost, StringFormat={}{0}h}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Style="{StaticResource ProjectCardStatsLabelStyle}"
                                                               Text="期限" />
                                                    <TextBlock Style="{StaticResource ProjectCardStatsValueStyle}" Text="2026/05/20" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
