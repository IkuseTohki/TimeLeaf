<UserControl x:Class="TimeLeaf.Views.ApplicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="720"
             Height="520"
             d:DataContext="{d:DesignInstance vm:ApplicationSettingsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Navigation Button Style -->
            <Style x:Key="RadioButtonSettingsNavStyle"
                   TargetType="RadioButton">
                <Setter Property="Height" Value="48" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource RadiusTab}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{TemplateBinding Tag}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrandSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Organic Card Section Style -->
            <Style x:Key="BorderSettingsSectionCardStyle"
                   BasedOn="{StaticResource OrganicCardStyle}"
                   TargetType="Border">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="0,0,0,24" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
                <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            </Style>

            <!-- Holiday Item Style -->
            <Style x:Key="BorderHolidayItemStyle"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Background" Value="{DynamicResource BrandSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource RadiusMax}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- Override excessive margins from LeafKit.UI or Dialogs.xaml -->
            <Style x:Key="GridDialogRootStyleOverride"
                   TargetType="Grid">
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource GridDialogRootStyleOverride}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar + Content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Padding="24,24,12,24"
                    Background="{DynamicResource SurfaceLayer1Brush}"
                    BorderBrush="{DynamicResource OutlineBaseBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton Command="{Binding SelectCategoryCommand}"
                                 CommandParameter="{x:Static vm:SettingsCategory.Storage}"
                                 Content="📁"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Storage}}"
                                 Style="{StaticResource RadioButtonSettingsNavStyle}"
                                 Tag="場所" />
                    <RadioButton Command="{Binding SelectCategoryCommand}"
                                 CommandParameter="{x:Static vm:SettingsCategory.Appearance}"
                                 Content="🎨"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Appearance}}"
                                 Style="{StaticResource RadioButtonSettingsNavStyle}"
                                 Tag="外観" />
                    <RadioButton Command="{Binding SelectCategoryCommand}"
                                 CommandParameter="{x:Static vm:SettingsCategory.Calendar}"
                                 Content="📅"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Calendar}}"
                                 Style="{StaticResource RadioButtonSettingsNavStyle}"
                                 Tag="カレンダー" />
                    <RadioButton Command="{Binding SelectCategoryCommand}"
                                 CommandParameter="{x:Static vm:SettingsCategory.Notifications}"
                                 Content="🔔"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Notifications}}"
                                 Style="{StaticResource RadioButtonSettingsNavStyle}"
                                 Tag="通知" />
                    <RadioButton Command="{Binding SelectCategoryCommand}"
                                 CommandParameter="{x:Static vm:SettingsCategory.Behavior}"
                                 Content="⚙️"
                                 IsChecked="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Behavior}}"
                                 Style="{StaticResource RadioButtonSettingsNavStyle}"
                                 Tag="動作" />
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1"
                  Background="{DynamicResource WorkspaceBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="32">
                        <!-- Storage Settings -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Storage}}">
                            <TextBlock Margin="{StaticResource FormTitleMargin}"
                                       Style="{StaticResource TextBlockFormTitleStyle}"
                                       Text="データ保存場所" />
                            <Border Style="{StaticResource BorderSettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlockFormLabelStyle}"
                                               Text="現在の保存先フォルダ:" />
                                    <TextBlock Margin="0,8,0,16"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding StoragePath}"
                                               TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding ResetStoragePathCommand}"
                                            Content="場所を変更する..."
                                            Style="{StaticResource ButtonSecondaryStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource TextBlockSettingsAnnotationStyle}"
                                       Text="※変更するとアプリケーションは終了します。次回起動時に再設定を行ってください。" />
                        </StackPanel>

                        <!-- Appearance Settings -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Appearance}}">
                            <TextBlock Margin="{StaticResource FormTitleMargin}"
                                       Style="{StaticResource TextBlockFormTitleStyle}"
                                       Text="外観" />
                            <Border Style="{StaticResource BorderSettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlockFormLabelStyle}"
                                               Text="テーマの選択:" />
                                    <ComboBox Width="200"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="Left"
                                              SelectedValue="{Binding SelectedTheme}"
                                              SelectedValuePath="Content"
                                              Style="{DynamicResource ComboBoxFormCompactStyle}">
                                        <ComboBoxItem Content="Forest" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource TextBlockSettingsAnnotationStyle}"
                                       Text="※Forestは目に優しい緑を基調としたテーマです。" />
                        </StackPanel>

                        <!-- Calendar Settings -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Calendar}}">
                            <TextBlock Margin="{StaticResource FormTitleMargin}"
                                       Style="{StaticResource TextBlockFormTitleStyle}"
                                       Text="カレンダーと稼働日" />

                            <Border Style="{StaticResource BorderSettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlockFormLabelStyle}"
                                               Text="稼働曜日の設定" />
                                    <UniformGrid Margin="0,12,0,0"
                                                 Columns="4">
                                        <CheckBox Content="月曜日"
                                                  IsChecked="{Binding IsMondayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                        <CheckBox Content="火曜日"
                                                  IsChecked="{Binding IsTuesdayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                        <CheckBox Content="水曜日"
                                                  IsChecked="{Binding IsWednesdayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                        <CheckBox Content="木曜日"
                                                  IsChecked="{Binding IsThursdayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                        <CheckBox Content="金曜日"
                                                  IsChecked="{Binding IsFridayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                        <CheckBox Content="土曜日"
                                                  IsChecked="{Binding IsSaturdayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                        <CheckBox Content="日曜日"
                                                  IsChecked="{Binding IsSundayWorkday}"
                                                  Style="{StaticResource FormCheckBoxStyle}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource BorderSettingsSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TextBlockFormLabelStyle}"
                                               Text="休日・祝日の管理" />
                                    <Grid Margin="0,12,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <c:LeafDatePicker SelectedDate="{Binding NewHolidayDate}" />
                                        <Button Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Command="{Binding AddHolidayCommand}"
                                                Content="追加"
                                                Style="{StaticResource ButtonPrimaryStyle}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Holidays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BorderHolidayItemStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="13"
                                                                   Text="{Binding StringFormat=yyyy/MM/dd (ddd)}" />
                                                        <Button Width="20"
                                                                Height="20"
                                                                Margin="8,0,-4,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.RemoveHolidayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="×"
                                                                FontSize="14"
                                                                Style="{StaticResource ButtonRoundStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource TextBlockSettingsAnnotationStyle}"
                                       Text="※非稼働日はタイムライン上でハイライトされ、期間計算から除外されます。" />
                        </StackPanel>

                        <!-- Notification Settings -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Notifications}}">
                            <TextBlock Margin="{StaticResource FormTitleMargin}"
                                       Style="{StaticResource TextBlockFormTitleStyle}"
                                       Text="通知" />
                            <Border Style="{StaticResource BorderSettingsSectionCardStyle}">
                                <StackPanel>
                                    <CheckBox Margin="0,0,0,16"
                                              Content="OS標準のトースト通知を利用する"
                                              IsChecked="{Binding EnableOsNotification}"
                                              Style="{StaticResource FormCheckBoxStyle}" />
                                    <CheckBox Content="アプリ内のスナックバー通知を表示する"
                                              IsChecked="{Binding EnableAppNotification}"
                                              Style="{StaticResource FormCheckBoxStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Behavior Settings -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static vm:SettingsCategory.Behavior}}">
                            <TextBlock Margin="{StaticResource FormTitleMargin}"
                                       Style="{StaticResource TextBlockFormTitleStyle}"
                                       Text="動作" />
                            <Border Style="{StaticResource BorderSettingsSectionCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="閉じるボタン押下時にタスクトレイに常駐させる"
                                              IsChecked="{Binding MinimizeOnClose}"
                                              Style="{StaticResource FormCheckBoxStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource TextBlockSettingsAnnotationStyle}"
                                       Text="※常駐モードでは、アプリを閉じても情報の同期や通知を継続します。" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="1"
                Padding="24,16"
                Background="{DynamicResource SurfaceBaseBrush}"
                BorderBrush="{DynamicResource OutlineBaseBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="120"
                        Command="{Binding SaveCommand}"
                        Content="設定を保存"
                        Style="{StaticResource ButtonDialogActionStyle}" />
                <Button Width="100"
                        Margin="{StaticResource ButtonLeftMargin}"
                        Command="{Binding CancelCommand}"
                        Content="キャンセル"
                        Style="{StaticResource ButtonDialogCancelStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
