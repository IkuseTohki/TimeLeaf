<UserControl x:Class="TimeLeaf.Views.ApplicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance vm:ApplicationSettingsViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <Grid Style="{StaticResource GridDialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Style="{StaticResource TextBlockFormTitleStyle}" Text="アプリケーション設定" />

        <!-- Content -->
        <StackPanel Grid.Row="1" Style="{StaticResource StackPanelSettingsContainerStyle}">
            <!-- Storage Settings -->
            <GroupBox Header="データ保存場所" Style="{StaticResource GroupBoxSettingsStyle}">
                <StackPanel>
                    <TextBlock Margin="{StaticResource FormLabelMargin}"
                               Style="{StaticResource TextBlockFormLabelStyle}"
                               Text="現在の保存先フォルダ:" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Margin="0,0,10,0"
                                 IsReadOnly="True"
                                 Style="{StaticResource TextBoxOrganicStyle}"
                                 Text="{Binding StoragePath}" />
                        <Button Grid.Column="1"
                                MinWidth="60"
                                Command="{Binding ResetStoragePathCommand}"
                                Content="変更..."
                                Style="{StaticResource ButtonRoundStyle}"
                                ToolTip="保存場所を変更するには再起動が必要です" />
                    </Grid>
                    <TextBlock Style="{StaticResource TextBlockSettingsAnnotationStyle}" Text="※変更するとアプリケーションは終了します。次回起動時に再設定を行ってください。" />
                </StackPanel>
            </GroupBox>

            <!-- Appearance Settings -->
            <GroupBox Header="外観" Style="{StaticResource GroupBoxSettingsStyle}">
                <StackPanel>
                    <TextBlock Margin="{StaticResource FormLabelMargin}"
                               Style="{StaticResource TextBlockFormLabelStyle}"
                               Text="テーマ:" />
                    <ComboBox Width="200"
                              HorizontalAlignment="Left"
                              SelectedValue="{Binding SelectedTheme}"
                              SelectedValuePath="Content"
                              Style="{DynamicResource ComboBoxFormCompactStyle}">
                        <ComboBoxItem Content="Forest" IsSelected="True" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- Notification Settings -->
            <GroupBox Header="通知" Style="{StaticResource GroupBoxSettingsStyle}">
                <StackPanel>
                    <CheckBox Content="OSの通知を利用する (トースト通知)"
                              IsChecked="{Binding EnableOsNotification}"
                              Style="{StaticResource FormCheckBoxStyle}" />
                    <CheckBox Content="アプリ内の通知を利用する (スナックバー)"
                              IsChecked="{Binding EnableAppNotification}"
                              Style="{StaticResource FormCheckBoxStyle}" />
                </StackPanel>
            </GroupBox>

            <!-- Behavior Settings -->
            <GroupBox Header="動作" Style="{StaticResource GroupBoxSettingsStyle}">
                <StackPanel>
                    <CheckBox Content="閉じるボタン押下時にタスクトレイに最小化する"
                              IsChecked="{Binding MinimizeOnClose}"
                              Style="{StaticResource FormCheckBoxStyle}" />
                    <TextBlock Style="{StaticResource TextBlockSettingsAnnotationStyle}" Text="※オフにすると、ウィンドウを閉じた際にアプリケーションが完全に終了します。" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Style="{StaticResource StackPanelDialogFooterStyle}">
            <Button Command="{Binding SaveCommand}"
                    Content="保存"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
