<UserControl x:Class="TimeLeaf.Views.ApplicationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance vm:ApplicationSettingsViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="{DynamicResource WindowBackgroundBrush}"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Label Content="アプリケーション設定" Style="{DynamicResource FirstSectionHeaderLabelStyle}" />

        <!-- Content -->
        <StackPanel Grid.Row="1">
            <!-- Storage Settings -->
            <GroupBox Margin="0,0,0,20"
                      Padding="10"
                      Header="データ保存場所">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="現在の保存先フォルダ:" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding StoragePath}" />
                        <Button Grid.Column="1"
                                Command="{Binding ResetStoragePathCommand}"
                                Content="変更..."
                                ToolTip="保存場所を変更するには再起動が必要です" />
                    </Grid>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="※変更するとアプリケーションは終了します。次回起動時に再設定を行ってください。" />
                </StackPanel>
            </GroupBox>

            <!-- Appearance Settings -->
            <GroupBox Margin="0,0,0,20"
                      Padding="10"
                      Header="外観">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="テーマ:" />
                    <ComboBox Width="200"
                              HorizontalAlignment="Left"
                              SelectedValue="{Binding SelectedTheme}"
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Forest" IsSelected="True" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- Notification Settings -->
            <GroupBox Padding="10" Header="通知">
                <StackPanel>
                    <CheckBox Content="OSの通知を利用する (トースト通知)" IsChecked="{Binding EnableOsNotification}" />
                    <CheckBox Content="アプリ内の通知を利用する (スナックバー)" IsChecked="{Binding EnableAppNotification}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource OutlinedButtonStyle}" />
            <Button Command="{Binding SaveCommand}"
                    Content="保存"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
