<Window x:Class="TimeLeaf.Views.SetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        Title="TimeLeaf - 初期設定"
        Width="500"
        Height="350"
        Background="White"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- 簡易スタイル定義 (テーマ読み込み前なのでハードコードまたは簡易定義) -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Margin="0,0,0,10"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="TimeLeafへようこそ" />
            <TextBlock Text="プロジェクトデータを保存・同期するフォルダを選択してください。" TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="#666"
                       Text="共有フォルダ（OneDriveやDropboxなど）を指定すると、チームメンバーとデータを共有できます。" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,5" Text="データ保存場所 (ルートフォルダ):" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Padding="5"
                         VerticalContentAlignment="Center"
                         Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Click="BrowseButton_Click"
                        Content="参照..." />
            </Grid>
            <TextBlock Margin="0,5,0,0"
                       Foreground="Red"
                       Text="{Binding ErrorMessage}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Click="CancelButton_Click"
                    Content="キャンセル"
                    IsCancel="true" />
            <Button Command="{Binding SaveAndStartCommand}"
                    Content="設定して開始"
                    FontWeight="Bold"
                    IsDefault="true" />
        </StackPanel>
    </Grid>
</Window>
