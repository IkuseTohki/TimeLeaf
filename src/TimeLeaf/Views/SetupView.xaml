<Window x:Class="TimeLeaf.Views.SetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        Title="TimeLeaf - 初期設定"
        Width="530"
        Height="350"
        Style="{StaticResource WindowSetupStyle}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <StackPanel Style="{StaticResource StackPanelDialogRootStyle}">
        <!-- Header -->
        <TextBlock Style="{StaticResource TextBlockTitleBaseStyle}"
                   Text="TimeLeafへようこそ" />

        <TextBlock Margin="{StaticResource ContentTopWideMargin}"
                   Style="{StaticResource TextBlockSetupDescriptionStyle}"
                   Text="プロジェクトデータを保存・同期するフォルダを選択してください。" />

        <TextBlock Margin="{StaticResource ContentTopMediumMargin}"
                   Style="{StaticResource TextBlockSetupSubDescriptionStyle}"
                   Text="共有フォルダ（OneDriveやDropboxなど）を指定すると、チームメンバーとデータを共有できます。" />

        <!-- Input Area -->
        <Label Margin="{StaticResource ContentTopWideMargin}"
               Content="データ保存場所 (ルートフォルダ):"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0"
                     Style="{StaticResource TextBoxOrganicStyle}"
                     Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Command="{Binding BrowseStoragePathCommand}"
                    Content="参照..."
                    Style="{StaticResource ButtonRoundStyle}" />
        </Grid>

        <TextBlock Margin="{StaticResource ContentTopWideMargin}"
                   Style="{StaticResource TextBlockSetupErrorStyle}"
                   Text="{Binding ErrorMessage}" />

        <!-- Footer -->
        <StackPanel Margin="{StaticResource ContentTopMediumMargin}"
                    Style="{StaticResource StackPanelSetupFooterStyle}">
            <Button Command="{Binding SaveAndStartCommand}"
                    Content="保存"
                    IsDefault="true"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Margin="{StaticResource ButtonLeftMargin}"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    IsCancel="true"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </StackPanel>

</Window>
