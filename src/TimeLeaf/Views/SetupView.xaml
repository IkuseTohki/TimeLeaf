<Window x:Class="TimeLeaf.Views.SetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        Title="TimeLeaf - 初期設定"
        Width="530"
        Height="350"
        Background="{DynamicResource SurfaceBaseBrush}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <StackPanel Margin="24">
        <!-- Header -->
        <TextBlock Margin="0,0,0,10"
                   FontSize="24"
                   FontWeight="Bold"
                   Style="{StaticResource FormTitleTextStyle}"
                   Text="TimeLeafへようこそ" />

        <TextBlock Margin="0,0,0,10"
                   Text="プロジェクトデータを保存・同期するフォルダを選択してください。"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,5,0,20"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="共有フォルダ（OneDriveやDropboxなど）を指定すると、チームメンバーとデータを共有できます。" />

        <!-- Input Area -->
        <Label Content="データ保存場所 (ルートフォルダ):" Style="{StaticResource FormLabelStyle}" />

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0"
                     Style="{StaticResource FormTextBoxStyle}"
                     Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Command="{Binding BrowseStoragePathCommand}"
                    Content="参照..."
                    Style="{StaticResource ModernButtonStyle}" />
        </Grid>

        <TextBlock Margin="0,-15,0,20"
                   Foreground="{DynamicResource ErrorBrush}"
                   Text="{Binding ErrorMessage}" />

        <!-- Footer -->
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    IsCancel="true"
                    Style="{StaticResource ModernButtonStyle}" />
            <Button Command="{Binding SaveAndStartCommand}"
                    Content="設定して開始"
                    IsDefault="true"
                    Style="{StaticResource PrimaryButtonStyle2}" />
        </StackPanel>
    </StackPanel>
</Window>
