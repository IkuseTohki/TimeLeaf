<Window x:Class="TimeLeaf.Views.SetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
        Title="TimeLeaf - 初期設定"
        Width="530"
        Height="350"
        Style="{StaticResource WindowSetupStyle}"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <StackPanel Style="{StaticResource StackPanelSetupContainerStyle}">
        <!-- Header -->
        <TextBlock Style="{StaticResource TextBlockSetupHeaderStyle}" Text="TimeLeafへようこそ" />

        <TextBlock Style="{StaticResource TextBlockSetupDescriptionStyle}" Text="プロジェクトデータを保存・同期するフォルダを選択してください。" />

        <TextBlock Style="{StaticResource TextBlockSetupSubDescriptionStyle}" Text="共有フォルダ（OneDriveやDropboxなど）を指定すると、チームメンバーとデータを共有できます。" />

        <!-- Input Area -->
        <Label Content="データ保存場所 (ルートフォルダ):" Style="{StaticResource LabelSectionHeaderBaseStyle}" />

        <Grid Style="{StaticResource GridSetupInputAreaStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Margin="0,0,10,0"
                     Style="{StaticResource TextBoxOrganicStyle}"
                     Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Command="{Binding BrowseStoragePathCommand}"
                    Content="参照..."
                    Style="{StaticResource ButtonRoundStyle}" />
        </Grid>

        <TextBlock Style="{StaticResource TextBlockSetupErrorStyle}" Text="{Binding ErrorMessage}" />

        <!-- Footer -->
        <StackPanel Style="{StaticResource StackPanelSetupFooterStyle}">
            <Button Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    IsCancel="true"
                    Style="{StaticResource ButtonSecondaryStyle}" />
            <Button Command="{Binding SaveAndStartCommand}"
                    Content="設定して開始"
                    IsDefault="true"
                    Style="{StaticResource ButtonPrimaryStyle}" />
        </StackPanel>
    </StackPanel>

</Window>
