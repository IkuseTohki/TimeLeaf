<UserControl x:Class="TimeLeaf.Views.ReorderProjectItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthSmall}"
             Height="450"
             d:DataContext="{d:DesignInstance vm:ReorderProjectItemsViewModel}"
             mc:Ignorable="d">
    <Grid Style="{StaticResource GridDialogRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Style="{StaticResource TextBlockFormTitleStyle}" Text="コンテナ・タスクの並び替え" />

        <!-- 説明文 -->
        <TextBlock Grid.Row="1"
                   Margin="0,0,0,20"
                   Style="{StaticResource MetaBaseStyle}"
                   Text="コンテナ内でのタスク順序、またはコンテナ自身の順序を変更します。"
                   TextWrapping="Wrap" />

        <!-- アイテムリスト -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Items}"
                 Style="{StaticResource ListBoxReorderStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- アイテム情報（左側） -->
                        <StackPanel Grid.Column="0"
                                    Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <!-- アイコン（コンテナ/タスク） -->
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,8,0"
                                  Data="{StaticResource FolderIconGeometry}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsContainer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Path Width="10"
                                  Height="10"
                                  Margin="1,0,9,0"
                                  Data="{StaticResource DocumentIconGeometry}"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform"
                                  Visibility="{Binding IsContainer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <!-- アイテム名 -->
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Item.Name}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 移動ボタン（右側、ホバー時のみ表示） -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Command="{Binding DataContext.MoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource ButtonIconSmallStyle}"
                                    ToolTip="上へ移動">
                                <Button.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ArrayMultiConverter}">
                                        <Binding Path="." />
                                        <Binding Source="True" />
                                    </MultiBinding>
                                </Button.CommandParameter>
                                <Path Width="10"
                                      Height="10"
                                      Data="{StaticResource ArrowUpIconGeometry}"
                                      Fill="{DynamicResource BrandPrimaryBrush}"
                                      Stretch="Uniform" />
                            </Button>
                            <Button Margin="4,0,0,0"
                                    Command="{Binding DataContext.MoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource ButtonIconSmallStyle}"
                                    ToolTip="下へ移動">
                                <Button.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ArrayMultiConverter}">
                                        <Binding Path="." />
                                        <Binding Source="False" />
                                    </MultiBinding>
                                </Button.CommandParameter>
                                <Path Width="10"
                                      Height="10"
                                      Data="{StaticResource ArrowDownIconGeometry}"
                                      Fill="{DynamicResource BrandPrimaryBrush}"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- フッターボタン -->
        <StackPanel Grid.Row="3" Style="{StaticResource StackPanelDialogFooterStyle}">
            <Button Command="{Binding ConfirmCommand}"
                    Content="保存"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
