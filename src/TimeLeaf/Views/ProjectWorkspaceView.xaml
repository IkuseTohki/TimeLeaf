<UserControl x:Class="TimeLeaf.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance vm:ProjectWorkspaceViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- サブビューのDataTemplate定義 -->
        <DataTemplate DataType="{x:Type wvm:ProjectDashboardViewModel}">
            <wv:ProjectDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectTasksViewModel}">
            <wv:ProjectTasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectTimelineViewModel}">
            <wv:ProjectTimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectSettingsViewModel}">
            <wv:ProjectSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectNotificationsViewModel}">
            <wv:ProjectNotificationsView />
        </DataTemplate>
    </UserControl.Resources>

    <!-- サイドバーは MainWindow で管理されるようになったため、コンテンツ領域のみを定義 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー (ProjectWorkspaceView 特有のヘッダー) -->
        <Grid Margin="48,32,48,16">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="{Binding ProjectName, Mode=OneWay}" />
                    <Run BaselineAlignment="Center"
                         FontSize="12"
                         Text=" 進行中" />
                </TextBlock>
                <TextBlock Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="個別プロジェクトのワークスペースを表示中" />
            </StackPanel>

            <!-- 操作ボタン / 参加バナー -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">

                <!-- 参加バナー (非参加時) -->
                <Button Command="{Binding ProjectViewModel.JoinProjectCommand}"
                        Content="このプロジェクトに参加する"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding IsUserAssigned, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <!-- サブメニュー (参加時) -->
                <ItemsControl ItemsSource="{Binding NavigationItems}" Visibility="{Binding IsUserAssigned, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="4,0"
                                    Padding="12,6"
                                    Command="{Binding DataContext.SwitchSubViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Parameter}"
                                    Content="{Binding Label}"
                                    Style="{StaticResource OrganicButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Width="40"
                        Height="40"
                        Margin="16,0,0,0"
                        Background="{DynamicResource BrandPrimaryHoverBrush}"
                        CornerRadius="20">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="KT" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- サブビュー表示領域 -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentSubViewModel}" />
    </Grid>
</UserControl>
