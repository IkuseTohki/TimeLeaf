<UserControl x:Class="TimeLeaf.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance vm:ProjectWorkspaceViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーエリア -->
        <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
            <Button Padding="10,5"
                    Command="{Binding DataContext.NavigateBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="← 戻る" />
            <TextBlock Margin="20,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="タスク管理" />
        </StackPanel>

        <!-- 入力エリア -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="300"
                         Height="32"
                         Padding="5,0"
                         VerticalContentAlignment="Center"
                         Tag="タスク名"
                         Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="120"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding TaskStatusValues}"
                          SelectedItem="{Binding NewTaskStatus}" />
                <ComboBox Width="100"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding TaskPriorityValues}"
                          SelectedItem="{Binding NewTaskPriority}" />
                <Button Margin="10,0,0,0"
                        Padding="15,0"
                        Command="{Binding AddTaskCommand}"
                        Content="タスク追加" />
            </StackPanel>
            <TextBox Height="40"
                     Margin="0,10,0,0"
                     AcceptsReturn="True"
                     Tag="説明"
                     Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- 表示エリア -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10"
                                BorderBrush="#EEE"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" Text="{Binding Name}" />
                                    <Border Margin="10,0,0,0"
                                            Padding="4,1"
                                            Background="#F5F5F5"
                                            CornerRadius="2">
                                        <TextBlock FontSize="10"
                                                   Foreground="#666"
                                                   Text="{Binding Status}" />
                                    </Border>
                                    <Border Margin="5,0,0,0"
                                            Padding="4,1"
                                            Background="#FFF3E0"
                                            CornerRadius="2">
                                        <TextBlock FontSize="10"
                                                   Foreground="#E65100"
                                                   Text="{Binding Priority}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="#666"
                                           Text="{Binding Description}"
                                           Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
