<UserControl x:Class="TimeLeaf.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:TimeLeaf.Views"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance vm:ProjectWorkspaceViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- サブビューのDataTemplate定義 -->
        <DataTemplate DataType="{x:Type wvm:ProjectDashboardViewModel}">
            <wv:ProjectDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectTasksViewModel}">
            <wv:ProjectTasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectTimelineViewModel}">
            <wv:ProjectTimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectSettingsViewModel}">
            <wv:ProjectSettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー (ProjectWorkspaceView 特有のヘッダー) -->
        <Grid Style="{StaticResource ViewHeaderGridStyle}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource ProjectWorkspaceTitleStyle}">
                    <Run Text="{Binding ProjectName, Mode=OneWay}" />
                    <Run Style="{StaticResource ProjectStatusTextStyle}" Text=" 進行中" />
                </TextBlock>
                <TextBlock Margin="0,4,0,4"
                           Style="{StaticResource ViewHeaderSubTitleStyle}"
                           Text="個別プロジェクトのワークスペースを表示中" />
            </StackPanel>

            <!-- 操作ボタン / 参加バナー -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">

                <!-- 参加バナー (非参加時) -->
                <Button Command="{Binding ProjectViewModel.JoinProjectCommand}"
                        Content="このプロジェクトに参加する"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding IsUserAssigned, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <!-- タブナビゲーション (統一されたコンポーネント) -->
                <c:LeafTabSelector Margin="0,0,0,4"
                                   DisplayMemberPath="Label"
                                   ItemsSource="{Binding NavigationItems}"
                                   SelectedValue="{Binding CurrentViewName}"
                                   SelectedValuePath="Parameter"
                                   Visibility="{Binding IsUserAssigned, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <!-- サブビュー表示領域 -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentSubViewModel}" />
    </Grid>
</UserControl>
