<UserControl x:Class="TimeLeaf.Views.ProjectWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
             xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
             d:DataContext="{d:DesignInstance vm:ProjectWorkspaceViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- サブビューのDataTemplate定義 -->
        <DataTemplate DataType="{x:Type wvm:ProjectDashboardViewModel}">
            <wv:ProjectDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectTasksViewModel}">
            <wv:ProjectTasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectTimelineViewModel}">
            <wv:ProjectTimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type wvm:ProjectSettingsViewModel}">
            <wv:ProjectSettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F9F7F2">
        <Grid.ColumnDefinitions>
            <!-- サイドバーのカラム。IsSidebarExpanded に応じて幅を変更 -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- オーガニック・サイドバー -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Width="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToDoubleConverter}, ConverterParameter='220,80'}"
                Background="#2D5A27"
                CornerRadius="0,32,32,0">
            <Grid>
                <DockPanel LastChildFill="True">
                    <!-- ブランドロゴエリア -->
                    <StackPanel Margin="20,32,20,40"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                        <Path Width="24"
                              Height="24"
                              Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"
                              Fill="White" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="TimeLeaf"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- ナビゲーションメニュー -->
                    <StackPanel>
                        <Button Command="{Binding SwitchSubViewCommand}"
                                CommandParameter="Dashboard"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Text="🏠" />
                                <TextBlock Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Dashboard"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchSubViewCommand}"
                                CommandParameter="Tasks"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Text="🌿" />
                                <TextBlock Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Tasks"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchSubViewCommand}"
                                CommandParameter="Timeline"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Text="⏳" />
                                <TextBlock Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Timeline"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchSubViewCommand}"
                                CommandParameter="Settings"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Text="⚙️" />
                                <TextBlock Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Settings"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 折りたたみボタン -->
                <Button Width="24"
                        Height="24"
                        Margin="0,0,-12,32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Command="{Binding ToggleSidebarCommand}"
                        Content="{Binding IsSidebarExpanded, Converter={StaticResource SidebarToggleIconConverter}}" />
            </Grid>
        </Border>

        <!-- メインコンテンツエリア -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Grid Margin="48,32,48,16">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2D5A27">
                        <Run Text="{Binding ProjectName, Mode=OneWay}" />
                        <Run BaselineAlignment="Center"
                             FontSize="12"
                             Text=" 進行中" />
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="#706E6B"
                               Text="根を張り始めて 12日目 － 最後の記録: たった今" />
                </StackPanel>

                <!-- 戻るボタン等 -->
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Padding="12,6"
                            Command="{Binding DataContext.NavigateBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="← 森へ戻る"
                            Style="{StaticResource OrganicButtonStyle}" />
                    <Border Width="40"
                            Height="40"
                            Margin="16,0,0,0"
                            Background="#4A7c44"
                            CornerRadius="20">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="KT" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- サブビュー表示領域 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentSubViewModel}" />
        </Grid>
    </Grid>
</UserControl>
