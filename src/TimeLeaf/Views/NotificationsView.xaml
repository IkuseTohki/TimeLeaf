<UserControl x:Class="TimeLeaf.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             d:DataContext="{d:DesignInstance vm:NotificationsViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- グローバルヘッダーエリア（グローバル表示時のみ表示） -->
        <Grid Grid.Row="0"
              Style="{StaticResource ViewHeaderGridStyle}"
              Visibility="{Binding IsGlobalContext, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource ViewHeaderTitleStyle}" Text="通知センター" />
                <TextBlock Style="{StaticResource ViewHeaderSubTitleStyle}" Text="期限切れのタスクなどを確認できます。" />
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding MarkAllAsReadCommand}"
                    Content="すべて既読にする"
                    Style="{StaticResource OrganicButtonStyle}" />
        </Grid>

        <!-- プロジェクト内アクションエリア（プロジェクト表示時のみ表示） -->
        <Grid Grid.Row="0"
              Margin="48,16,48,0"
              Visibility="{Binding IsGlobalContext, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Inverse'}">
            <Button HorizontalAlignment="Right"
                    Command="{Binding MarkAllAsReadCommand}"
                    Content="すべて既読にする"
                    Style="{StaticResource OrganicButtonStyle}" />
        </Grid>

        <!-- 通知リスト -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- 通知一覧 -->
            <ItemsControl ItemsSource="{Binding UnreadNotifications}" Style="{StaticResource ViewMainItemsContainerStyle}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NotificationViewModel}">
                        <Border Style="{StaticResource NotificationCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource NotificationTitleTextStyle}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource NotificationMessageTextStyle}" Text="{Binding Message}" />
                                    <TextBlock Style="{StaticResource NotificationTimestampTextStyle}" Text="{Binding CreatedAt, StringFormat='{}yyyy/MM/dd'}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                    <Button Width="50"
                                            Margin="0,0,8,0"
                                            Command="{Binding NavigateCommand}"
                                            Content="開く"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Visibility="{Binding CanNavigate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Width="50"
                                            Command="{Binding MarkAsReadCommand}"
                                            Content="既読"
                                            Style="{StaticResource RoundButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 通知がない場合の表示 -->
        <Border Grid.Row="1"
                Margin="48,16,48,48"
                Style="{StaticResource NotificationEmptyStateStyle}"
                Visibility="{Binding UnreadNotifications.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='Inverse'}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NotificationEmptyIconStyle}" Text="🍂" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="未読の通知はありません" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
