<UserControl x:Class="TimeLeaf.Views.AddMilestoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthSmall}"
             d:DataContext="{d:DesignInstance vm:AddMilestoneViewModel}"
             mc:Ignorable="d">
    <StackPanel Style="{StaticResource DialogRootStackPanelStyle}">
        <TextBlock Style="{StaticResource FormTitleTextStyle}" Text="マイルストーン追加" />

        <Label Content="日付" Style="{StaticResource FirstSectionHeaderLabelStyle}" />
        <c:LeafDatePicker Margin="{StaticResource FormItemMargin}"
                          Placeholder="日付を選択..."
                          SelectedDate="{Binding Date}" />

        <Label Content="名称" Style="{StaticResource SectionHeaderLabelStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="マイルストーン名を入力..."
                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel Style="{StaticResource DialogFooterStackPanelStyle}">
            <Button Command="{Binding ConfirmCommand}"
                    Content="追加"
                    Style="{StaticResource DialogActionButtonStyle}" />
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource DialogCancelButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
