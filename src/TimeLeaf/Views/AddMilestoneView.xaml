<UserControl x:Class="TimeLeaf.Views.AddMilestoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthSmall}"
             d:DataContext="{d:DesignInstance vm:AddMilestoneViewModel}"
             mc:Ignorable="d">
    <StackPanel Margin="0">
        <TextBlock Style="{StaticResource FormTitleTextStyle}" Text="マイルストーン追加" />

        <Label Content="日付" Style="{StaticResource FirstSectionHeaderLabelStyle}" />
        <c:LeafDatePicker Placeholder="日付を選択..." SelectedDate="{Binding Date}" />

        <Label Content="名称" Style="{StaticResource SectionHeaderLabelStyle}" />
        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                 Tag="マイルストーン名を入力..."
                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel Margin="{StaticResource FormFooterMargin}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="100"
                    Command="{Binding ConfirmCommand}"
                    Content="追加する"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Width="100"
                    Margin="{StaticResource ButtonLeftMargin}"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
