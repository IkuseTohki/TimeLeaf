<UserControl x:Class="TimeLeaf.Views.AddMilestoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthSmall}"
             d:DataContext="{d:DesignInstance vm:AddMilestoneViewModel}"
             mc:Ignorable="d">
    <StackPanel Style="{StaticResource StackPanelDialogRootStyle}">
        <TextBlock Margin="{StaticResource FormTitleMargin}"
                   Style="{StaticResource TextBlockFormTitleStyle}"
                   Text="マイルストーン追加" />

        <Label Margin="{StaticResource FormLabelMargin}"
               Content="日付"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />
        <c:LeafDatePicker Margin="{StaticResource FormItemMargin}"
                          Placeholder="日付を選択..."
                          SelectedDate="{Binding Date}" />

        <Label Margin="{StaticResource FormLabelMargin}"
               Content="名称"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="マイルストーン名を入力..."
                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel Margin="{StaticResource FormFooterMargin}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding ConfirmCommand}"
                    Content="追加"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Margin="{StaticResource ButtonLeftMargin}"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
