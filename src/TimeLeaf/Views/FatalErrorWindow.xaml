<Window x:Class="TimeLeaf.Views.FatalErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeLeaf - 致命的なエラー"
        Width="650"
        Height="500"
        Background="#F9F7F2"
        Icon="pack://application:,,,/LeafKit.UI;component/Resources/AppIcon.ico"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource HeaderLabel}" Text="申し訳ありません。予期しないエラーが発生しました。" />
            <TextBlock Margin="0,0,0,16"
                       FontSize="13"
                       Foreground="#706E6B"
                       Text="以下の情報を開発者に共有していただくことで、問題の解決に役立てることができます。" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0DDD5"
                BorderThickness="1"
                CornerRadius="8">
            <TextBox x:Name="ErrorDetailText"
                     Margin="12"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas, Meiryo"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,12,0"
                    Padding="16,8"
                    Background="#4A7c44"
                    Click="CopyButton_Click"
                    Content="エラー内容をコピー"
                    FontWeight="Bold"
                    Foreground="White">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Padding="24,8"
                    Background="White"
                    BorderBrush="#E0DDD5"
                    BorderThickness="1"
                    Click="CloseButton_Click"
                    Content="閉じる"
                    IsCancel="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
