<UserControl x:Class="TimeLeaf.Views.AddProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthMedium}"
             d:DataContext="{d:DesignInstance vm:AddProjectViewModel}"
             mc:Ignorable="d">
    <StackPanel Style="{StaticResource StackPanelDialogRootStyle}">
        <TextBlock Style="{StaticResource TextBlockFormTitleStyle}" Text="プロジェクト作成" />

        <Label Content="プロジェクト名" Style="{StaticResource LabelFormFirstSectionHeaderStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="例：新機能のプロトタイプ作成"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="概要" Style="{StaticResource LabelFormSectionHeaderStyle}" />
        <TextBox Height="{StaticResource MultilineInputHeightSmall}"
                 Margin="{StaticResource FormItemMargin}"
                 AcceptsReturn="True"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="プロジェクトの目的や背景を記入してください..."
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" />

        <!-- フッターボタン -->
        <StackPanel Style="{StaticResource StackPanelDialogFooterStyle}">
            <Button Command="{Binding ConfirmCommand}"
                    Content="作成"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
