<UserControl x:Class="TimeLeaf.Views.AddProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="440"
             d:DataContext="{d:DesignInstance vm:AddProjectViewModel}"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Margin="0,0,0,24"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="新規プロジェクトの種をまく" />

        <!-- プロジェクト名 -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Margin="0,0,0,8"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="プロジェクト名" />
            <TextBox Height="36"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Tag="例：新機能のプロトタイプ作成"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 概要 -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Margin="0,0,0,8"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="概要" />
            <TextBox Height="80"
                     AcceptsReturn="True"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Tag="プロジェクトの目的や背景を記入してください..."
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <!-- フッターボタン -->
        <StackPanel Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ModernButtonStyle}" />
            <Button Margin="12,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Content="作成する"
                    Style="{StaticResource PrimaryButtonStyle2}" />
        </StackPanel>
    </StackPanel>
</UserControl>
