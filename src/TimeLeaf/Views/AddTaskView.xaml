<UserControl x:Class="TimeLeaf.Views.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:conv="clr-namespace:LeafKit.UI.Converters;assembly=LeafKit.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthLarge}"
             d:DataContext="{d:DesignInstance vm:AddTaskViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- セレクター用アイテムテンプレート -->
        <DataTemplate x:Key="TeammateItemTemplate">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="32"
                        Height="32"
                        Background="Transparent">
                    <ContentControl Template="{StaticResource PersonAvatarTemplate}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding DisplayName}" />
                </StackPanel>

                <!-- 選択チェックマーク -->
                <Path x:Name="CheckMark"
                      Grid.Column="2"
                      Width="14"
                      Height="14"
                      Data="{StaticResource CheckIconGeometry}"
                      Fill="{DynamicResource BrandPrimaryBrush}"
                      Stretch="Uniform"
                      Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TeammateSelectedTemplate">
            <Grid x:Name="SelectedContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="20"
                        Height="20"
                        VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource PersonAvatarTemplate}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Style="{StaticResource LabelBaseStyle}"
                           Text="{Binding DisplayName}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="0">
        <TextBlock Style="{StaticResource FormTitleTextStyle}" Text="タスク作成" />

        <Label Content="タスク名" Style="{StaticResource FirstSectionHeaderLabelStyle}" />
        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                 Tag="例：UIプロトタイプの作成"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="詳細" Style="{StaticResource SectionHeaderLabelStyle}" />
        <TextBox Height="{StaticResource MultilineInputHeight}"
                 AcceptsReturn="True"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="作業の具体的な内容や目的を記入してください..."
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ステータス -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Label Content="ステータス" Style="{StaticResource SectionHeaderLabelStyle}" />
                <ComboBox ItemsSource="{Binding TaskStatusValues}"
                          SelectedItem="{Binding Status}"
                          Style="{DynamicResource CompactFormComboBoxStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">
                <Label Content="優先度" Style="{StaticResource SectionHeaderLabelStyle}" />
                <ComboBox ItemsSource="{Binding TaskPriorityValues}"
                          SelectedItem="{Binding Priority}"
                          Style="{DynamicResource CompactFormComboBoxStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <Label Content="担当者" Style="{StaticResource SectionHeaderLabelStyle}" />
                <c:LeafSearchableSelector DisplayMemberPath="DisplayName"
                                          ItemTemplate="{StaticResource TeammateItemTemplate}"
                                          ItemsSource="{Binding Teammates}"
                                          Placeholder="担当者を選択..."
                                          SelectedItem="{Binding Assignee}"
                                          SelectedTemplate="{StaticResource TeammateSelectedTemplate}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2">
                <Label Content="期限" Style="{StaticResource SectionHeaderLabelStyle}" />
                <c:LeafDatePicker Placeholder="Select due date..." SelectedDate="{Binding DueDate}" />
            </StackPanel>
        </Grid>

        <Label Content="見積工数 (h)" Style="{StaticResource SectionHeaderLabelStyle}" />
        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                 Tag="例：1.5"
                 Text="{Binding EstimatedWorkHours, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel Margin="{StaticResource FormFooterMargin}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Command="{Binding ConfirmCommand}"
                    Content="作成する"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Width="80"
                    Margin="{StaticResource ButtonLeftMargin}"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
