<UserControl x:Class="TimeLeaf.Views.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
             xmlns:conv="clr-namespace:LeafKit.UI.Converters;assembly=LeafKit.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lk="clr-namespace:LeafKit.UI.Controls;assembly=LeafKit.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="{StaticResource DialogWidthLarge}"
             d:DataContext="{d:DesignInstance vm:AddTaskViewModel}"
             mc:Ignorable="d">
    <StackPanel Style="{StaticResource StackPanelDialogRootStyle}">
        <TextBlock Margin="{StaticResource FormTitleMargin}"
                   Style="{StaticResource TextBlockFormTitleStyle}"
                   Text="タスク作成" />

        <Label Margin="{StaticResource FormLabelMargin}"
               Content="タスク名"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="例：UIプロトタイプの作成"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Label Margin="{StaticResource FormLabelMargin}"
               Content="詳細"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />
        <TextBox Height="{StaticResource SizeHeight50}"
                 Margin="{StaticResource FormItemMargin}"
                 AcceptsReturn="True"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="作業の具体的な内容や目的を記入してください..."
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ステータス -->
            <StackPanel Grid.Row="0"
                        Grid.Column="0">
                <Label Margin="{StaticResource FormLabelMargin}"
                       Content="ステータス"
                       Style="{StaticResource LabelSectionHeaderBaseStyle}" />
                <lk:InteractiveChipsPicker Margin="{StaticResource FormItemMargin}"
                                           ItemsSource="{Binding TaskStatusValues}"
                                           Orientation="Horizontal"
                                           SelectedItem="{Binding Status, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="0"
                        Grid.Column="2">
                <Label Margin="{StaticResource FormLabelMargin}"
                       Content="優先度"
                       Style="{StaticResource LabelSectionHeaderBaseStyle}" />
                <lk:InteractiveChipsPicker Margin="{StaticResource FormItemMargin}"
                                           ItemsSource="{Binding TaskPriorityValues}"
                                           Orientation="Horizontal"
                                           SelectedItem="{Binding Priority, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="0">
                <Label Margin="{StaticResource FormLabelMargin}"
                       Content="予定開始日"
                       Style="{StaticResource LabelSectionHeaderBaseStyle}" />
                <c:LeafDatePicker Margin="{StaticResource FormItemMargin}"
                                  Placeholder="Select start date..."
                                  SelectedDate="{Binding PlannedStartDate}" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="2">
                <Label Margin="{StaticResource FormLabelMargin}"
                       Content="期限"
                       Style="{StaticResource LabelSectionHeaderBaseStyle}" />
                <c:LeafDatePicker Margin="{StaticResource FormItemMargin}"
                                  Placeholder="Select due date..."
                                  SelectedDate="{Binding DueDate}" />
            </StackPanel>
        </Grid>

        <Label Margin="{StaticResource FormLabelMargin}"
               Content="担当者"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />
        <c:LeafSearchableSelector Margin="{StaticResource FormItemMargin}"
                                  DisplayMemberPath="DisplayName"
                                  ItemContainerStyle="{StaticResource TeammateItemContainerCompactStyle}"
                                  ItemTemplate="{StaticResource TeammateItemCompactTemplate}"
                                  ItemsSource="{Binding Teammates}"
                                  Placeholder="担当者を選択..."
                                  SelectedItem="{Binding Assignee}"
                                  SelectedTemplate="{StaticResource TeammateSelectedCompactTemplate}" />

        <Label Margin="{StaticResource FormLabelMargin}"
               Content="見積工数 (h)"
               Style="{StaticResource LabelSectionHeaderBaseStyle}" />
        <TextBox Margin="{StaticResource FormItemMargin}"
                 Style="{StaticResource ModernTextBoxStyle}"
                 Tag="例：1.5"
                 Text="{Binding EstimatedWorkHours, UpdateSourceTrigger=PropertyChanged}" />

        <!-- フッターボタン -->
        <StackPanel Margin="{StaticResource FormFooterMargin}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding ConfirmCommand}"
                    Content="作成"
                    Style="{StaticResource ButtonDialogActionStyle}" />
            <Button Margin="{StaticResource ButtonLeftMargin}"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ButtonDialogCancelStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
