<UserControl x:Class="TimeLeaf.Views.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeLeaf.ViewModels"
             Width="520"
             d:DataContext="{d:DesignInstance vm:AddTaskViewModel}"
             mc:Ignorable="d">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource AddTaskFormTitleStyle}" Text="新しいタスクを枝分かれさせる" />

        <!-- タスク名 -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="タスク名" />
            <TextBox Height="36"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Tag="例：UIプロトタイプの作成"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 概要 -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="詳細" />
            <TextBox Height="100"
                     AcceptsReturn="True"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Tag="作業の具体的な内容や目的を記入してください..."
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ステータス -->
            <StackPanel Grid.Column="0" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="ステータス" />
                <ComboBox Height="36"
                          ItemsSource="{Binding TaskStatusValues}"
                          SelectedItem="{Binding Status}" />
            </StackPanel>

            <!-- 優先度 -->
            <StackPanel Grid.Column="2" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="優先度" />
                <ComboBox Height="36"
                          ItemsSource="{Binding TaskPriorityValues}"
                          SelectedItem="{Binding Priority}" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 担当者 -->
            <StackPanel Grid.Column="0" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="担当者" />
                <TextBox Height="36"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- 期限 -->
            <StackPanel Grid.Column="2" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="期限" />
                <DatePicker Height="36" SelectedDate="{Binding DueDate}" />
            </StackPanel>
        </Grid>

        <!-- 見積工数 -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource AddTaskFormLabelStyle}" Text="見積工数 (h)" />
            <TextBox Height="36"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Tag="例：1.5"
                     Text="{Binding EstimatedWorkHours, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- フッターボタン -->
        <StackPanel Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}"
                    Content="キャンセル"
                    Style="{StaticResource ModernButtonStyle}" />
            <Button Margin="12,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Content="作成する"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
