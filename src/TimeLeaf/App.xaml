<Application x:Class="TimeLeaf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TimeLeaf.ViewModels.Converters"
             xmlns:local="clr-namespace:TimeLeaf"
             xmlns:viewModels="clr-namespace:TimeLeaf.ViewModels"
             xmlns:views="clr-namespace:TimeLeaf.Views"
             xmlns:workspace="clr-namespace:TimeLeaf.ViewModels.Workspace"
             xmlns:workspaceViews="clr-namespace:TimeLeaf.Views.Workspace">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Design System Tokens (Foundational Constants) -->
                <ResourceDictionary Source="/Resources/Tokens/Layout.xaml" />
                <ResourceDictionary Source="/Resources/Tokens/Typography.xaml" />
                <ResourceDictionary Source="/Resources/Tokens/Colors.xaml" />

                <!-- 2. Themes & Icons (Global Visual State) -->
                <ResourceDictionary Source="/Resources/ForestColors.xaml" />
                <ResourceDictionary Source="/Resources/Icons.xaml" />

                <!-- 3. Infrastructure (Shared Library Components) -->
                <ResourceDictionary Source="pack://application:,,,/LeafKit.UI;component/Resources/ControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LeafKit.UI;component/Resources/ComponentStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LeafKit.UI;component/Resources/FormStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LeafKit.UI;component/Resources/LayoutStyles.xaml" />

                <!-- 4. Global Utilities & Base Styles -->
                <ResourceDictionary Source="/Resources/Converters.xaml" />
                <ResourceDictionary Source="/Resources/Common/SharedStyles.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Text.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Buttons.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Inputs.xaml" />
                <ResourceDictionary Source="/Resources/Controls/Containers.xaml" />

                <!-- 5. App Top-level DataTemplates (ViewModel-to-View mapping) -->
                <ResourceDictionary Source="/Resources/DataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- DataTemplate for Dialog Contents -->
            <DataTemplate DataType="{x:Type viewModels:AddProjectViewModel}">
                <views:AddProjectView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AddTaskViewModel}">
                <views:AddTaskView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AddMilestoneViewModel}">
                <views:AddMilestoneView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AddContainerViewModel}">
                <views:AddContainerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ReorderWorkItemsViewModel}">
                <views:ReorderWorkItemsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProfileEditViewModel}">
                <views:ProfileEditView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:UserManagementViewModel}">
                <views:UserManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ApplicationSettingsViewModel}">
                <views:ApplicationSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type workspace:TaskDetailViewModel}">
                <workspaceViews:TaskDetailView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
