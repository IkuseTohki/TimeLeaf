<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls">

    <!-- ====================================================================== -->
    <!-- Button Bases & Styles -->
    <!-- ====================================================================== -->

    <!-- 角丸の強いボタンスタイル（透過背景） -->
    <Style x:Key="RoundButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 危険な操作ボタンのスタイル -->
    <Style x:Key="DangerButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="#FFEBEE" />
        <Setter Property="BorderBrush" Value="#FFCDD2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#D32F2F" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Input Components -->
    <!-- ====================================================================== -->

    <!-- オーガニックな入力欄（TextBox）スタイル -->
    <Style x:Key="OrganicTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource InputHeightMedium}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- 検索用入力欄（ClearableTextBox 等）のスタイル -->
    <Style x:Key="SearchTextBoxStyle" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ComboBox (CompactFormComboBoxStyle) の上書き -->
    <Style x:Key="CompactFormComboBoxStyle"
           BasedOn="{StaticResource BaseComboBoxStyle}"
           TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource FormItemMargin}" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- LeafDatePicker の上書き -->
    <Style TargetType="{x:Type c:LeafDatePicker}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- サイドバー：アイコン用テキストスタイル -->
    <Style x:Key="SidebarIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Reorder Work Items View Components -->
    <!-- ====================================================================== -->

    <!-- 小さなボタン用のスタイル -->
    <Style x:Key="SmallIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- Menu & ContextMenu Styles -->
    <!-- ====================================================================== -->

    <!-- TimeLeaf標準のMenuItemスタイル -->
    <Style x:Key="TimeLeafMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                <ColumnDefinition Width="13" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon"
                                              Margin="8,0"
                                              VerticalAlignment="Center"
                                              ContentSource="Icon"
                                              TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="Arrow"
                                       Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="›"
                                       Visibility="Collapsed" />
                            <Popup x:Name="SubMenuPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   VerticalOffset="-4">
                                <Border Background="{DynamicResource SurfaceBaseBrush}"
                                        BorderBrush="{DynamicResource OutlineBaseBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          Opacity="0.1"
                                                          ShadowDepth="1" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="2" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <ItemsPresenter Grid.IsSharedSizeScope="True" RenderOptions.ClearTypeHint="Enabled" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TimeLeaf標準のContextMenuスタイル -->
    <Style x:Key="TimeLeafContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              Opacity="0.1"
                                              ShadowDepth="1" />
                        </Border.Effect>
                        <ItemsPresenter Margin="{TemplateBinding Padding}" Grid.IsSharedSizeScope="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- ContextMenu内のMenuItemにスタイルを適用 -->
        <Style.Resources>
            <Style BasedOn="{StaticResource TimeLeafMenuItemStyle}" TargetType="MenuItem" />
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource OutlineBaseBrush}" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- アプリ全体のデフォルトとして適用 -->
    <Style BasedOn="{StaticResource TimeLeafMenuItemStyle}" TargetType="MenuItem" />
    <Style BasedOn="{StaticResource TimeLeafContextMenuStyle}" TargetType="ContextMenu" />

</ResourceDictionary>
