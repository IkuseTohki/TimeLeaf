<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls">

    <!-- ====================================================================== -->
    <!-- Button Bases & Styles -->
    <!-- ====================================================================== -->

    <!-- 角丸の強いボタンスタイル（透過背景） -->
    <Style x:Key="RoundButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 危険な操作ボタンのスタイル -->
    <Style x:Key="DangerButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="#FFEBEE" />
        <Setter Property="BorderBrush" Value="#FFCDD2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#D32F2F" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Input Components -->
    <!-- ====================================================================== -->

    <!-- オーガニックな入力欄（TextBox）スタイル -->
    <Style x:Key="OrganicTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource InputHeightMedium}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="ModernTextBoxStyle"
           BasedOn="{StaticResource OrganicTextBoxStyle}"
           TargetType="TextBox" />

    <!-- 検索用入力欄（ClearableTextBox 等）のスタイル -->
    <Style x:Key="SearchTextBoxStyle" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ComboBox (CompactFormComboBoxStyle) の上書き -->
    <Style x:Key="CompactFormComboBoxStyle"
           BasedOn="{StaticResource BaseComboBoxStyle}"
           TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- LeafDatePicker の上書き -->
    <Style TargetType="{x:Type c:LeafDatePicker}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- サイドバー：アイコン用テキストスタイル -->
    <Style x:Key="SidebarIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
