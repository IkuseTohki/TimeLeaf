<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Tokens/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/LeafKit.UI;component/Resources/DarkColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme Marker -->
    <sys:String x:Key="TimeLeafThemeName">Dark</sys:String>

    <!-- ====================================================================== -->
    <!-- TimeLeaf Dark Theme - Semantic Overrides -->
    <!-- ====================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush"
                     Color="{StaticResource Slate800}" />
    <SolidColorBrush x:Key="TextBaseBrush"
                     Color="{StaticResource Slate100}" />
    <LinearGradientBrush x:Key="NotificationPaneBackgroundBrush" StartPoint="1,0.5" EndPoint="0,0.5">
        <GradientStop Offset="0.6" Color="#F20F172A" />
        <GradientStop Offset="1.0" Color="#000F172A" />
    </LinearGradientBrush>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush"
                     Color="{StaticResource Slate900}" />
    <SolidColorBrush x:Key="SidebarSelectedBackgroundBrush"
                     Color="{StaticResource Slate700}" />
    <SolidColorBrush x:Key="SidebarTextBrush"
                     Color="{StaticResource Slate50}" />
    <SolidColorBrush x:Key="SidebarHoverOverlayBrush"
                     Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SidebarPressedOverlayBrush"
                     Color="#33FFFFFF" />

    <!-- Task Specific Brushes -->
    <SolidColorBrush x:Key="PriorityHighBrush"
                     Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="PriorityMediumBrush"
                     Color="{StaticResource Green400}" />
    <SolidColorBrush x:Key="PriorityLowBrush"
                     Color="{StaticResource Slate400}" />

    <SolidColorBrush x:Key="StatusCompletedBrush"
                     Color="{StaticResource Slate400}" />
    <SolidColorBrush x:Key="StatusInReviewBrush"
                     Color="#A29BFE" />
    <SolidColorBrush x:Key="StatusInProgressBrush"
                     Color="{StaticResource Green400}" />

    <SolidColorBrush x:Key="DeadlineOverdueBrush"
                     Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="DeadlineTodayBrush"
                     Color="{StaticResource Orange500}" />
    <SolidColorBrush x:Key="DeadlineNearBrush"
                     Color="{StaticResource Amber500}" />

    <SolidColorBrush x:Key="ProgressBarBlankBrush"
                     Color="{StaticResource Slate700}" />

    <SolidColorBrush x:Key="FlowBackgroundBrush"
                     Color="{StaticResource Slate900}" />
    <SolidColorBrush x:Key="AllTasksProjectCardBackgroundBrush"
                     Color="{StaticResource Slate700}" />

    <!-- Notifications -->
    <SolidColorBrush x:Key="BadgeBackgroundBrush"
                     Color="{StaticResource Red600}" />

    <!-- Feedback -->
    <SolidColorBrush x:Key="ErrorBrush"
                     Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource Orange500}" />
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{StaticResource Green400}" />

    <!-- ====================================================================== -->
    <!-- Theme-dependent Shapes (Standard feel) -->
    <!-- ====================================================================== -->
    <!-- Standard LeafKit.UI tokens -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ContainerCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!-- TimeLeaf specific tokens -->
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusContainer">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusTab">4</CornerRadius>

</ResourceDictionary>
