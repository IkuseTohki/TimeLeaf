<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Tokens/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- Dark Theme - Semantic Brushes -->
    <!-- ====================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource Slate900}" />
    <SolidColorBrush x:Key="SurfaceLayer1Brush" Color="{StaticResource Slate800}" />
    <SolidColorBrush x:Key="SurfaceLayer2Brush" Color="{StaticResource Slate700}" />
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{StaticResource Slate800}" />

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource Green400}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource Green900}" />
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="{StaticResource Slate900}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Slate50}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Slate400}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Slate600}" />

    <!-- Feedback -->
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Orange500}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green400}" />

    <!-- Outline -->
    <SolidColorBrush x:Key="OutlineBaseBrush" Color="{StaticResource Slate700}" />

    <!-- States -->
    <SolidColorBrush x:Key="StateHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="StatePressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="StateSelectedBrush" Color="{StaticResource Green900}" />

</ResourceDictionary>
