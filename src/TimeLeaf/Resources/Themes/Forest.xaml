<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Tokens/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- Forest Theme - Semantic Brushes -->
    <!-- ====================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="SurfaceLayer1Brush" Color="{StaticResource Green50}" />
    <SolidColorBrush x:Key="SurfaceLayer2Brush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#F0F4EF" />

    <!-- Brand (Deeper Forest Green) -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2D5A27" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#E8F0E6" />
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="{StaticResource White}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B3018" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6359" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#B0B8AF" />

    <!-- Feedback -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#B03A2E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D35400" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2D5A27" />

    <!-- Outline -->
    <SolidColorBrush x:Key="OutlineBaseBrush" Color="#D1D9D0" />

    <!-- States -->
    <SolidColorBrush x:Key="StateHoverBrush" Color="#0D2D5A27" />
    <SolidColorBrush x:Key="StatePressedBrush" Color="#1A2D5A27" />
    <SolidColorBrush x:Key="StateSelectedBrush" Color="#26E8F0E6" />

</ResourceDictionary>
