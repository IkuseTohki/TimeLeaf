<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Tokens/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- Light Theme - Semantic Brushes -->
    <!-- ====================================================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="SurfaceLayer1Brush" Color="{StaticResource Slate50}" />
    <SolidColorBrush x:Key="SurfaceLayer2Brush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{StaticResource LegacyLightBackground}" />

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource Green600}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource Green100}" />
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="{StaticResource White}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Slate900}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Slate500}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Slate300}" />

    <!-- Feedback -->
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource LegacyErrorRed}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource LegacyWarningOrange}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green600}" />

    <!-- Outline -->
    <SolidColorBrush x:Key="OutlineBaseBrush" Color="{StaticResource Slate200}" />

    <!-- States -->
    <SolidColorBrush x:Key="StateHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="StatePressedBrush" Color="#14000000" />
    <SolidColorBrush x:Key="StateSelectedBrush" Color="{StaticResource Green50}" />

</ResourceDictionary>
