<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/LeafKit.UI;component/Resources/ForestColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- TimeLeaf-specific overrides for Forest theme -->
    <Color x:Key="ErrorColor">#B03A2E</Color>
    <Color x:Key="WarningColor">#D35400</Color>

    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#F0F4EF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="GlobalSidebarBackgroundBrush" Color="{StaticResource BrandPrimaryColor}" />

    <!-- Semantic Brushes for Tasks -->
    <SolidColorBrush x:Key="PriorityHighBrush" Color="#B03A2E" />
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="#2D5A27" />
    <SolidColorBrush x:Key="PriorityLowBrush" Color="#737A71" />

    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#737A71" />
    <SolidColorBrush x:Key="StatusInReviewBrush" Color="#6A5ACD" />
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{StaticResource BrandPrimaryColor}" />

    <SolidColorBrush x:Key="DeadlineOverdueBrush" Color="#B03A2E" />
    <SolidColorBrush x:Key="DeadlineTodayBrush" Color="#D35400" />
    <SolidColorBrush x:Key="DeadlineNearBrush" Color="#E67E22" />

    <SolidColorBrush x:Key="ProgressBarBlankBrush" Color="#E8F0E6" />

    <LinearGradientBrush x:Key="NotificationPaneBackgroundBrush" StartPoint="1,0.5" EndPoint="0,0.5">
        <GradientStop Offset="0.6" Color="#F2FFFFFF" />
        <GradientStop Offset="1.0" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="FlowBackgroundBrush" Color="#FAFAFA" />

    <SolidColorBrush x:Key="AllTasksProjectCardBackgroundBrush" Color="#E0EDD5" />

    <!-- 4. 形状・定数 (角丸) -->
    <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ContainerCornerRadius">32</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ComboBoxItemCornerRadius">8</CornerRadius>
</ResourceDictionary>
