<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="IconPathBrandStyle" TargetType="Path">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="LargeIconPathBrandStyle"
           BasedOn="{StaticResource IconPathBrandStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="SmallIconPathBrandStyle"
           BasedOn="{StaticResource IconPathBrandStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="IconPathSecondaryStyle"
           BasedOn="{StaticResource IconPathBrandStyle}"
           TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="LargeIconPathSecondaryStyle"
           BasedOn="{StaticResource IconPathSecondaryStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="SmallIconPathSecondaryStyle"
           BasedOn="{StaticResource IconPathSecondaryStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Effects -->
    <!-- ====================================================================== -->

    <DropShadowEffect x:Key="AllTasksShadowEffect"
                      BlurRadius="10"
                      Direction="-90"
                      Opacity="{StaticResource OpacityMuted}"
                      ShadowDepth="2" />

</ResourceDictionary>
