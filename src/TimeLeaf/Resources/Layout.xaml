<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================================================== -->
    <!-- Constants & Measures -->
    <!-- ====================================================================== -->
    <sys:Double x:Key="ButtonHeightMedium">28</sys:Double>
    <sys:Double x:Key="ButtonHeightSmall">22</sys:Double>
    <sys:Double x:Key="ButtonHeightLarge">36</sys:Double>
    <sys:Double x:Key="InputHeightMedium">32</sys:Double>

    <!-- レイアウト計測値 (Compact Design) -->
    <sys:Double x:Key="SpacingSmall">8</sys:Double>
    <sys:Double x:Key="SpacingMedium">16</sys:Double>
    <sys:Double x:Key="SpacingLarge">24</sys:Double>
    <sys:Double x:Key="SectionMarginBottom">20</sys:Double>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ViewOuterMargin">24,16,24,24</Thickness>

    <!-- フォーム・ダイアログ関連 -->
    <sys:Double x:Key="DialogWidthSmall">320</sys:Double>
    <sys:Double x:Key="DialogWidthMedium">400</sys:Double>
    <sys:Double x:Key="DialogWidthLarge">480</sys:Double>
    <sys:Double x:Key="MultilineInputHeight">80</sys:Double>
    <sys:Double x:Key="MultilineInputHeightSmall">60</sys:Double>

    <!-- 固定マージン (リファクタリング用) -->
    <Thickness x:Key="FormFooterMargin">0,12,0,0</Thickness>
    <Thickness x:Key="ButtonLeftMargin">8,0,0,0</Thickness>

    <!-- フォーム項目間の標準余白 -->
    <Thickness x:Key="FormItemMargin">0,0,0,16</Thickness>
    <Thickness x:Key="FormLabelMargin">0,0,0,4</Thickness>
    <Thickness x:Key="FormSectionMargin">0,0,0,24</Thickness>

    <!-- 項目間の余白 -->
    <Thickness x:Key="IconRightMargin">0,0,8,0</Thickness>
    <Thickness x:Key="ContentRightMargin">0,0,12,0</Thickness>
    <Thickness x:Key="ContentBottomMargin">0,0,0,20</Thickness>
    <Thickness x:Key="ContentLabelMargin">0,0,0,8</Thickness>

    <!-- カード用定数 -->
    <Thickness x:Key="TaskCardPadding">20,12</Thickness>
    <Thickness x:Key="TaskCardInfoMargin">0,4,0,0</Thickness>
    <Thickness x:Key="TaskCardSelectedMargin">12,8</Thickness>
    <Thickness x:Key="TaskCardSelectedPadding">16</Thickness>

    <!-- ====================================================================== -->
    <!-- Common Effects -->
    <!-- ====================================================================== -->
    <DropShadowEffect x:Key="AllTasksShadowEffect"
                      BlurRadius="10"
                      Direction="-90"
                      Opacity="0.05"
                      ShadowDepth="2" />

    <!-- ====================================================================== -->
    <!-- View Layouts (Common across Views) -->
    <!-- ====================================================================== -->

    <!-- 各ビューの最上部ヘッダー領域（Grid）のスタイル -->
    <Style x:Key="ViewHeaderGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="24,16,24,8" />
    </Style>

    <!-- 各ビューのメインコンテンツ領域（StackPanel）のスタイル -->
    <Style x:Key="ViewMainContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="24,8,24,24" />
    </Style>

    <!-- 各ビューのメインコンテンツ領域（ItemsControl用）のスタイル -->
    <Style x:Key="ViewMainItemsContainerStyle" TargetType="ItemsControl">
        <Setter Property="Margin" Value="24,8,24,24" />
    </Style>

</ResourceDictionary>
