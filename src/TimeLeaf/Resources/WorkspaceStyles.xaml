<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:li="clr-namespace:LeafKit.UI.Behaviors.Interactions;assembly=LeafKit.UI"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
                    xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
                    mc:Ignorable="d">

    <!-- ====================================================================== -->
    <!-- Project Workspace & Dashboard -->
    <!-- ====================================================================== -->

    <!-- プロジェクト名のタイトルスタイル (ViewHeaderTitleStyle をベースに) -->
    <Style x:Key="ProjectWorkspaceTitleStyle"
           BasedOn="{StaticResource ViewHeaderTitleStyle}"
           TargetType="TextBlock" />

    <!-- プロジェクト状態（進行中など）のテキストスタイル -->
    <Style x:Key="ProjectStatusTextStyle" TargetType="Run">
        <Setter Property="BaselineAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ユーザーアバター（アイコン）の基本スタイル -->
    <Style x:Key="UserAvatarIconStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- ユーザーアバター内のイニシャルテキストスタイル -->
    <Style x:Key="UserAvatarInitialStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ダッシュボード：セクション見出しのスタイル -->
    <Style x:Key="DashboardSectionHeaderStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ダッシュボード：カードの基本スタイル (OrganicCardStyle + Padding) -->
    <Style x:Key="DashboardCardStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ダッシュボード：プロジェクト説明テキストのスタイル -->
    <Style x:Key="DashboardDescriptionTextStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ダッシュボード：統計情報カードのスタイル (DashboardCardStyle + Margin) -->
    <Style x:Key="DashboardStatsCardStyle"
           BasedOn="{StaticResource DashboardCardStyle}"
           TargetType="Border">
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- ダッシュボード：マイルストーン追加ボタンのスタイル -->
    <Style x:Key="DashboardAddMilestoneButtonStyle"
           BasedOn="{StaticResource IconButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Task Board & Detail Panel -->
    <!-- ====================================================================== -->

    <!-- タスクボード：グループタイトルスタイル -->
    <Style x:Key="TaskGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- タスクボード：コンテナの背景スタイル -->
    <Style x:Key="WorkspaceScrollContainerStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Task Panel / Quick Panel -->
    <!-- ====================================================================== -->

    <!-- タスクパネル：ヘッダー境界のスタイル -->
    <Style x:Key="TaskPanelHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,16,16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- タスクパネル：タイトルのスタイル -->
    <Style x:Key="TaskPanelTitleStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- タスク詳細：タイトルのスタイル (TaskDetailView用) -->
    <Style x:Key="TaskDetailTitleStyle" TargetType="c:EditableLabel">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- タスクパネル：閉じるボタンのスタイル -->
    <Style x:Key="TaskPanelCloseButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- タスクパネル：セクション見出しのスタイル -->
    <Style x:Key="TaskPanelSectionHeaderStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- タスクパネル：プロパティ見出し（メタ）のスタイル -->
    <Style x:Key="TaskPanelMetaLabelStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <!-- タスクパネル：値表示のスタイル -->
    <Style x:Key="TaskPanelValueStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- タスクパネル：フッターエリアのスタイル -->
    <Style x:Key="TaskPanelFooterStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- タスクパネル：フッターヒントテキストのスタイル -->
    <Style x:Key="TaskPanelFooterHintStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Task Detail Components -->
    <!-- ====================================================================== -->

    <!-- タスク詳細：サイドバープロパティ欄のスタイル -->
    <Style x:Key="TaskDetailSidebarStyle" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Comment Components -->
    <!-- ====================================================================== -->

    <!-- 小型ユーザーアイコン（担当者）のスタイル -->
    <Style x:Key="SmallUserAvatarIconStyle"
           BasedOn="{StaticResource UserAvatarIconStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- タスクパネル：コメントアバターのスタイル -->
    <Style x:Key="TaskCommentAvatarStyle"
           BasedOn="{StaticResource SmallUserAvatarIconStyle}"
           TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- タスクパネル：コメント投稿者名のスタイル -->
    <Style x:Key="TaskCommentAuthorStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- タスクパネル：コメント内容の境界スタイル -->
    <Style x:Key="TaskCommentContentStyle" TargetType="Border">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="0,8,8,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- コメント入力エリア：外枠スタイル -->
    <Style x:Key="TaskCommentInputAreaStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,8,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- コメント入力エリア：テキストボックススタイル -->
    <Style x:Key="TaskCommentTextBoxStyle"
           BasedOn="{StaticResource OrganicTextBoxStyle}"
           TargetType="TextBox">
        <Setter Property="Height" Value="40" />
    </Style>

    <!-- コメント入力エリア：送信ボタンスタイル -->
    <Style x:Key="TaskCommentButtonStyle"
           BasedOn="{StaticResource PrimaryButtonStyle}"
           TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Editable Controls Overrides -->
    <!-- ====================================================================== -->

    <!-- EditableTextBlock の外観（カード風）デザインの上書き -->
    <Style x:Key="EditableTextBlockCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- EditableTextBlock のヘッダーテキストデザインの上書き -->
    <Style x:Key="EditableTextBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- EditableTextBlock の内容テキストデザインの上書き -->
    <Style x:Key="EditableTextBlockContentStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- EditableTextBlock の編集ボタンの上書き -->
    <Style x:Key="EditableTextBlockEditButtonStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ====================================================================== -->
    <!-- ProjectTasksView Specific Styles (Extracted for Workspace-wide use) -->
    <!-- ====================================================================== -->
    <Style x:Key="TaskContainerCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect" Value="{DynamicResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="TaskContainerHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="TaskSubTaskListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="TaskSubTaskItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=wv:ProjectTasksView}}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu x:Name="TaskContextMenu"
                             Padding="4"
                             Background="{DynamicResource SurfaceBaseBrush}"
                             BorderBrush="{DynamicResource OutlineBaseBrush}"
                             BorderThickness="1">
                    <ContextMenu.Resources>
                        <!-- MenuItem の共通スタイル：ホバー時のはみ出し修正と角丸の適用 -->
                        <Style TargetType="MenuItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                                    <ColumnDefinition Width="13" />
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter x:Name="Icon"
                                                                  Margin="8,0"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Icon"
                                                                  TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <ContentPresenter Grid.Column="1"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock x:Name="Arrow"
                                                           Grid.Column="3"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="›"
                                                           Visibility="Collapsed" />

                                                <!-- サブメニュー用のポップアップ -->
                                                <Popup x:Name="SubMenuPopup"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Placement="Right"
                                                       VerticalOffset="-4">
                                                    <Border Background="{DynamicResource SurfaceBaseBrush}"
                                                            BorderBrush="{DynamicResource OutlineBaseBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              Opacity="0.1"
                                                                              ShadowDepth="1" />
                                                        </Border.Effect>
                                                        <ScrollViewer Margin="2" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                                            <ItemsPresenter Grid.IsSharedSizeScope="True" RenderOptions.ClearTypeHint="Enabled" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="True">
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <ContextMenu.Template>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8"
                                                      Opacity="0.1"
                                                      ShadowDepth="1" />
                                </Border.Effect>
                                <ItemsPresenter Margin="{TemplateBinding Padding}" Grid.IsSharedSizeScope="True" />
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>

                    <MenuItem Header="コンテナへ移動" ItemsSource="{Binding PlacementTarget.Tag.AvailableContainers, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <TextBlock Text="📂" />
                        </MenuItem.Icon>
                        <MenuItem.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding PlacementTarget.Tag.MoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource MoveTaskArgsConverter}">
                                            <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                            <Binding Path="Id" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator Margin="4,2" />
                    <MenuItem Command="{Binding PlacementTarget.Tag.MoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="未分類へ移動">
                        <MenuItem.Icon>
                            <TextBlock Text="🍃" />
                        </MenuItem.Icon>
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{StaticResource MoveTaskArgsConverter}">
                                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                <Binding Source="{x:Null}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <Grid.InputBindings>
                            <MouseBinding Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"
                                          MouseAction="LeftDoubleClick" />
                        </Grid.InputBindings>

                        <Border x:Name="TaskBorder"
                                Padding="20,12"
                                BorderBrush="{DynamicResource OutlineBaseBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock x:Name="TaskNameText"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding Name}" />
                                <StackPanel x:Name="InfoPanel"
                                            Margin="0,4,0,0"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <TextBlock Style="{DynamicResource MetaBaseStyle}">
                                        <Run Text="担当: " />
                                        <Run Text="{Binding AssigneeName}" />
                                        <Run Text=" | 期限: " />
                                        <Run Text="{Binding Deadline, StringFormat=MM/dd}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootGrid" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TaskBorder" Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
                            <Setter TargetName="TaskBorder" Property="Margin" Value="12,8" />
                            <Setter TargetName="TaskBorder" Property="Padding" Value="16" />
                            <Setter TargetName="TaskBorder" Property="CornerRadius" Value="8" />
                            <Setter TargetName="TaskBorder" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="TaskBorder" Property="BorderThickness" Value="1" />
                            <Setter TargetName="TaskNameText" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="TaskNameText" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="InfoPanel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RootGrid" Property="Background" Value="Transparent" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Opacity="0.1"
                                                      ShadowDepth="2"
                                                      Color="{Binding Source={StaticResource BrandPrimaryColor}}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AddTaskButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                        <TextBlock x:Name="AddIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                   RenderTransformOrigin="0.5,0.5"
                                   Text="＋" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                            <Setter TargetName="AddIcon" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AddGroupButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,10,0,20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Root"
                                   Fill="Transparent"
                                   RadiusX="12"
                                   RadiusY="12"
                                   SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource OutlineBaseBrush}"
                                   StrokeDashArray="4 2"
                                   StrokeThickness="2" />
                        <TextBlock x:Name="AddText"
                                   Margin="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="+ 新規グループを作成" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Stroke" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="Root" Property="Fill" Value="{DynamicResource StateHoverBrush}" />
                            <Setter TargetName="AddText" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- Reorder View Components -->
    <!-- ====================================================================== -->

    <!-- 並び替えリストの項目スタイル（カード風） -->
    <Style x:Key="ReorderItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="OuterBorder"
                            Padding="8,6"
                            Background="{DynamicResource SurfaceLayer1Brush}"
                            BorderBrush="{DynamicResource OutlineBaseBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SidebarSelectedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 並び替えリスト全体のスタイル -->
    <Style x:Key="ReorderListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ReorderItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- 並び替え用ゴーストボタンスタイル -->
    <Style x:Key="ReorderGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel x:Name="Root"
                                Background="Transparent"
                                Orientation="Horizontal">
                        <Path x:Name="Icon"
                              Width="12"
                              Height="12"
                              VerticalAlignment="Center"
                              Data="{StaticResource ListIconGeometry}"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              Stretch="Uniform" />
                        <TextBlock x:Name="Text"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{TemplateBinding Content}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="1.0" />
                            <Setter Property="Opacity" Value="1.0" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
