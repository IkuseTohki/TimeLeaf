<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:li="clr-namespace:LeafKit.UI.Behaviors.Interactions;assembly=LeafKit.UI"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:wv="clr-namespace:TimeLeaf.Views.Workspace"
                    xmlns:wvm="clr-namespace:TimeLeaf.ViewModels.Workspace"
                    mc:Ignorable="d">

    <!-- ====================================================================== -->
    <!-- Project Workspace & Dashboard -->
    <!-- ====================================================================== -->

    <!-- プロジェクト名のタイトルスタイル (ViewHeaderTitleStyle をベースに) -->
    <Style x:Key="ProjectWorkspaceTitleStyle"
           BasedOn="{StaticResource ViewHeaderTitleStyle}"
           TargetType="TextBlock" />

    <!-- プロジェクト状態（進行中など）のテキストスタイル -->
    <Style x:Key="ProjectStatusTextStyle" TargetType="Run">
        <Setter Property="BaselineAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ユーザーアバター（アイコン）の基本スタイル -->
    <Style x:Key="UserAvatarIconStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- ユーザーアバター内のイニシャルテキストスタイル -->
    <Style x:Key="UserAvatarInitialStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForegroundBrush}" />
    </Style>

    <!-- ダッシュボード：セクション見出しのスタイル -->
    <Style x:Key="DashboardSectionHeaderStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ダッシュボード：プロジェクト説明テキストのスタイル -->
    <Style x:Key="DashboardDescriptionTextStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ダッシュボード：マイルストーン追加ボタンのスタイル -->
    <Style x:Key="DashboardAddMilestoneButtonStyle"
           BasedOn="{StaticResource IconButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="DashboardCardStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Task Board & Detail Panel -->
    <!-- ====================================================================== -->

    <!-- タスクボード：グループタイトルスタイル -->
    <Style x:Key="TaskGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- タスクボード：コンテナの背景スタイル -->
    <Style x:Key="WorkspaceScrollContainerStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Task Panel / Quick Panel -->
    <!-- ====================================================================== -->

    <!-- タスクパネル：ヘッダー境界のスタイル -->
    <Style x:Key="TaskPanelHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,16,16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- タスクパネル：タイトルのスタイル -->
    <Style x:Key="TaskPanelTitleStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- タスク詳細：タイトルのスタイル (TaskDetailView用) -->
    <Style x:Key="TaskDetailTitleStyle" TargetType="c:EditableLabel">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- タスクパネル：閉じるボタンのスタイル -->
    <Style x:Key="TaskPanelCloseButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- タスクパネル：セクション見出しのスタイル -->
    <Style x:Key="TaskPanelSectionHeaderStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- タスクパネル：プロパティ見出し（メタ）のスタイル -->
    <Style x:Key="TaskPanelMetaLabelStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <!-- タスクパネル：値表示のスタイル -->
    <Style x:Key="TaskPanelValueStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- タスクパネル：フッターエリアのスタイル -->
    <Style x:Key="TaskPanelFooterStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- タスクパネル：フッターヒントテキストのスタイル -->
    <Style x:Key="TaskPanelFooterHintStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Task Detail Components -->
    <!-- ====================================================================== -->

    <!-- タスク詳細：サイドバープロパティ欄のスタイル -->
    <Style x:Key="TaskDetailSidebarStyle" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Comment Components -->
    <!-- ====================================================================== -->

    <!-- 小型ユーザーアイコン（担当者）のスタイル -->
    <Style x:Key="SmallUserAvatarIconStyle"
           BasedOn="{StaticResource UserAvatarIconStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- タスクパネル：コメントアバターのスタイル -->
    <Style x:Key="TaskCommentAvatarStyle"
           BasedOn="{StaticResource SmallUserAvatarIconStyle}"
           TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- タスクパネル：コメント投稿者名のスタイル -->
    <Style x:Key="TaskCommentAuthorStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- タスクパネル：コメント内容の境界スタイル -->
    <Style x:Key="TaskCommentContentStyle" TargetType="Border">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="0,8,8,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- コメント入力エリア：外枠スタイル -->
    <Style x:Key="TaskCommentInputAreaStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,8,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- コメント入力エリア：テキストボックススタイル -->
    <Style x:Key="TaskCommentTextBoxStyle"
           BasedOn="{StaticResource OrganicTextBoxStyle}"
           TargetType="TextBox">
        <Setter Property="Height" Value="40" />
    </Style>

    <!-- コメント入力エリア：送信ボタンスタイル -->
    <Style x:Key="TaskCommentButtonStyle"
           BasedOn="{StaticResource PrimaryButtonStyle}"
           TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Editable Controls Overrides -->
    <!-- ====================================================================== -->

    <!-- EditableTextBlock の外観（カード風）デザインの上書き -->
    <Style x:Key="EditableTextBlockCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    </Style>

    <!-- EditableTextBlock のヘッダーテキストデザインの上書き -->
    <Style x:Key="EditableTextBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- EditableTextBlock の内容テキストデザインの上書き -->
    <Style x:Key="EditableTextBlockContentStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- EditableTextBlock の編集ボタンの上書き -->
    <Style x:Key="EditableTextBlockEditButtonStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ====================================================================== -->
    <!-- ProjectTasksView Specific Styles (Extracted for Workspace-wide use) -->
    <!-- ====================================================================== -->

    <Style x:Key="TaskContainerCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Effect" Value="{DynamicResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="TaskContainerHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="TaskSubTaskListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="TaskSubTaskItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <Style x:Key="AddTaskButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                        <TextBlock x:Name="AddIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                   RenderTransformOrigin="0.5,0.5"
                                   Text="＋" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                            <Setter TargetName="AddIcon" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AddGroupButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,10,0,20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Root"
                                   Fill="Transparent"
                                   RadiusX="12"
                                   RadiusY="12"
                                   SnapsToDevicePixels="True"
                                   Stroke="{DynamicResource OutlineBaseBrush}"
                                   StrokeDashArray="4 2"
                                   StrokeThickness="2" />
                        <TextBlock x:Name="AddText"
                                   Margin="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="+ 新規グループを作成" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Stroke" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="Root" Property="Fill" Value="{DynamicResource StateHoverBrush}" />
                            <Setter TargetName="AddText" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- Reorder View Components -->
    <!-- ====================================================================== -->

    <!-- 並び替えリストの項目スタイル（カード風） -->
    <Style x:Key="ReorderItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="OuterBorder"
                            Padding="8,6"
                            Background="{DynamicResource SurfaceLayer1Brush}"
                            BorderBrush="{DynamicResource OutlineBaseBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SidebarSelectedBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 並び替えリスト全体のスタイル -->
    <Style x:Key="ReorderListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ReorderItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- 並び替え用ゴーストボタンスタイル -->
    <Style x:Key="ReorderGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel x:Name="Root"
                                Background="Transparent"
                                Orientation="Horizontal">
                        <Path x:Name="Icon"
                              Width="12"
                              Height="12"
                              VerticalAlignment="Center"
                              Data="{StaticResource ListIconGeometry}"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              Stretch="Uniform" />
                        <TextBlock x:Name="Text"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{TemplateBinding Content}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="1.0" />
                            <Setter Property="Opacity" Value="1.0" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- All Tasks View Components -->
    <!-- ====================================================================== -->

    <Style x:Key="AllTasksTimelineGroupIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ContainerCornerRadius}" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <DropShadowEffect x:Key="AllTasksShadowEffect"
                      BlurRadius="10"
                      Direction="-90"
                      Opacity="0.05"
                      ShadowDepth="2" />

    <Style x:Key="AllTasksTimelineVerticalLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="2" />
        <Setter Property="Margin" Value="23,20,0,-20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.1" />
    </Style>

    <Style x:Key="AllTasksTimelineMarkerStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="18,14,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style x:Key="AllTasksTimelineItemGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="24,0,0,20" />
    </Style>

    <Style x:Key="AllTasksTimelineCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="32,0,0,0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="AllTasksTimelineProjectLabelBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="AllTasksTimelineTimeTextStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style x:Key="AllTasksProjectCardStyle" TargetType="Border">
        <Setter Property="Width" Value="340" />
        <Setter Property="Margin" Value="0,0,24,24" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{DynamicResource AllTasksProjectCardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="AllTasksProjectIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AllTasksProjectProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarBlankBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="AllTasksStatusIconStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="AllTasksTaskNameStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="AllTasksProjectLabelStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style x:Key="AllTasksPropertyLabelStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock" />

    <Style x:Key="AllTasksPropertyValueStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="AllTasksFilterItemStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksSearchBoxStyle"
           BasedOn="{StaticResource SearchTextBoxStyle}"
           TargetType="Control">
        <Setter Property="Width" Value="200" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksFilterCheckBoxStyle"
           BasedOn="{StaticResource FormCheckBoxStyle}"
           TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksGridIconStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AllTasksGridTaskNameStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AllTasksGridTaskCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    </Style>

    <Style x:Key="AllTasksTaskOpenButtonStyle"
           BasedOn="{StaticResource RoundButtonStyle}"
           TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightSmall}" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="AllTasksTaskItemMainColumnStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="20,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksTaskItemSubColumnStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                             Opacity="0.1"
                             Color="{DynamicResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                             Opacity="0.05"
                             Color="{DynamicResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource BrandPrimaryColor}" />
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AllTasksHeaderActionContainerStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

</ResourceDictionary>
