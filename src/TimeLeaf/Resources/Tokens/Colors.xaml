<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================== -->
    <!-- Base Palette (Theme-agnostic colors) -->
    <!-- ====================================================================== -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Neutral / Grays -->
    <Color x:Key="Slate50">#F8FAFC</Color>
    <Color x:Key="Slate100">#F1F5F9</Color>
    <Color x:Key="Slate200">#E2E8F0</Color>
    <Color x:Key="Slate300">#CBD5E1</Color>
    <Color x:Key="Slate400">#94A3B8</Color>
    <Color x:Key="Slate500">#64748B</Color>
    <Color x:Key="Slate600">#475569</Color>
    <Color x:Key="Slate700">#334155</Color>
    <Color x:Key="Slate800">#1E293B</Color>
    <Color x:Key="Slate900">#0F172A</Color>

    <!-- Brand / Primary (Greenish) -->
    <Color x:Key="Green50">#F0FDF4</Color>
    <Color x:Key="Green100">#DCFCE7</Color>
    <Color x:Key="Green200">#BBF7D0</Color>
    <Color x:Key="Green300">#86EFAC</Color>
    <Color x:Key="Green400">#4ADE80</Color>
    <Color x:Key="Green500">#22C55E</Color>
    <Color x:Key="Green600">#16A34A</Color>
    <Color x:Key="Green700">#15803D</Color>
    <Color x:Key="Green800">#166534</Color>
    <Color x:Key="Green900">#14532D</Color>

    <!-- Accent / Warning / Error -->
    <Color x:Key="Red500">#EF4444</Color>
    <Color x:Key="Red600">#DC2626</Color>
    <Color x:Key="Orange500">#F97316</Color>
    <Color x:Key="Orange600">#EA580C</Color>
    <Color x:Key="Amber500">#F59E0B</Color>

    <!-- Legacy / Existing Specific Colors (Temporary Mappings) -->
    <Color x:Key="LegacyLightBackground">#F4F7F6</Color>
    <Color x:Key="LegacyErrorRed">#E81123</Color>
    <Color x:Key="LegacyWarningOrange">#D83B01</Color>

</ResourceDictionary>
