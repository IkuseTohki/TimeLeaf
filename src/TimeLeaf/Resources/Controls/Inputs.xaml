<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================================================== -->
    <!-- TextBox Styles -->
    <!-- ====================================================================== -->

    <!-- オーガニックな入力欄（TextBox）スタイル -->
    <Style x:Key="TextBoxOrganicStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource InputHeightMedium}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- 検索用入力欄（ClearableTextBox 等）のスタイル -->
    <Style x:Key="ControlSearchTextBoxStyle" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- エラーログ表示用入力欄 -->
    <Style x:Key="TextBoxErrorLogStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- コメント入力エリア：テキストボックススタイル -->
    <Style x:Key="TextBoxWorkspaceTaskCommentStyle"
           BasedOn="{StaticResource TextBoxOrganicStyle}"
           TargetType="TextBox">
        <Setter Property="Height" Value="40" />
    </Style>

    <!-- ====================================================================== -->
    <!-- CheckBox Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="CheckBoxAllTasksFilterStyle"
           BasedOn="{StaticResource BaseCheckBoxStyle}"
           TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================== -->
    <!-- ComboBox Styles -->
    <!-- ====================================================================== -->

    <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- DatePicker Styles -->
    <!-- ====================================================================== -->

    <!-- LeafDatePicker の上書き -->
    <Style TargetType="{x:Type c:LeafDatePicker}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

</ResourceDictionary>
