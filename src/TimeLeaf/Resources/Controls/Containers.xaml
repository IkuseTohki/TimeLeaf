<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================================================== -->
    <!-- Border & Card Styles -->
    <!-- ====================================================================== -->

    <!-- オーガニックなカード（Border）スタイル -->
    <Style x:Key="OrganicCardStyle"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  Direction="-90"
                                  Opacity="{DynamicResource OpacityMuted}"
                                  ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SurfaceCardStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="SurfaceCardTinyStyle"
           BasedOn="{StaticResource SurfaceCardStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource CardWidthTiny}" />
    </Style>

    <Style x:Key="SurfaceCardSmallStyle"
           BasedOn="{StaticResource SurfaceCardStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource CardWidthSmall}" />
    </Style>

    <Style x:Key="SurfaceCardMediumStyle"
           BasedOn="{StaticResource SurfaceCardStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource CardWidthMedium}" />
    </Style>

    <Style x:Key="SurfaceCardLargeStyle"
           BasedOn="{StaticResource SurfaceCardStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource CardWidthLarge}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Grid Styles (Layout Containers) -->
    <!-- ====================================================================== -->

    <!-- 各ビューの最上部ヘッダー領域（Grid）のスタイル -->
    <Style x:Key="GridViewHeaderStyle"
           TargetType="Grid">
        <Setter Property="Margin" Value="24,16,24,8" />
    </Style>

    <!-- ====================================================================== -->
    <!-- ListBox Styles -->
    <!-- ====================================================================== -->

    <!-- 設定画面等のリストボックススタイル -->
    <Style x:Key="ListBoxSettingsStyle"
           TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusCard}">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- タスクボード：サブタスクリスト全体のスタイル -->
    <Style x:Key="ListBoxWorkspaceTaskSubStyle"
           TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- タスクボード：サブタスク項目（ListBoxItem）のスタイル -->
    <Style x:Key="ListBoxItemWorkspaceTaskSubStyle"
           TargetType="ListBoxItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <!-- 並び替えリスト全体のスタイル -->
    <Style x:Key="ListBoxReorderStyle"
           TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemReorderStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- 並び替えリストの項目スタイル（フラット・ホバーアクション用） -->
    <Style x:Key="ListBoxItemReorderStyle"
           TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="OuterBorder"
                            Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="{DynamicResource RadiusControl}">
                        <ContentPresenter x:Name="Content"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource EmphasisLowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- DataGrid Styles -->
    <!-- ====================================================================== -->

    <!-- DataGrid ヘッダースタイル -->
    <Style x:Key="DataGridColumnHeaderTimeLeafStyle"
           TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
    </Style>

    <!-- DataGrid セルスタイル -->
    <Style x:Key="DataGridCellTimeLeafStyle"
           TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid 本体スタイル -->
    <Style x:Key="DataGridTimeLeafStyle"
           TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderTimeLeafStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellTimeLeafStyle}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
    </Style>

    <!-- DataGrid 行スタイル (AllTasks用) -->
    <Style x:Key="DataGridRowAllTasksStyle"
           TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                             Opacity="{DynamicResource OpacityMuted}"
                             Color="{DynamicResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                             Opacity="{DynamicResource OpacityMuted}"
                             Color="{DynamicResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                             Color="{DynamicResource BrandPrimaryColor}" />
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================== -->
    <!-- Icon Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="TextIconStyle"
           TargetType="TextBlock">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Outline Icon -->
    <Style x:Key="PathBrandIconStyle"
           TargetType="Path">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="PathBrandIconLargeStyle"
           BasedOn="{StaticResource PathBrandIconStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="PathBrandIconSmallStyle"
           BasedOn="{StaticResource PathBrandIconStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="PathSecondaryIconStyle"
           BasedOn="{StaticResource PathBrandIconStyle}"
           TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="PathSecondaryIconLargeStyle"
           BasedOn="{StaticResource PathSecondaryIconStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style x:Key="PathSecondaryIconSmallStyle"
           BasedOn="{StaticResource PathSecondaryIconStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- Fill Icon -->
    <Style x:Key="PathBrandIconFillStyle"
           TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="PathBrandIconFillSmallStyle"
           BasedOn="{StaticResource PathBrandIconFillStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="PathBrandIconFillMiniStyle"
           BasedOn="{StaticResource PathBrandIconFillStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <Style x:Key="PathSecondaryIconFillStyle"
           BasedOn="{StaticResource PathBrandIconFillStyle}"
           TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="PathSecondaryIconFillSmallStyle"
           BasedOn="{StaticResource PathSecondaryIconFillStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="PathSecondaryIconFillMiniStyle"
           BasedOn="{StaticResource PathSecondaryIconFillStyle}"
           TargetType="Path">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Avatar Icon Styles -->
    <!-- ====================================================================== -->

    <!-- ユーザーアバターアイコンの基本スタイル -->
    <Style x:Key="BorderUserAvatarIconStyle"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource AvatarSizeMedium}" />
        <Setter Property="Height" Value="{StaticResource AvatarSizeMedium}" />
    </Style>

    <!-- ユーザーアバターアイコンの小型スタイル -->
    <Style x:Key="BorderUserAvatarIconSmallStyle"
           BasedOn="{StaticResource BorderUserAvatarIconStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource AvatarSizeSmall}" />
        <Setter Property="Height" Value="{StaticResource AvatarSizeSmall}" />
    </Style>

    <!-- ユーザーメニュー内のアバター枠 -->
    <Style x:Key="BorderUserMenuAvatarStyle"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource AvatarSizeSmall}" />
        <Setter Property="Height" Value="{StaticResource AvatarSizeSmall}" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius50}" />
    </Style>

</ResourceDictionary>
