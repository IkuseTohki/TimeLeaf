<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================== -->
    <!-- Base Styles -->
    <!-- ====================================================================== -->

    <!-- 大見出し -->
    <Style x:Key="TextBlockTitleBaseStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 中見出し -->
    <Style x:Key="TextBlockHeaderBaseStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 標準ラベル -->
    <Style x:Key="TextBlockLabelBaseStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 標準テキスト -->
    <Style x:Key="TextBlockTextBaseStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 補足テキスト -->
    <Style x:Key="TextBlockMetaBaseStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- セクション見出し用ラベル -->
    <Style x:Key="LabelSectionHeaderBaseStyle"
           TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="TextBlockViewPlaceholderStyle"
           BasedOn="{StaticResource TextBlockTitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="{StaticResource OpacityMedium}" />
    </Style>

    <Style x:Key="TextBlockFatalErrorHeaderStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ====================================================================== -->
    <!-- View Header Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="TextBlockViewHeaderSubTitleStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
    </Style>

    <Style x:Key="TextBlockBodyStyle"
           BasedOn="{StaticResource TextBlockTextBaseStyle}"
           TargetType="TextBlock" />

    <Style x:Key="TextBlockDashboardHeaderStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMediumLabel}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- List Item Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="TextBlockBaseListEllipsisStyle"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="TextBlockBaseListEllipsisPrimaryStyle"
           BasedOn="{StaticResource TextBlockBaseListEllipsisStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

</ResourceDictionary>
