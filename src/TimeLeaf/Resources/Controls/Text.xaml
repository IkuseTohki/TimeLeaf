<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 大見出し -->
    <Style x:Key="TextBlockTitleBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 中見出し -->
    <Style x:Key="TextBlockHeaderBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 標準ラベル -->
    <Style x:Key="TextBlockLabelBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 標準テキスト -->
    <Style x:Key="TextBlockTextBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 補足テキスト -->
    <Style x:Key="TextBlockMetaBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- セクション見出し用ラベル -->
    <Style x:Key="LabelSectionHeaderBaseStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="StatsLabelStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
    </Style>

    <Style x:Key="StatsValueStyle"
           BasedOn="{StaticResource TextBlockTitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    </Style>

    <Style x:Key="TextBlockViewPlaceholderStyle"
           BasedOn="{StaticResource TextBlockTitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style x:Key="TextBlockFatalErrorHeaderStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ====================================================================== -->
    <!-- View Header Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="TextBlockViewHeaderTitleStyle"
           BasedOn="{StaticResource TextBlockTitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="TextBlockViewHeaderSubTitleStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
    </Style>

    <!-- Semantic Aliases for backward compatibility -->
    <Style x:Key="HeaderBaseStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock" />
    <Style x:Key="LabelBaseStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock" />
    <Style x:Key="MetaBaseStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock" />
    <Style x:Key="TitleBaseStyle"
           BasedOn="{StaticResource TextBlockTitleBaseStyle}"
           TargetType="TextBlock" />

</ResourceDictionary>
