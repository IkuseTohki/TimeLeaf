<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Layout.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Controls/Text.xaml" />
        <ResourceDictionary Source="../Controls/Buttons.xaml" />
        <ResourceDictionary Source="../Controls/Inputs.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- GroupBox Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="GroupBoxSettingsStyle" TargetType="GroupBox">
        <Setter Property="Margin" Value="{StaticResource FormSectionMargin}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
    </Style>

    <Style x:Key="GroupBoxDangerStyle"
           BasedOn="{StaticResource GroupBoxSettingsStyle}"
           TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- TextBlock Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="TextBlockFormTitleStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="TextBlockFormLabelStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
    </Style>

    <Style x:Key="TextBlockSettingsAnnotationStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Workspace Specific Headers -->
    <Style x:Key="TextBlockWorkspaceDashboardSectionHeaderStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="TextBlockWorkspaceTaskPanelSectionHeaderStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
    </Style>

    <Style x:Key="TextBlockWorkspaceTaskPanelMetaLabelStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Label Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="LabelFormSectionHeaderStyle"
           BasedOn="{StaticResource LabelSectionHeaderBaseStyle}"
           TargetType="Label">
        <Setter Property="Margin" Value="{StaticResource FormLabelMargin}" />
    </Style>

    <Style x:Key="LabelFormFirstSectionHeaderStyle"
           BasedOn="{StaticResource LabelSectionHeaderBaseStyle}"
           TargetType="Label">
        <Setter Property="Margin" Value="{StaticResource FormLabelMargin}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Border Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="BorderColorPreviewStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMax}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Container Styles (StackPanel, Grid) -->
    <!-- ====================================================================== -->

    <Style x:Key="StackPanelSettingsContainerStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="500" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="GridDialogRootStyle" TargetType="Grid">
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style x:Key="StackPanelDialogRootStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style x:Key="StackPanelDialogFooterStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource FormFooterMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- Setup Specific -->
    <Style x:Key="StackPanelSetupContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="20" />
    </Style>

    <Style x:Key="GridSetupInputAreaStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="StackPanelSetupFooterStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Button Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="ButtonDialogActionStyle"
           BasedOn="{StaticResource ButtonPrimaryStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="90" />
    </Style>

    <Style x:Key="ButtonDialogCancelStyle"
           BasedOn="{StaticResource ButtonSecondaryStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="90" />
        <Setter Property="Margin" Value="{StaticResource ButtonLeftMargin}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- ComboBox Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="ComboBoxFormCompactStyle"
           BasedOn="{StaticResource BaseComboBoxStyle}"
           TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource FormItemMargin}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Window Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="WindowSetupStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="ResizeMode" Value="NoResize" />
    </Style>

    <!-- Setup View Specific -->
    <Style x:Key="TextBlockSetupHeaderStyle"
           BasedOn="{StaticResource TextBlockTitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="TextBlockSetupDescriptionStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBlockSetupSubDescriptionStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBlockSetupErrorStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

</ResourceDictionary>
