<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Layout.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Controls/Text.xaml" />
        <ResourceDictionary Source="../Controls/Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- Border Styles -->
    <!-- ====================================================================== -->

    <!-- グローバル・サイドバー：メイン境界スタイル -->
    <Style x:Key="BorderSidebarGlobalStyle"
           BasedOn="{StaticResource SidebarBorderStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="0,24,24,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}"
                         Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="76"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="200"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- タスク詳細：サイドバープロパティ欄のスタイル -->
    <Style x:Key="BorderWorkspaceTaskDetailSidebarStyle"
           TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- ====================================================================== -->
    <!-- StackPanel Styles -->
    <!-- ====================================================================== -->

    <!-- サイドバー：ロゴ・タイトルエリアのコンテナ -->
    <Style x:Key="StackPanelSidebarLogoStyle"
           TargetType="StackPanel">
        <Setter Property="Margin" Value="16,16,16,24" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Path Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="PathSidebarLogoStyle"
           TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Fill" Value="{DynamicResource SidebarTextBrush}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- TextBlock Styles -->
    <!-- ====================================================================== -->

    <Style x:Key="TextBlockSidebarLogoStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>

    <Style x:Key="TextBlockSidebarMenuHeaderStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="Opacity" Value="{StaticResource OpacityStrong}" />
    </Style>

    <Style x:Key="TextBlockSidebarEmptyStyle"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="16,8,16,0" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="Opacity" Value="{StaticResource OpacitySubtle}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextBlockSidebarIconStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Button Styles -->
    <!-- ====================================================================== -->

    <!-- サイドバー：標準ナビゲーションボタン -->
    <Style x:Key="ButtonSidebarStyle"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,1,12,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="0,16,16,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SidebarHoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SidebarPressedOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- サイドバー：プロジェクト項目ボタン -->
    <Style x:Key="ButtonSidebarProjectStyle"
           BasedOn="{StaticResource ButtonSidebarStyle}"
           TargetType="Button">
        <Setter Property="Padding" Value="32,6,16,6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Opacity" Value="{StaticResource OpacityStrong}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="{StaticResource OpacityFull}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- サイドバー：追加ボタン (＋) -->
    <Style x:Key="ButtonSidebarAddStyle"
           BasedOn="{StaticResource ButtonIconStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- サイドバー：折りたたみボタン -->
    <Style x:Key="ButtonSidebarCollapseStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,-10,24" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4"
                                              Direction="-90"
                                              Opacity="{StaticResource OpacityMuted}"
                                              ShadowDepth="1" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

