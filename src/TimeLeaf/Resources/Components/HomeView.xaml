<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Layout.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Controls/Text.xaml" />
        <ResourceDictionary Source="../Controls/Containers.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="UniformGridHomeStatsStyle" TargetType="UniformGrid">
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="TextBlockHomeStatsLabelStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
    </Style>

    <Style x:Key="TextBlockHomeStatsValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="StackPanelHomeColumnStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

    <Style x:Key="GridHomeDeadlineItemStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="TextBlockHomeProjectCardTitleStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubHeader}" />
    </Style>

    <Style x:Key="TextBlockHomeProjectCardSubTitleStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    </Style>

    <Style x:Key="ProgressBarHomeProjectStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarBlankBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBlockHomeMilestoneDateStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock" />

    <Style x:Key="TextBlockHomeMilestoneProjectNameStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightEmphasis}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style x:Key="EllipseHomeMilestoneTimelineDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="RectangleHomeMilestoneTimelineLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.2" />
    </Style>

    <Style x:Key="TextBlockHomeMilestoneLabelStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Semantic Aliases for backward compatibility -->
    <Style x:Key="HomeStatsGridStyle"
           BasedOn="{StaticResource UniformGridHomeStatsStyle}"
           TargetType="UniformGrid" />
    <Style x:Key="HomeStatsLabelStyle"
           BasedOn="{StaticResource TextBlockHomeStatsLabelStyle}"
           TargetType="TextBlock" />
    <Style x:Key="HomeStatsValueStyle"
           BasedOn="{StaticResource TextBlockHomeStatsValueStyle}"
           TargetType="TextBlock" />
    <Style x:Key="HomeColumnStyle"
           BasedOn="{StaticResource StackPanelHomeColumnStyle}"
           TargetType="StackPanel" />
    <Style x:Key="HomeDeadlineItemStyle"
           BasedOn="{StaticResource GridHomeDeadlineItemStyle}"
           TargetType="Grid" />
    <Style x:Key="HomeProjectCardTitleStyle"
           BasedOn="{StaticResource TextBlockHomeProjectCardTitleStyle}"
           TargetType="TextBlock" />
    <Style x:Key="HomeProjectCardSubTitleStyle"
           BasedOn="{StaticResource TextBlockHomeProjectCardSubTitleStyle}"
           TargetType="TextBlock" />
    <Style x:Key="HomeProjectProgressBarStyle"
           BasedOn="{StaticResource ProgressBarHomeProjectStyle}"
           TargetType="ProgressBar" />
    <Style x:Key="HomeMilestoneTimelineLineStyle"
           BasedOn="{StaticResource RectangleHomeMilestoneTimelineLineStyle}"
           TargetType="Rectangle" />
    <Style x:Key="HomeMilestoneTimelineDotStyle"
           BasedOn="{StaticResource EllipseHomeMilestoneTimelineDotStyle}"
           TargetType="Ellipse" />
    <Style x:Key="HomeMilestoneDateStyle"
           BasedOn="{StaticResource TextBlockHomeMilestoneDateStyle}"
           TargetType="TextBlock" />
    <Style x:Key="HomeMilestoneLabelStyle"
           BasedOn="{StaticResource TextBlockHomeMilestoneLabelStyle}"
           TargetType="TextBlock" />

</ResourceDictionary>
