<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:TimeLeaf.Models"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Layout.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- Timeline-specific component styles -->
    <!-- Use DynamicResource for all brushes to ensure real-time theme support. -->
    <!-- ====================================================================== -->

    <!-- Root container background for consistent surface rendering -->
    <Style x:Key="GridTimelineRootStyle" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    </Style>

    <!-- Header border separator aligned with theme outline -->
    <Style x:Key="BorderTimelineHeaderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    </Style>

    <!-- Grid Column Style -->
    <Style x:Key="BorderTimelineGridColumnStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource TimelineDayWidth}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource DateToIsNonWorkdayConverter}">
                        <Binding Path="." />
                        <Binding Path="DataContext.WorkdayService" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Item Style -->
    <Style x:Key="BorderTimelineSidebarItemStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource RowTimelineNormalHeight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource Thickness30}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsContainer}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Chart Item Style -->
    <Style x:Key="BorderTimelineChartItemStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource RowTimelineNormalHeight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Timeline Layout Tokens -->
    <!-- ====================================================================== -->

    <GridLength x:Key="TimelineSidebarWidth">240</GridLength>

    <!-- Horizontal padding for the header to align with content while preventing clipping -->
    <Thickness x:Key="TimelineHeaderPadding"
               Bottom="0"
               Left="24"
               Right="24"
               Top="0" />

    <!-- Vertical positions for bars within the 32px row -->
    <sys:Double x:Key="TimelineBarTopPlannedDual">6</sys:Double>
    <sys:Double x:Key="TimelineBarTopActualDual">18</sys:Double>
    <sys:Double x:Key="TimelineBarTopSingle">12</sys:Double>
    <sys:Double x:Key="TimelineBarTopContainer">10</sys:Double>

    <!-- Vertical offset for avatar to center it relative to the row -->
    <sys:Double x:Key="TimelineAvatarVerticalOffset">4</sys:Double>

    <!-- Horizontal offset for avatar (Width: 24) -->
    <sys:Double x:Key="TimelineAvatarHorizontalOffset">-24</sys:Double>

    <!-- Timeline Navigation Styles -->
    <Style x:Key="StackPanelTimelineNavigationContainerStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
    </Style>

    <Style x:Key="RadioButtonTimelineNavigationStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bar Styles: Base definitions for task representation -->
    <Style x:Key="BorderTimelineBarBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Height" Value="{StaticResource Spacing30}" />
    </Style>

    <!-- Visual representation of scheduled task effort, using low opacity to distinguish from actuals -->
    <Style x:Key="BorderTimelinePlanStyle"
           BasedOn="{StaticResource BorderTimelineBarBaseStyle}"
           TargetType="Border">
        <Setter Property="Opacity" Value="{DynamicResource OpacitySubtle}" />
        <Setter Property="Canvas.Top" Value="{StaticResource TimelineBarTopPlannedDual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static models:TimelineViewMode.PlanOnly}">
                <Setter Property="Canvas.Top" Value="{StaticResource TimelineBarTopSingle}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static models:TimelineViewMode.ActualOnly}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Visual representation of actual work done, using full opacity for emphasis -->
    <Style x:Key="BorderTimelineActualStyle"
           BasedOn="{StaticResource BorderTimelineBarBaseStyle}"
           TargetType="Border">
        <Setter Property="Opacity" Value="{DynamicResource OpacityStrong}" />
        <Setter Property="Canvas.Top" Value="{StaticResource TimelineBarTopActualDual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static models:TimelineViewMode.ActualOnly}">
                <Setter Property="Canvas.Top" Value="{StaticResource TimelineBarTopSingle}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.CurrentViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static models:TimelineViewMode.PlanOnly}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Container task styling for summary representation -->
    <Style x:Key="BorderTimelineContainerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Height" Value="{StaticResource Spacing40}" />
        <Setter Property="Canvas.Top" Value="{StaticResource TimelineBarTopContainer}" />
        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="{DynamicResource OpacityStrong}" />
    </Style>

    <!-- Lightning line: Visual feedback for scheduling variance, highlighting risks -->
    <Style x:Key="PathTimelineLightningStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="4,2" />
    </Style>

    <!-- Today line: Visual indicator for current time -->
    <Style x:Key="BorderTimelineTodayLineStyle" TargetType="Border">
        <Setter Property="Width" Value="2" />
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Today label: Text indicator for the today line -->
    <Style x:Key="TextBlockTimelineTodayLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- Avatar representation for task assignment -->
    <Style x:Key="BorderTimelineAvatarStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource AvatarSizeSmall}" />
        <Setter Property="Height" Value="{StaticResource AvatarSizeSmall}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMax}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Canvas.Top" Value="{StaticResource TimelineAvatarVerticalOffset}" />
    </Style>

    <!-- Milestone Row Style -->
    <Style x:Key="BorderTimelineMilestoneRowStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource RowTimelineNormalHeight}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- Milestone Marker Style (Diamond) -->
    <Style x:Key="PathTimelineMilestoneMarkerStyle" TargetType="Path">
        <Setter Property="Data" Value="M 6,0 L 12,6 L 6,12 L 0,6 Z" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextBlockTimelineMilestoneLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMeta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
