<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Layout.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Controls/Text.xaml" />
        <ResourceDictionary Source="../Controls/Buttons.xaml" />
        <ResourceDictionary Source="../Controls/Containers.xaml" />
        <ResourceDictionary Source="../Common/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="UniformGridAllTasksProjectContainerStyle" TargetType="UniformGrid">
        <Setter Property="Columns" Value="2" />
    </Style>

    <Style x:Key="BorderAllTasksTimelineGroupIconStyle" TargetType="Border">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ContainerCornerRadius}" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="RectangleAllTasksTimelineVerticalLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="2" />
        <Setter Property="Margin" Value="23,20,0,-20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="{StaticResource OpacityMuted}" />
    </Style>

    <Style x:Key="EllipseAllTasksTimelineMarkerStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="18,14,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style x:Key="GridAllTasksTimelineItemStyle" TargetType="Grid">
        <Setter Property="Margin" Value="24,0,0,20" />
    </Style>

    <Style x:Key="BorderAllTasksTimelineCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="32,0,0,0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="BorderAllTasksTimelineProjectLabelStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="TextBlockAllTasksTimelineTimeStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Opacity" Value="{StaticResource OpacityMedium}" />
    </Style>

    <Style x:Key="BorderAllTasksProjectCardStyle" TargetType="Border">
        <Setter Property="Width" Value="340" />
        <Setter Property="Margin" Value="0,0,24,24" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{DynamicResource AllTasksProjectCardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="BorderAllTasksProjectIconStyle" TargetType="Border">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ProgressBarAllTasksProjectStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarBlankBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="BorderAllTasksStatusIconStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="TextBlockAllTasksTaskNameStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="TextBlockAllTasksProjectLabelStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="{StaticResource OpacityStrong}" />
    </Style>

    <Style x:Key="TextBlockAllTasksPropertyLabelStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock" />

    <Style x:Key="TextBlockAllTasksPropertyValueStyle"
           BasedOn="{StaticResource TextBlockLabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FrameworkElementAllTasksFilterItemStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ControlAllTasksSearchBoxStyle"
           BasedOn="{StaticResource ControlSearchTextBoxStyle}"
           TargetType="Control">
        <Setter Property="Width" Value="200" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextBlockAllTasksGridIconStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="TextBlockAllTasksGridTaskNameStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BorderAllTasksGridTaskCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    </Style>

    <Style x:Key="ButtonAllTasksTaskOpenStyle"
           BasedOn="{StaticResource ButtonRoundStyle}"
           TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightSmall}" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="FrameworkElementAllTasksTaskItemMainColumnStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="20,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FrameworkElementAllTasksTaskItemSubColumnStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StackPanelAllTasksHeaderActionContainerStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

</ResourceDictionary>
