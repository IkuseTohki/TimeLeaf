<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Tokens/Layout.xaml" />
        <ResourceDictionary Source="../Tokens/Typography.xaml" />
        <ResourceDictionary Source="../Controls/Text.xaml" />
        <ResourceDictionary Source="../Controls/Containers.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ====================================================================== -->
    <!-- Border Styles -->
    <!-- ====================================================================== -->

    <!-- 通知バッジ用のスタイル -->
    <Style x:Key="BorderNotificationBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- 通知項目カード -->
    <Style x:Key="BorderNotificationCardStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- 通知空状態のコンテナ -->
    <Style x:Key="BorderNotificationEmptyStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- ====================================================================== -->
    <!-- TextBlock Styles -->
    <!-- ====================================================================== -->

    <!-- 通知タイトル -->
    <Style x:Key="TextBlockNotificationTitleStyle"
           BasedOn="{StaticResource TextBlockHeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubHeader}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- 通知本文 -->
    <Style x:Key="TextBlockNotificationMessageStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 通知タイムスタンプ -->
    <Style x:Key="TextBlockNotificationTimestampStyle"
           BasedOn="{StaticResource TextBlockMetaBaseStyle}"
           TargetType="TextBlock" />

    <!-- 通知空状態のアイコン -->
    <Style x:Key="TextBlockNotificationEmptyIconStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="36" />
    </Style>

</ResourceDictionary>
