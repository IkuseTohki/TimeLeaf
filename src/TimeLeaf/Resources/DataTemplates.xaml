<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:me="clr-namespace:TimeLeaf.Models.Enums"
                    xmlns:vm="clr-namespace:TimeLeaf.ViewModels">

    <!-- 内部でのリソース解決のため Styles と Converters をマージ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Converters.xaml" />
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ユーザーアバター表示用共通テンプレート -->
    <ControlTemplate x:Key="PersonAvatarTemplate" TargetType="ContentControl">
        <Grid>
            <!-- 背景色（テーマカラー） -->
            <Border x:Name="ColorCircle"
                    Background="{Binding ThemeColor, Converter={StaticResource StringToBrushConverter}, FallbackValue='#72796E'}"
                    CornerRadius="16" />

            <!-- アイコン画像（存在する場合） -->
            <Border ClipToBounds="True" CornerRadius="16">
                <Image x:Name="AvatarImage"
                       Source="{Binding IconPath}"
                       Stretch="UniformToFill"
                       Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
            </Border>

            <!-- イニシャル表示（画像がない場合のフォールバック） -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="{Binding DisplayName[0], FallbackValue='?'}"
                       Visibility="{Binding Visibility, ElementName=AvatarImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============================================================ -->
    <!-- All Tasks View Templates -->
    <!-- ============================================================ -->

    <!-- 1. List View (Table) -->
    <DataTemplate x:Key="AllTasksListTemplate">
        <DataGrid AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding AllTasksView}"
                  RowHeaderWidth="0"
                  RowStyle="{StaticResource AllTasksDataGridRowStyle}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Style="{StaticResource AllTasksFilterCheckBoxStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="Task Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource LabelBaseStyle}"
                                       Text="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Width="150"
                                    Binding="{Binding ProjectName}"
                                    Header="Project" />

                <DataGridTextColumn Width="120"
                                    Binding="{Binding AssigneeName}"
                                    Header="Assignee" />

                <DataGridTemplateColumn Width="100" Header="Due Date">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}"
                                       Style="{StaticResource AllTasksPropertyValueStyle}"
                                       Text="{Binding Deadline, StringFormat={}{0:MMM dd\, yyyy}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100" Header="Priority">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AllTasksFilterItemStyle}">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,8,0"
                                         Fill="{Binding PriorityBrush}" />
                                <TextBlock Style="{StaticResource MetaBaseStyle}" Text="{Binding Priority}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100" Header="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{Binding StatusBrush}"
                                       Style="{StaticResource AllTasksPropertyValueStyle}"
                                       Text="{Binding Status}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <!-- 2. Timeline View -->
    <DataTemplate x:Key="AllTasksTimelineTemplate">
        <ItemsControl ItemsSource="{Binding AllTasksView}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Padding="40,20">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,32,0,16" Orientation="Horizontal">
                                <Border Style="{StaticResource AllTasksTimelineGroupIconBorderStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               Text="📅" />
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrandPrimaryBrush}"
                                               Text="{Binding Name}" />
                                    <TextBlock Opacity="0.6"
                                               Style="{StaticResource MetaBaseStyle}"
                                               Text="Upcoming Milestones" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="24,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Vertical Line -->
                        <Rectangle Style="{StaticResource AllTasksTimelineVerticalLineStyle}" />

                        <!-- Dot -->
                        <Ellipse Style="{StaticResource AllTasksTimelineMarkerStyle}" />

                        <Border Grid.Column="1" Style="{StaticResource AllTasksTimelineCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource AllTasksTimelineTimeTextStyle}" Text="{Binding Deadline, StringFormat={}{0:HH:mm}}" />
                                        <Border Margin="12,0"
                                                Padding="8,1"
                                                Background="{DynamicResource ButtonSecondaryBackgroundBrush}"
                                                CornerRadius="8">
                                            <TextBlock FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding ProjectName}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrandPrimaryBrush}"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Opacity="0.6"
                                               Style="{StaticResource MetaBaseStyle}"
                                               Text="{Binding Description}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource IconButtonStyle}">
                                    <Path Width="12"
                                          Height="12"
                                          Data="{StaticResource ChevronRightIconGeometry}"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- 3. Grid View (Project Cards) -->
    <DataTemplate x:Key="AllTasksGridTemplate">
        <ScrollViewer Padding="32">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AllTasksProjectCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,24">
                                    <Border Style="{StaticResource AllTasksProjectIconBorderStyle}">
                                        <Path Width="24"
                                              Height="24"
                                              Data="{StaticResource TreeSproutLeafGeometry}"
                                              Fill="White"
                                              Stretch="Uniform" />
                                    </Border>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Opacity="0.4"
                                               Style="{StaticResource MetaBaseStyle}"
                                               Text="ACTIVE" />
                                </Grid>

                                <TextBlock FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrandPrimaryBrush}"
                                           Text="{Binding Name}" />
                                <TextBlock Margin="0,4,0,24"
                                           Opacity="0.6"
                                           Style="{StaticResource MetaBaseStyle}"
                                           Text="{Binding Description}" />

                                <!-- Progress -->
                                <StackPanel Margin="0,0,0,24">
                                    <Grid>
                                        <TextBlock FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Text="Growth Phase" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Text="{Binding Progress, StringFormat={}{0}%}" />
                                    </Grid>
                                    <ProgressBar Maximum="100"
                                                 Style="{StaticResource AllTasksProjectProgressBarStyle}"
                                                 Value="{Binding Progress}" />
                                </StackPanel>

                                <!-- Recent Tasks -->
                                <TextBlock Margin="0,0,0,12"
                                           FontSize="10"
                                           FontWeight="ExtraBold"
                                           Opacity="0.4"
                                           Text="HIGH PRIORITY SEEDS" />
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12"
                                                    Background="{DynamicResource SurfaceLayer1Brush}"
                                                    BorderBrush="{Binding PriorityBrush}"
                                                    BorderThickness="4,0,0,0"
                                                    CornerRadius="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource AllTasksGridIconStyle}" Text="{Binding Status, Converter={StaticResource TaskStatusToIconConverter}}" />
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource AllTasksGridTaskNameStyle}"
                                                               Text="{Binding Name}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============================================================ -->
    <!-- Base ProjectTask Template (Legacy Support / Unified Item) -->
    <!-- ============================================================ -->
    <DataTemplate DataType="{x:Type vm:ProjectTaskViewModel}">
        <!-- 1タスク1カードのデザイン (AllTasksViewとProjectTasksViewで共通) -->
        <Border Style="{StaticResource TaskItemBorderStyle}">
            <Border.InputBindings>
                <MouseBinding Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              MouseAction="LeftClick" />
                <MouseBinding Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              MouseAction="LeftDoubleClick" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状態アイコン -->
                <Border Style="{StaticResource AllTasksStatusIconStyle}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Text="{Binding Status, Converter={StaticResource TaskStatusToIconConverter}}" />
                </Border>

                <!-- タスク名とプロジェクト名 -->
                <StackPanel Grid.Column="1" Style="{StaticResource AllTasksTaskItemMainColumnStyle}">
                    <TextBlock Style="{StaticResource AllTasksTaskNameStyle}" Text="{Binding Name}" />

                    <!-- プロジェクトコンテキスト (親 ItemsControl の Tag が 文字列 "True" の場合のみ表示) -->
                    <StackPanel x:Name="ProjectContextPanel"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                   Opacity="0.8"
                                   Text="🌲 " />
                        <TextBlock Style="{StaticResource AllTasksProjectLabelStyle}" Text="{Binding ProjectName}" />
                    </StackPanel>
                </StackPanel>

                <!-- 期限 -->
                <StackPanel Grid.Column="2" Style="{StaticResource AllTasksTaskItemSubColumnStyle}">
                    <TextBlock Style="{StaticResource AllTasksPropertyLabelStyle}" Text="📅 期限" />
                    <TextBlock Foreground="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}"
                               Style="{StaticResource AllTasksPropertyValueStyle}"
                               Text="{Binding Deadline, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue='未設定'}" />
                </StackPanel>

                <!-- 優先度 -->
                <StackPanel Grid.Column="3" Style="{StaticResource AllTasksTaskItemSubColumnStyle}">
                    <TextBlock Style="{StaticResource AllTasksPropertyLabelStyle}" Text="⚡ 優先度" />
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Style="{StaticResource AllTasksPropertyValueStyle}"
                               Text="{Binding Priority}" />
                </StackPanel>

                <!-- 担当者 -->
                <StackPanel Grid.Column="4" Style="{StaticResource AllTasksTaskItemSubColumnStyle}">
                    <TextBlock Style="{StaticResource AllTasksPropertyLabelStyle}" Text="👤 担当" />
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Style="{StaticResource AllTasksPropertyValueStyle}"
                               Text="{Binding AssigneeName, TargetNullValue='未設定'}" />
                </StackPanel>

                <!-- 開くボタン -->
                <Button x:Name="TaskOpenButton"
                        Grid.Column="5"
                        Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="開く"
                        Style="{StaticResource AllTasksTaskOpenButtonStyle}"
                        Visibility="Visible" />
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <!-- 親 ItemsControl の Tag プロパティを見て表示を切り替え -->
            <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter TargetName="ProjectContextPanel" Property="Visibility" Value="Visible" />
                <Setter TargetName="TaskOpenButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
