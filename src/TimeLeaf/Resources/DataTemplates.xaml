<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:me="clr-namespace:TimeLeaf.Models.Enums"
                    xmlns:vm="clr-namespace:TimeLeaf.ViewModels">

    <!-- 内部でのリソース解決のため各リソースをマージ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Converters.xaml" />
        <ResourceDictionary Source="Layout.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
        <ResourceDictionary Source="ControlStyles.xaml" />
        <ResourceDictionary Source="Styles.xaml" />
        <ResourceDictionary Source="WorkspaceStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ユーザーアバター表示用共通テンプレート -->
    <ControlTemplate x:Key="PersonAvatarTemplate" TargetType="ContentControl">
        <Grid>
            <!-- 背景色（テーマカラー） -->
            <Border x:Name="ColorCircle"
                    Background="{Binding ThemeColor, Converter={StaticResource StringToBrushConverter}, FallbackValue='#72796E'}"
                    CornerRadius="16" />

            <!-- アイコン画像（存在する場合） -->
            <Border ClipToBounds="True" CornerRadius="16">
                <Image x:Name="AvatarImage"
                       Source="{Binding IconPath}"
                       Stretch="UniformToFill"
                       Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
            </Border>

            <!-- イニシャル表示（画像がない場合のフォールバック） -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BrandForegroundBrush}"
                       Text="{Binding DisplayName[0], FallbackValue='?'}"
                       Visibility="{Binding Visibility, ElementName=AvatarImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>
    </ControlTemplate>

    <!-- ============================================================ -->
    <!-- All Tasks View Templates -->
    <!-- ============================================================ -->

    <!-- 1. List View (Table) -->
    <DataTemplate x:Key="AllTasksListTemplate">
        <DataGrid AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding AllTasksView}"
                  RowHeaderWidth="0"
                  SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource AllTasksDataGridRowStyle}" TargetType="DataGridRow" />
            </DataGrid.RowStyle>


            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Style="{StaticResource AllTasksFilterCheckBoxStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="Task Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource LabelBaseStyle}"
                                       Text="{Binding Name}">
                                <TextBlock.InputBindings>
                                    <MouseBinding Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  MouseAction="LeftDoubleClick" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Width="150"
                                    Binding="{Binding ProjectName}"
                                    Header="Project" />

                <DataGridTextColumn Width="120"
                                    Binding="{Binding AssigneeName}"
                                    Header="Assignee" />

                <DataGridTemplateColumn Width="100" Header="Due Date">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Deadline, StringFormat={}{0:MMM dd\, yyyy}}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource AllTasksPropertyValueStyle}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}" Value="Overdue">
                                                <Setter Property="Foreground" Value="{DynamicResource DeadlineOverdueBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}" Value="Today">
                                                <Setter Property="Foreground" Value="{DynamicResource DeadlineTodayBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}" Value="Near">
                                                <Setter Property="Foreground" Value="{DynamicResource DeadlineNearBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100" Header="Priority">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource AllTasksFilterItemStyle}">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource PriorityLowBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="{x:Static me:TaskPriority.High}">
                                                    <Setter Property="Fill" Value="{DynamicResource PriorityHighBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="{x:Static me:TaskPriority.Medium}">
                                                    <Setter Property="Fill" Value="{DynamicResource PriorityMediumBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource MetaBaseStyle}" Text="{Binding Priority}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100" Header="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Status}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource AllTasksPropertyValueStyle}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static me:TaskStatus.InProgress}">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusInProgressBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static me:TaskStatus.Completed}">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusCompletedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static me:TaskStatus.InReview}">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusInReviewBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DataTemplate>

    <!-- 2. Timeline View -->
    <DataTemplate x:Key="AllTasksTimelineTemplate">
        <ItemsControl ItemsSource="{Binding AllTasksView}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Padding="{StaticResource ViewOuterMargin}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,32,0,16" Orientation="Horizontal">
                                <Border Style="{StaticResource AllTasksTimelineGroupIconBorderStyle}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource TitleBaseStyle}"
                                               Text="📅" />
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Foreground="{DynamicResource BrandPrimaryBrush}"
                                               Style="{StaticResource HeaderBaseStyle}"
                                               Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource MetaBaseStyle}" Text="Upcoming Milestones" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Style="{StaticResource AllTasksTimelineItemGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Vertical Line -->
                        <Rectangle Style="{StaticResource AllTasksTimelineVerticalLineStyle}" />

                        <!-- Dot -->
                        <Ellipse Style="{StaticResource AllTasksTimelineMarkerStyle}" />

                        <Border Grid.Column="1" Style="{StaticResource AllTasksTimelineCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource AllTasksTimelineTimeTextStyle}" Text="{Binding Deadline, StringFormat={}{0:HH:mm}}" />
                                        <Border Style="{StaticResource AllTasksTimelineProjectLabelBorderStyle}">
                                            <TextBlock FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Style="{StaticResource MetaBaseStyle}"
                                                       Text="{Binding ProjectName}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource BrandPrimaryBrush}"
                                               Style="{StaticResource HeaderBaseStyle}"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MetaBaseStyle}"
                                               Text="{Binding Description}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource IconButtonStyle}">
                                    <Path Data="{StaticResource ChevronRightIconGeometry}" Style="{StaticResource SmallIconPathSecondaryStyle}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- 3. Grid View (Project Cards) -->
    <DataTemplate x:Key="AllTasksGridTemplate">
        <ScrollViewer Padding="{StaticResource ViewOuterMargin}">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AllTasksProjectCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,24">
                                    <Border Style="{StaticResource AllTasksProjectIconBorderStyle}">
                                        <Path Width="24"
                                              Height="24"
                                              Data="{StaticResource TreeSproutLeafGeometry}"
                                              Fill="{DynamicResource BrandForegroundBrush}"
                                              Stretch="Uniform" />
                                    </Border>
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               Style="{StaticResource MetaBaseStyle}"
                                               Text="ACTIVE" />
                                </Grid>

                                <TextBlock Foreground="{DynamicResource BrandPrimaryBrush}"
                                           Style="{StaticResource TitleBaseStyle}"
                                           Text="{Binding Name}" />
                                <TextBlock Margin="0,4,0,24"
                                           Style="{StaticResource MetaBaseStyle}"
                                           Text="{Binding Description}" />

                                <!-- Progress -->
                                <StackPanel Margin="0,0,0,24">
                                    <Grid>
                                        <TextBlock FontWeight="Bold"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Style="{StaticResource MetaBaseStyle}"
                                                   Text="Growth Phase" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                                   Style="{StaticResource MetaBaseStyle}"
                                                   Text="{Binding CompletionPercentage, StringFormat={}{0:0}%}" />
                                    </Grid>
                                    <ProgressBar Maximum="100"
                                                 Style="{StaticResource AllTasksProjectProgressBarStyle}"
                                                 Value="{Binding CompletionPercentage}" />
                                </StackPanel>

                                <!-- Recent Tasks -->
                                <TextBlock Margin="0,0,0,12"
                                           FontSize="10"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="HIGH PRIORITY SEEDS" />
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style BasedOn="{StaticResource AllTasksGridTaskCardStyle}" TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="{x:Static me:TaskPriority.High}">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PriorityHighBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="{x:Static me:TaskPriority.Medium}">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PriorityMediumBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="{x:Static me:TaskPriority.Low}">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PriorityLowBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource AllTasksGridIconStyle}" Text="{Binding Status, Converter={StaticResource TaskStatusToIconConverter}}" />
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource AllTasksGridTaskNameStyle}"
                                                               Text="{Binding Name}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============================================================ -->
    <!-- Subtractive Design Templates -->
    <!-- ============================================================ -->

    <!-- 「引き算のデザイン」用タスクアイテム・テンプレート -->
    <ControlTemplate x:Key="SubtractiveTaskItemTemplate" TargetType="ListBoxItem">
        <Grid x:Name="RootGrid"
              Margin="0"
              Background="Transparent">
            <!-- 選択時のカード外枠（通常は非表示・マージンなし） -->
            <Border x:Name="CardBorder"
                    Margin="0"
                    Padding="{StaticResource TaskCardPadding}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- リスクインジケーター（ドット） -->
                    <Ellipse x:Name="RiskDot"
                             Width="6"
                             Height="6"
                             Margin="0,0,12,0"
                             Fill="{DynamicResource ErrorBrush}"
                             Visibility="Collapsed" />

                    <!-- タスク名 -->
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TaskNameText"
                                   Style="{StaticResource LabelBaseStyle}"
                                   Text="{Binding Name}" />

                        <!-- 詳細情報（選択時のみ表示） -->
                        <StackPanel x:Name="DetailInfo"
                                    Margin="{StaticResource TaskCardInfoMargin}"
                                    Visibility="Collapsed">
                            <TextBlock Style="{StaticResource MetaBaseStyle}">
                                <Run Text="👤 " />
                                <Run Text="{Binding AssigneeName, TargetNullValue='未設定'}" />
                                <Run Text="  📅 " />
                                <Run Text="{Binding Deadline, StringFormat={}{0:MM/dd}, TargetNullValue='--/--'}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- 選択状態：カード化 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="CardBorder" Property="Margin" Value="{StaticResource TaskCardSelectedMargin}" />
                <Setter TargetName="CardBorder" Property="Padding" Value="{StaticResource TaskCardSelectedPadding}" />
                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1" />
                <Setter TargetName="CardBorder" Property="CornerRadius" Value="{DynamicResource ContainerCornerRadius}" />
                <Setter TargetName="DetailInfo" Property="Visibility" Value="Visible" />
                <Setter TargetName="TaskNameText" Property="FontWeight" Value="Bold" />
                <Setter TargetName="TaskNameText" Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                <Setter TargetName="CardBorder" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15"
                                          Direction="-90"
                                          Opacity="0.1"
                                          ShadowDepth="5" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <!-- マウスホバー -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RootGrid" Property="Background" Value="{DynamicResource StateHoverBrush}" />
            </Trigger>
            <!-- リスクがある場合 -->
            <DataTrigger Binding="{Binding HasRisk}" Value="True">
                <Setter TargetName="RiskDot" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
