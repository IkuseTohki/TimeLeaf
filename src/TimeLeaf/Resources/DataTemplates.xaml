<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TimeLeaf.ViewModels">

    <!-- 内部でのリソース解決のため Styles と Converters をマージ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Converters.xaml" />
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ユーザーアバター表示用共通テンプレート -->
    <ControlTemplate x:Key="PersonAvatarTemplate" TargetType="ContentControl">
        <Grid>
            <!-- 背景色（テーマカラー） -->
            <Border x:Name="ColorCircle"
                    Background="{Binding ThemeColor, Converter={StaticResource StringToBrushConverter}, FallbackValue='#72796E'}"
                    CornerRadius="16" />

            <!-- アイコン画像（存在する場合） -->
            <Border ClipToBounds="True" CornerRadius="16">
                <Image x:Name="AvatarImage"
                       Source="{Binding IconPath}"
                       Stretch="UniformToFill"
                       Visibility="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}}" />
            </Border>

            <!-- イニシャル表示（画像がない場合のフォールバック） -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="{Binding DisplayName[0], FallbackValue='?'}"
                       Visibility="{Binding Visibility, ElementName=AvatarImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>
    </ControlTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectTaskViewModel}">
        <!-- 1タスク1カードのデザイン (AllTasksViewとProjectTasksViewで共通) -->
        <Border Style="{StaticResource TaskItemBorderStyle}">
            <Border.InputBindings>
                <MouseBinding Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              MouseAction="LeftClick" />
                <MouseBinding Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              MouseAction="LeftDoubleClick" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 状態アイコン -->
                <Border Style="{StaticResource AllTasksStatusIconStyle}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Text="{Binding Status, Converter={StaticResource TaskStatusToIconConverter}}" />
                </Border>

                <!-- タスク名とプロジェクト名 -->
                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AllTasksTaskNameStyle}" Text="{Binding Name}" />

                    <!-- プロジェクトコンテキスト (親 ItemsControl の Tag が 文字列 "True" の場合のみ表示) -->
                    <StackPanel x:Name="ProjectContextPanel"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource BrandPrimaryBrush}"
                                   Opacity="0.8"
                                   Text="🌲 " />
                        <TextBlock Style="{StaticResource AllTasksProjectLabelStyle}" Text="{Binding ProjectName}" />
                    </StackPanel>
                </StackPanel>

                <!-- 期限 -->
                <StackPanel Grid.Column="2"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AllTasksPropertyLabelStyle}" Text="📅 期限" />
                    <TextBlock Foreground="{Binding Deadline, Converter={StaticResource DeadlineToBrushConverter}}"
                               Style="{StaticResource AllTasksPropertyValueStyle}"
                               Text="{Binding Deadline, StringFormat={}{0:yyyy/MM/dd}, TargetNullValue='未設定'}" />
                </StackPanel>

                <!-- 優先度 -->
                <StackPanel Grid.Column="3"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AllTasksPropertyLabelStyle}" Text="⚡ 優先度" />
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Style="{StaticResource AllTasksPropertyValueStyle}"
                               Text="{Binding Priority}" />
                </StackPanel>

                <!-- 担当者 -->
                <StackPanel Grid.Column="4"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AllTasksPropertyLabelStyle}" Text="👤 担当" />
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                               Style="{StaticResource AllTasksPropertyValueStyle}"
                               Text="{Binding Assignee, TargetNullValue='未設定'}" />
                </StackPanel>

                <!-- 開くボタン -->
                <Button x:Name="TaskOpenButton"
                        Grid.Column="5"
                        MinHeight="{StaticResource ButtonHeightSmall}"
                        Margin="16,0,0,0"
                        Padding="8,2"
                        Command="{Binding DataContext.OpenTaskDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="開く"
                        Style="{StaticResource RoundButtonStyle}"
                        Visibility="Visible" />
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <!-- 親 ItemsControl の Tag プロパティを見て表示を切り替え -->
            <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter TargetName="ProjectContextPanel" Property="Visibility" Value="Visible" />
                <Setter TargetName="TaskOpenButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
