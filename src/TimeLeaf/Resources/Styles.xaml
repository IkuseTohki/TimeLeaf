        <Setter Property="Width" Value="200" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksFilterCheckBoxStyle"
           BasedOn="{StaticResource FormCheckBoxStyle}"
           TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksGridIconStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="AllTasksGridTaskNameStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AllTasksTaskOpenButtonStyle"
           BasedOn="{StaticResource RoundButtonStyle}"
           TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightSmall}" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="AllTasksTaskItemMainColumnStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="20,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksTaskItemSubColumnStyle" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AllTasksDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                             Opacity="0.1"
                             Color="{Binding Source={StaticResource BrandPrimaryColor}}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                             Opacity="0.05"
                             Color="{Binding Source={StaticResource BrandPrimaryColor}}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{Binding Source={StaticResource BrandPrimaryColor}}" />
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================== -->
    <!-- Dialog & Form Components -->
    <!-- ====================================================================== -->

    <Style x:Key="FormTitleTextStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="FormLabelTextStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SettingsContainerStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="500" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SettingsAnnotationStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ColorPreviewBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ViewPlaceholderTextStyle"
           BasedOn="{StaticResource TitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style x:Key="SetupWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="ResizeMode" Value="NoResize" />
    </Style>

    <Style x:Key="SetupContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="20" />
    </Style>

    <Style x:Key="SetupInputAreaStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SetupFooterStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Dialog Common Layouts -->
    <!-- ====================================================================== -->

    <!-- ダイアログ共通：ルートコンテナのスタイル -->
    <Style x:Key="DialogRootGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <Style x:Key="DialogRootStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,0" />
    </Style>

    <!-- ダイアログ共通：フッターボタンエリアのスタイル -->
    <Style x:Key="DialogFooterStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource FormFooterMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- ダイアログ共通：アクションボタンスタイル -->
    <Style x:Key="DialogActionButtonStyle"
           BasedOn="{StaticResource PrimaryButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="90" />
    </Style>

    <!-- ダイアログ共通：キャンセルボタンスタイル -->
    <Style x:Key="DialogCancelButtonStyle"
           BasedOn="{StaticResource SecondaryButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="90" />
        <Setter Property="Margin" Value="{StaticResource ButtonLeftMargin}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Error View Components -->
    <!-- ====================================================================== -->

    <Style x:Key="FatalErrorHeaderStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="ErrorLogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Consolas, Meiryo" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
