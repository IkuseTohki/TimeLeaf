<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:me="clr-namespace:TimeLeaf.Models.Enums"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================================================== -->
    <!-- Constants & Measures -->
    <!-- ====================================================================== -->
    <sys:Double x:Key="ButtonHeightMedium">28</sys:Double>
    <sys:Double x:Key="ButtonHeightSmall">22</sys:Double>
    <sys:Double x:Key="ButtonHeightLarge">36</sys:Double>
    <sys:Double x:Key="InputHeightMedium">32</sys:Double>

    <!-- レイアウト計測値 (Compact Design) -->
    <sys:Double x:Key="SpacingSmall">8</sys:Double>
    <sys:Double x:Key="SpacingMedium">16</sys:Double>
    <sys:Double x:Key="SpacingLarge">24</sys:Double>
    <sys:Double x:Key="SectionMarginBottom">20</sys:Double>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ViewOuterMargin">24,16,24,24</Thickness>

    <!-- フォーム・ダイアログ関連 -->
    <sys:Double x:Key="DialogWidthMedium">400</sys:Double>
    <sys:Double x:Key="DialogWidthLarge">480</sys:Double>
    <sys:Double x:Key="MultilineInputHeight">80</sys:Double>
    <sys:Double x:Key="MultilineInputHeightSmall">60</sys:Double>

    <!-- 固定マージン (リファクタリング用) -->
    <Thickness x:Key="FormFooterMargin">0,12,0,0</Thickness>
    <Thickness x:Key="ButtonLeftMargin">8,0,0,0</Thickness>
    <Thickness x:Key="SectionMarginThickness">0,0,0,20</Thickness>

    <!-- ====================================================================== -->
    <!-- Typography Bases (Semantic Font Styles) -->
    <!-- ====================================================================== -->

    <!-- 大見出し: 各画面の最上部タイトル -->
    <Style x:Key="TitleBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 中見出し: フォームタイトル、セクション見出し -->
    <Style x:Key="HeaderBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 標準ラベル: 項目名、ボタンテキスト -->
    <Style x:Key="LabelBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- 補足テキスト: 注釈、メタ情報、タイムスタンプ -->
    <Style x:Key="MetaBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Button Bases & Styles -->
    <!-- ====================================================================== -->

    <!-- 基本となるオーガニックボタンのテンプレート -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightMedium}" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小サイズボタン -->
    <Style x:Key="SmallButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightSmall}" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 大サイズボタン -->
    <Style x:Key="LargeButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeightLarge}" />
        <Setter Property="Padding" Value="20,6" />
        <Setter Property="FontSize" Value="14" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="18" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- 角丸の強いボタンスタイル（透過背景） -->
    <Style x:Key="RoundButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- オーガニックなボタンスタイル（標準） -->
    <Style x:Key="OrganicButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 強調ボタンスタイル（ブランドカラー） -->
    <Style x:Key="PrimaryButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- アウトライン強調ボタンスタイル -->
    <Style x:Key="OutlinedButtonStyle"
           BasedOn="{StaticResource RoundButtonStyle}"
           TargetType="Button">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 危険な操作ボタンのスタイル -->
    <Style x:Key="DangerButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="#FFEBEE" />
        <Setter Property="BorderBrush" Value="#FFCDD2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#D32F2F" />
    </Style>

    <!-- ナチュラルなユーザーメニューボタンのスタイル -->
    <Style x:Key="NaturalUserMenuButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ユーザーメニュー：アバター -->
    <Style x:Key="UserMenuAvatarBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="UserMenuInitialTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ユーザーメニュー：表示名 -->
    <Style x:Key="UserMenuNameTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ユーザーメニュー：矢印アイコン -->
    <Style x:Key="UserMenuArrowPathStyle" TargetType="Path">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="{DynamicResource ArrowDownIconGeometry}" />
        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUserMenuOpen}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             To="180"
                                             Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             To="0"
                                             Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================== -->
    <!-- Common Containers (Cards, Groups) -->
    <!-- ====================================================================== -->

    <!-- オーガニックなカード（Border）スタイル -->
    <Style x:Key="OrganicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  Direction="-90"
                                  Opacity="0.03"
                                  ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通知バッジ用のスタイル -->
    <Style x:Key="NotificationBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#E74C3C" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- フォームグループ（GroupBox）の基本スタイル -->
    <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLayer2Brush}" />
    </Style>

    <Style x:Key="DangerGroupBoxStyle"
           BasedOn="{StaticResource SettingsGroupBoxStyle}"
           TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#FFCDD2" />
        <Setter Property="Foreground" Value="#D32F2F" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Input Components -->
    <!-- ====================================================================== -->

    <!-- オーガニックな入力欄（TextBox）スタイル -->
    <Style x:Key="OrganicTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource InputHeightMedium}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- 検索用入力欄（ClearableTextBox 等）のスタイル -->
    <Style x:Key="SearchTextBoxStyle" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Navigation (Sidebar) -->
    <!-- ====================================================================== -->

    <!-- オーガニックなサイドバー用スタイル (TimeLeaf シグネチャー) -->
    <Style x:Key="OrganicSidebarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="0,24,24,0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- サイドバー：ロゴ・タイトルエリアのコンテナスタイル -->
    <Style x:Key="SidebarLogoContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,16,16,24" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- サイドバー：ロゴ・タイトルエリアのコンテナスタイル -->
    <Style x:Key="SidebarLogoPathStyle" TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Fill" Value="{DynamicResource BrandForegroundBrush}" />
    </Style>

    <!-- サイドバー：メイン境界スタイル (アニメーション含む) -->
    <Style x:Key="SidebarBorderStyle"
           BasedOn="{StaticResource OrganicSidebarBorderStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="72"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="200"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- サイドバー：アプリ名（"TimeLeaf"）のテキストスタイル -->
    <Style x:Key="SidebarLogoTextStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForegroundBrush}" />
    </Style>

    <!-- サイドバー：メニューのセクション見出し用スタイル -->
    <Style x:Key="SidebarMenuHeaderStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForegroundBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- サイドバー用ボタンスタイル -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,1,12,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0,16,16,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- サイドバー内のプロジェクト項目用スタイル -->
    <Style x:Key="SidebarProjectButtonStyle"
           BasedOn="{StaticResource SidebarButtonStyle}"
           TargetType="Button">
        <Setter Property="Padding" Value="32,6,16,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- サイドバー：新規作成（＋）ボタンのスタイル -->
    <Style x:Key="SidebarAddButtonStyle"
           BasedOn="{StaticResource IconButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- サイドバー：項目がない場合のメッセージテキストスタイル -->
    <Style x:Key="SidebarEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="16,8,16,0" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- サイドバー：折りたたみボタンのスタイル -->
    <Style x:Key="SidebarCollapseButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,-10,24" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4"
                                              Direction="-90"
                                              Opacity="0.1"
                                              ShadowDepth="1" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- View Layouts (Common across Views) -->
    <!-- ====================================================================== -->

    <!-- 各ビューの最上部ヘッダー領域（Grid）のスタイル -->
    <Style x:Key="ViewHeaderGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="24,16,24,8" />
    </Style>

    <!-- 各ビューのメインコンテンツ領域（StackPanel）のスタイル -->
    <Style x:Key="ViewMainContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="24,8,24,24" />
    </Style>

    <!-- 各ビューのメインコンテンツ領域（ItemsControl用）のスタイル -->
    <Style x:Key="ViewMainItemsContainerStyle" TargetType="ItemsControl">
        <Setter Property="Margin" Value="24,8,24,24" />
    </Style>

    <!-- ビューヘッダー内のタイトルテキストスタイル -->
    <Style x:Key="ViewHeaderTitleStyle"
           BasedOn="{StaticResource TitleBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ビューヘッダー内のサブタイトルテキストスタイル -->
    <Style x:Key="ViewHeaderSubTitleStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Home View Components -->
    <!-- ====================================================================== -->

    <!-- ホーム画面：統計情報（UniformGrid）のスタイル -->
    <Style x:Key="HomeStatsGridStyle" TargetType="UniformGrid">
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="StatsLabelStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="StatsValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ホーム画面：統計カード内のラベルテキストスタイル -->
    <Style x:Key="HomeStatsLabelStyle"
           BasedOn="{StaticResource StatsLabelStyle}"
           TargetType="TextBlock" />

    <!-- ホーム画面：統計カード内の数値テキストスタイル -->
    <Style x:Key="HomeStatsValueStyle"
           BasedOn="{StaticResource StatsValueStyle}"
           TargetType="TextBlock" />

    <!-- ホーム画面：カラム（StackPanel）のスタイル -->
    <Style x:Key="HomeColumnStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

    <!-- ホーム画面：期限切れタスク項目のスタイル -->
    <Style x:Key="HomeDeadlineItemStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ホーム画面：プロジェクトカード内のタイトルスタイル -->
    <Style x:Key="HomeProjectCardTitleStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
    </Style>

