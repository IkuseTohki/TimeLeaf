    <Style x:Key="EditableTextBlockContentStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- EditableTextBlock の編集ボタンの上書き -->
    <Style x:Key="EditableTextBlockEditButtonStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Error View Components -->
    <!-- ====================================================================== -->

    <!-- 致命的エラー：ヘッダーラベルのスタイル -->
    <Style x:Key="FatalErrorHeaderStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 致命的エラー：エラーログ表示用TextBoxのスタイル -->
    <Style x:Key="ErrorLogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Consolas, Meiryo" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ============================================================ -->
    <!-- Tab Selector (ProjectWorkspace Style Navigation) -->
    <!-- ============================================================ -->

</ResourceDictionary>
