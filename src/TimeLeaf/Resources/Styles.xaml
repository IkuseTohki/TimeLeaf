<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 角丸の強いボタンスタイル（オーガニック） -->
    <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- プロジェクト内で多用するオーガニックなボタンスタイル -->
    <Style x:Key="OrganicButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- オーガニックなカード（Border）スタイル -->
    <Style x:Key="OrganicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="15"
                                  Direction="-90"
                                  Opacity="0.05"
                                  ShadowDepth="5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- オーガニックな入力欄（TextBox）スタイル -->
    <Style x:Key="OrganicTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="20" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- サイドバー項目用のスタイル -->
    <Style x:Key="SidebarItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="LightGray" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SidebarHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 通知バッジ用のスタイル -->
    <Style x:Key="NotificationBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#E74C3C" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- サイドバー用ボタンスタイル -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Margin" Value="0,2,16,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0,20,20,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- サイドバー内のプロジェクト項目用スタイル -->
    <Style x:Key="SidebarProjectButtonStyle"
           BasedOn="{StaticResource SidebarButtonStyle}"
           TargetType="Button">
        <Setter Property="Padding" Value="40,10,24,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- アウトライン強調ボタンスタイル -->
    <Style x:Key="OutlinedButtonStyle"
           BasedOn="{StaticResource RoundButtonStyle}"
           TargetType="Button">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- オーガニックなサイドバー用スタイル (TimeLeaf シグネチャー) -->
    <Style x:Key="OrganicSidebarBorderStyle"
           BasedOn="{StaticResource SidebarBorderStyle}"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="0,32,32,0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- サイドバー：ロゴ・タイトルエリアのコンテナスタイル -->
    <Style x:Key="SidebarLogoContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="20,32,20,40" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- サイドバー：ロゴアイコン（Path）用のスタイル -->
    <Style x:Key="SidebarLogoPathStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Fill" Value="{DynamicResource BrandForegroundBrush}" />
    </Style>

    <!-- サイドバー：アプリ名（"TimeLeaf"）のテキストスタイル -->
    <Style x:Key="SidebarLogoTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForegroundBrush}" />
    </Style>

    <!-- サイドバー：メニューのセクション見出し用スタイル -->
    <Style x:Key="SidebarMenuHeaderStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandForegroundBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- サイドバー：新規作成（＋）ボタンのスタイル -->
    <Style x:Key="SidebarAddButtonStyle"
           BasedOn="{StaticResource IconButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- サイドバー：項目がない場合のメッセージテキストスタイル -->
    <Style x:Key="SidebarEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="24,12,24,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- サイドバー：折りたたみボタンのスタイル -->
    <Style x:Key="SidebarCollapseButtonStyle"
           BasedOn="{StaticResource ModernButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,-12,32" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    </Style>

    <!-- Setup View Components -->

    <!-- セットアップ画面：Windowの基本スタイル -->
    <Style x:Key="SetupWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="ResizeMode" Value="NoResize" />
    </Style>

    <!-- セットアップ画面：メインコンテナ（StackPanel）のスタイル -->
    <Style x:Key="SetupContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="24" />
    </Style>

    <!-- セットアップ画面：見出しテキストのスタイル -->
    <Style x:Key="SetupHeaderTextStyle"
           BasedOn="{StaticResource FormTitleTextStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- セットアップ画面：説明テキストのスタイル -->
    <Style x:Key="SetupDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- セットアップ画面：補足説明テキストのスタイル -->
    <Style x:Key="SetupSubDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,5,0,20" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- セットアップ画面：入力エリア（Grid）のスタイル -->
    <Style x:Key="SetupInputAreaStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- セットアップ画面：エラーメッセージのスタイル -->
    <Style x:Key="SetupErrorMessageStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,-15,0,20" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <!-- セットアップ画面：フッターボタンエリアのスタイル -->
    <Style x:Key="SetupFooterStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- Generic View Components (Common across many views) -->

    <!-- 各ビューの最上部ヘッダー領域（Grid）のスタイル -->
    <Style x:Key="ViewHeaderGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="48,32,48,16" />
    </Style>

    <!-- 各ビューのメインコンテンツ領域（StackPanel）のスタイル -->
    <Style x:Key="ViewMainContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="48,16,48,48" />
    </Style>

    <!-- ビューヘッダー内のタイトルテキストスタイル -->
    <Style x:Key="ViewHeaderTitleStyle"
           BasedOn="{StaticResource FormTitleTextStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- ビューヘッダー内のサブタイトルテキストスタイル -->
    <Style x:Key="ViewHeaderSubTitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Home View Components -->

    <!-- ホーム画面：統計情報（UniformGrid）のスタイル -->
    <Style x:Key="HomeStatsGridStyle" TargetType="UniformGrid">
        <Setter Property="Margin" Value="0,0,0,32" />
    </Style>

    <!-- ホーム画面：統計カード内のラベルテキストスタイル -->
    <Style x:Key="HomeStatsLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ホーム画面：統計カード内の数値テキストスタイル -->
    <Style x:Key="HomeStatsValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ホーム画面：カラム（StackPanel）のスタイル -->
    <Style x:Key="HomeColumnStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,32,0" />
    </Style>

    <!-- ホーム画面：期限切れタスク項目のスタイル -->
    <Style x:Key="HomeDeadlineItemStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ホーム画面：プロジェクトカード内のタイトルスタイル -->
    <Style x:Key="HomeProjectCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ホーム画面：プロジェクトカード内のサブタイトル（状態）スタイル -->
    <Style x:Key="HomeProjectCardSubTitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ホーム画面：プロジェクトカード内の進捗バースタイル -->
    <Style x:Key="HomeProjectProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceLayer1Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- ホーム画面：マイルストーンの日付テキストスタイル -->
    <Style x:Key="HomeMilestoneDateStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ホーム画面：マイルストーンのプロジェクト名テキストスタイル -->
    <Style x:Key="HomeMilestoneProjectNameStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- ホーム画面：マイルストーンのタイムライン上のドットスタイル -->
    <Style x:Key="HomeMilestoneTimelineDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- ホーム画面：マイルストーンのタイムラインの縦線スタイル -->
    <Style x:Key="HomeMilestoneTimelineLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.2" />
    </Style>

    <!-- ホーム画面：マイルストーン名（内容）のテキストスタイル -->
    <Style x:Key="HomeMilestoneLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
