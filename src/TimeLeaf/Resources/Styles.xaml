<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="http://schemas.leafkit.com/wpf/ui/controls"
                    xmlns:me="clr-namespace:TimeLeaf.Models.Enums"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====================================================================== -->
    <!-- Common Components Aliases & Bases -->
    <!-- ====================================================================== -->

    <!-- オーガニックなカード（Border）スタイル -->
    <Style x:Key="OrganicCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  Direction="-90"
                                  Opacity="0.03"
                                  ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SurfaceCardStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border" />

    <!-- 通知バッジ用のスタイル -->
    <Style x:Key="NotificationBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- フォームグループ（GroupBox）の基本スタイル -->
    <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
    </Style>

    <Style x:Key="DangerGroupBoxStyle"
           BasedOn="{StaticResource SettingsGroupBoxStyle}"
           TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="SmallIconPathStyle"
           BasedOn="{StaticResource IconPathStyle}"
        TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Navigation (Sidebar) -->
    <!-- ====================================================================== -->

    <!-- サイドバー：メイン境界スタイル (アニメーション含む) -->
    <Style x:Key="GlobalSidebarBorderStyle"
           BasedOn="{StaticResource SidebarBorderStyle}"
           TargetType="Border">
        <Setter Property="Width" Value="200" />
        <Setter Property="Background" Value="{DynamicResource GlobalSidebarBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="0,24,24,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="76"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="200"
                                             Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- サイドバー：ロゴ・タイトルエリアのコンテナスタイル -->
    <Style x:Key="SidebarLogoContainerStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,16,16,24" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <Style x:Key="SidebarLogoPathStyle" TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Fill" Value="{DynamicResource SidebarTextBrush}" />
    </Style>

    <Style x:Key="SidebarLogoTextStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>

    <Style x:Key="SidebarMenuHeaderStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- サイドバー用ボタンスタイル (Buttonベース) -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,1,12,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0,16,16,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SidebarHoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SidebarPressedOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarProjectButtonStyle"
           BasedOn="{StaticResource SidebarButtonStyle}"
           TargetType="Button">
        <Setter Property="Padding" Value="32,6,16,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarAddButtonStyle"
           BasedOn="{StaticResource IconButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SidebarEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="16,8,16,0" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SidebarCollapseButtonStyle"
           BasedOn="{StaticResource BaseButtonStyle}"
           TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,-10,24" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBaseBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4"
                                              Direction="-90"
                                              Opacity="0.1"
                                              ShadowDepth="1" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- Home View Components -->
    <!-- ====================================================================== -->

    <Style x:Key="NaturalUserMenuButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource StateHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UserMenuAvatarBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="UserMenuInitialTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="UserMenuNameTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="UserMenuArrowPathStyle" TargetType="Path">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="{DynamicResource ArrowDownIconGeometry}" />
        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUserMenuOpen}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             To="180"
                                             Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             To="0"
                                             Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeStatsGridStyle" TargetType="UniformGrid">
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="StatsLabelStyle"
           BasedOn="{StaticResource LabelBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="StatsValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HomeStatsLabelStyle"
           BasedOn="{StaticResource StatsLabelStyle}"
           TargetType="TextBlock" />

    <Style x:Key="HomeStatsValueStyle"
           BasedOn="{StaticResource StatsValueStyle}"
           TargetType="TextBlock" />

    <Style x:Key="HomeColumnStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

    <Style x:Key="HomeDeadlineItemStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="HomeProjectCardTitleStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="HomeProjectCardSubTitleStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="HomeProjectProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ProgressBarBlankBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="HomeMilestoneDateStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock" />

    <Style x:Key="HomeMilestoneProjectNameStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style x:Key="HomeMilestoneTimelineDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="HomeMilestoneTimelineLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.2" />
    </Style>

    <Style x:Key="HomeMilestoneLabelStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ====================================================================== -->
    <!-- Notifications View Components -->
    <!-- ====================================================================== -->

    <Style x:Key="NotificationCardStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="NotificationTitleTextStyle"
           BasedOn="{StaticResource HeaderBaseStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <Style x:Key="NotificationMessageTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NotificationTimestampTextStyle"
           BasedOn="{StaticResource MetaBaseStyle}"
           TargetType="TextBlock" />

    <Style x:Key="NotificationEmptyStateStyle"
           BasedOn="{StaticResource OrganicCardStyle}"
           TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="NotificationEmptyIconStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="36" />
    </Style>

    <!-- ====================================================================== -->
    <!-- All Tasks View Components -->
    <!-- ====================================================================== -->

    <Style x:Key="AllTasksTimelineGroupIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect" Value="{StaticResource AllTasksShadowEffect}" />
    </Style>

    <Style x:Key="AllTasksTimelineVerticalLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="2" />
        <Setter Property="Margin" Value="23,20,0,-20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.1" />
    </Style>

    <Style x:Key="AllTasksTimelineMarkerStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="18,14,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="2" />
